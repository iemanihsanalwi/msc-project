main         1-1       0          0         NaN        0.00000             0.00000\n","P_emaildomain         2-4       0          0         NaN        0.00000             0.00000\n","P_emaildomain        5-19       0          0         NaN        0.00000             0.00000\n","P_emaildomain       20-99     525         36     0.06857        0.00132             0.00250\n","P_emaildomain     100-inf  398321      14368     0.03607        0.99868             0.99750\n","R_emaildomain         1-1       0          0         NaN        0.00000             0.00000\n","R_emaildomain         2-4       0          0         NaN        0.00000             0.00000\n","R_emaildomain        5-19      53          1     0.01887        0.00047             0.00011\n","R_emaildomain       20-99    1139         53     0.04653        0.01002             0.00588\n","R_emaildomain     100-inf  112428       8959     0.07969        0.98951             0.99401\n","   DeviceInfo         1-1     418         15     0.03589        0.00420             0.00217\n","   DeviceInfo         2-4    1255         70     0.05578        0.01261             0.01013\n","   DeviceInfo        5-19    4502        518     0.11506        0.04523             0.07499\n","   DeviceInfo       20-99    9512       1377     0.14476        0.09556             0.19933\n","   DeviceInfo     100-inf   83849       4928     0.05877        0.84240             0.71338\n","   DeviceType         1-1       0          0         NaN        0.00000             0.00000\n","   DeviceType         2-4       0          0         NaN        0.00000             0.00000\n","   DeviceType        5-19       0          0         NaN        0.00000             0.00000\n","   DeviceType       20-99       0          0         NaN        0.00000             0.00000\n","   DeviceType     100-inf  117638       9030     0.07676        1.00000             1.00000\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1430x440 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["\"\"\"Section 8 - entity and graph readiness, cold start, degree concentration.\"\"\"\n","\n","\n","def calculate_entity_persistence(frame: pd.DataFrame, column: str,\n","                                 block_column: str = \"chrono_block\") -> Dict[str, Any]:\n","    \"\"\"Coverage, cardinality, singleton rate and cross-block persistence.\n","\n","    ``persistence_mean_blocks`` is the average number of distinct blocks in\n","    which a value appears; ``share_in_all_blocks`` is the share of distinct\n","    values seen in every block. Both denominators are distinct non-missing\n","    values, not rows.\n","    \"\"\"\n","    if column not in frame.columns:\n","        raise KeyError(f\"Entity column '{column}' is absent.\")\n","    values = frame[column]\n","    non_missing = values.notna()\n","    n_rows = int(len(frame))\n","    n_non_missing = int(non_missing.sum())\n","    if n_non_missing == 0:\n","        return {\"entity\": column, \"assessable\": False,\n","                \"reason\": \"no non-missing values\", \"n_rows\": n_rows,\n","                \"non_missing_rows\": 0, \"coverage\": 0.0, \"cardinality\": 0,\n","                \"singleton_rate\": np.nan, \"persistence_mean_blocks\": np.nan,\n","                \"share_in_all_blocks\": np.nan, \"top1_share\": np.nan}\n","    counts = values[non_missing].value_counts()\n","    per_value_blocks = (frame.loc[non_missing, [column, block_column]]\n","                        .groupby(column, observed=True)[block_column].nunique())\n","    n_blocks = int(frame[block_column].nunique())\n","    return {\n","        \"entity\": column, \"assessable\": True, \"reason\": \"\",\n","        \"n_rows\": n_rows,\n","        \"non_missing_rows\": n_non_missing,\n","        \"coverage\": n_non_missing / n_rows,\n","        \"cardinality\": int(counts.size),\n","        \"singleton_rate\": float((counts == 1).mean()),\n","        \"top1_share\": float(counts.iloc[0] / n_non_missing),\n","        \"median_frequency\": float(counts.median()),\n","        \"p95_frequency\": float(counts.quantile(0.95)),\n","        \"persistence_mean_blocks\": float(per_value_blocks.mean()),\n","        \"share_in_all_blocks\": float((per_value_blocks == n_blocks).mean()),\n","    }\n","\n","\n","def calculate_cold_start_rate(\n","    dev: pd.DataFrame, oot: pd.DataFrame, column: str\n",") -> Dict[str, Any]:\n","    \"\"\"Measure OOT cold-start exposure without reading OOT labels.\n","\n","    Primary rate: unseen, non-missing OOT rows divided by OOT rows\n","    with a non-missing value for this column.\n","\n","    Secondary rate: the same numerator divided by all OOT rows.\n","    The set of previously seen values comes from development only.\n","    \"\"\"\n","    for frame, label in ((dev, \"dev\"), (oot, \"oot\")):\n","        if column not in frame.columns:\n","            raise KeyError(\n","                f\"Entity column '{column}' absent from the {label} frame.\"\n","            )\n","\n","    seen = set(pd.unique(dev.loc[dev[column].notna(), column]))\n","    oot_values = oot[column]\n","    non_missing = oot_values.notna()\n","    n_oot_rows = int(len(oot))\n","    n_non_missing = int(non_missing.sum())\n","\n","    if n_non_missing == 0:\n","        return {\n","            \"entity\": column,\n","            \"assessable\": False,\n","            \"reason\": \"no non-missing OOT values\",\n","            \"n_dev_values_seen\": len(seen),\n","            \"oot_rows\": n_oot_rows,\n","            \"oot_rows_non_missing\": 0,\n","            \"cold_start_rows\": 0,\n","            \"warm_start_rows\": 0,\n","            \"cold_start_rate\": np.nan,\n","            \"cold_start_rate_all_oot_rows\": np.nan,\n","            \"unseen_value_share\": np.nan,\n","            \"cold_start_reliable\": False,\n","        }\n","\n","    is_cold = non_missing & ~oot_values.isin(seen)\n","    is_warm = non_missing & oot_values.isin(seen)\n","    n_cold = int(is_cold.sum())\n","    n_warm = int(is_warm.sum())\n","\n","    return {\n","        \"entity\": column,\n","        \"assessable\": True,\n","        \"reason\": \"\",\n","        \"n_dev_values_seen\": len(seen),\n","        \"oot_rows\": n_oot_rows,\n","        \"oot_rows_non_missing\": n_non_missing,\n","        \"cold_start_rows\": n_cold,\n","        \"warm_start_rows\": n_warm,\n","        \"cold_start_rate\": n_cold / n_non_missing,\n","        \"cold_start_rate_all_oot_rows\": n_cold / n_oot_rows,\n","        \"unseen_value_share\": float(\n","            (~pd.Index(pd.unique(oot_values[non_missing]))\n","              .isin(list(seen))).mean()\n","        ),\n","        \"cold_start_reliable\": n_cold >= CONFIG[\"MIN_GROUP_N\"],\n","    }\n","\n","\n","def summarize_degree_fraud_concentration(frame: pd.DataFrame, column: str,\n","                                         target: str = TARGET_COLUMN,\n","                                         bands: Sequence[int] = (1, 2, 5, 20, 100)) -> pd.DataFrame:\n","    \"\"\"Fraud concentration by entity degree band, computed from an aggregated table.\n","\n","    \"Degree\" here is the transaction count attached to an entity value within\n","    the supplied frame - a bipartite transaction-to-entity degree. No dense\n","    adjacency matrix is materialised: the whole computation is a value_counts\n","    join, which is why it scales to 590k rows.\n","    \"\"\"\n","    if column not in frame.columns:\n","        raise KeyError(f\"Entity column '{column}' is absent.\")\n","    non_missing = frame[column].notna()\n","    if not non_missing.any():\n","        return pd.DataFrame(columns=[\"entity\", \"degree_band\", \"n_rows\", \"positives\",\n","                                     \"fraud_rate\", \"share_of_rows\", \"share_of_positives\"])\n","    degree = frame.loc[non_missing, column].map(frame.loc[non_missing, column].value_counts())\n","    edges = list(bands) + [np.inf]\n","    labels = [f\"{edges[i]}-{edges[i + 1] - 1 if np.isfinite(edges[i + 1]) else 'inf'}\"\n","              for i in range(len(edges) - 1)]\n","    band = pd.cut(degree, bins=[b - 0.5 for b in edges[:-1]] + [np.inf],\n","                  labels=labels, right=True)\n","    y = frame.loc[non_missing, target]\n","    grouped = pd.DataFrame({\"band\": band, \"y\": y}).groupby(\"band\", observed=False)[\"y\"]\n","    out = grouped.agg(n_rows=\"size\", positives=\"sum\").reset_index()\n","    out[\"fraud_rate\"] = out[\"positives\"] / out[\"n_rows\"].replace(0, np.nan)\n","    out[\"share_of_rows\"] = out[\"n_rows\"] / out[\"n_rows\"].sum()\n","    out[\"share_of_positives\"] = out[\"positives\"] / max(int(out[\"positives\"].sum()), 1)\n","    out.insert(0, \"entity\", column)\n","    out = out.rename(columns={\"band\": \"degree_band\"})\n","    return out\n","\n","\n","if ENTITY_COLUMNS:\n","    AUDITOR.guard(\"entity_seen_value_sets\", dev_df[[ID_COLUMN]])\n","    _persistence = [calculate_entity_persistence(dev_df, c) for c in ENTITY_COLUMNS]\n","    _cold = [calculate_cold_start_rate(dev_df, oot_df, c) for c in ENTITY_COLUMNS]\n","    for column in ENTITY_COLUMNS:\n","        AUDITOR.register_fit(f\"seen_values::{column}\", \"category_map\",\n","                             dev_df[ID_COLUMN].to_numpy(), DEV_BLOCKS)\n","\n","    ENTITY_SUMMARY = (pd.DataFrame(_persistence)\n","                      .merge(pd.DataFrame(_cold), on=\"entity\", how=\"outer\",\n","                             suffixes=(\"_dev\", \"_oot\")))\n","    ENTITY_COLD_START_PATH = os.path.join(OUTPUT_DIRECTORY, \"entity_cold_start_summary.csv\")\n","    ENTITY_SUMMARY.to_csv(ENTITY_COLD_START_PATH, index=False)\n","    LOG.info(\"Wrote %s\", ENTITY_COLD_START_PATH)\n","\n","    DEGREE_CONCENTRATION = pd.concat(\n","        [summarize_degree_fraud_concentration(dev_df, c) for c in ENTITY_COLUMNS],\n","        ignore_index=True)\n","\n","    print(ENTITY_SUMMARY[[\"entity\", \"coverage\", \"cardinality\", \"singleton_rate\",\n","                          \"persistence_mean_blocks\", \"share_in_all_blocks\",\n","                          \"oot_rows_non_missing\", \"cold_start_rows\",\n","                          \"cold_start_rate\", \"cold_start_rate_all_oot_rows\"\n","                          ]]\n","          .round(4).to_string(index=False))\n","    print(\"\\nDenominators: coverage and cold_start_rate_all_oot_rows use ALL rows of \"\n","          \"their frame; cold_start_rate uses only OOT rows with a non-missing value; \"\n","          \"singleton_rate and persistence use distinct values, not rows.\")\n","    print(\"\\nInterpretation limits: card/address/email/device columns are anonymised. \"\n","          \"A shared value is a shared ATTRIBUTE, not proof of a shared person. No \"\n","          \"composite customer identity is constructed here, because no documented \"\n","          \"linkage rule has been validated for these columns.\")\n","    print(\"\\nFraud concentration by entity degree band (development rows):\")\n","    print(DEGREE_CONCENTRATION.round(5).to_string(index=False))\n","\n","    fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n","    _cs = ENTITY_SUMMARY.dropna(subset=[\"cold_start_rate\"]).sort_values(\"cold_start_rate\")\n","    _idx = np.arange(len(_cs))\n","    axes[0].barh(_idx - 0.2, _cs.cold_start_rate, height=0.4,\n","                 label=\"of OOT rows with a value\")\n","    axes[0].barh(_idx + 0.2, _cs.cold_start_rate_all_oot_rows, height=0.4,\n","                 label=\"of all OOT rows\")\n","    axes[0].set_yticks(_idx)\n","    axes[0].set_yticklabels(_cs.entity)\n","    axes[0].set_xlabel(\"OOT cold-start rate\")\n","    axes[0].set_title(\"Cold-start exposure under both denominators\")\n","    axes[0].legend(fontsize=8)\n","    for entity, part in DEGREE_CONCENTRATION.groupby(\"entity\"):\n","        axes[1].plot(part.degree_band.astype(str), 100 * part.fraud_rate,\n","                     marker=\"o\", label=entity)\n","    axes[1].set_xlabel(\"entity degree band (transactions per value, development)\")\n","    axes[1].set_ylabel(\"fraud rate (%)\")\n","    axes[1].set_title(\"Fraud concentration by entity degree\")\n","    axes[1].legend(fontsize=7, ncol=2)\n","    plt.tight_layout()\n","    plt.show()\n","else:\n","    ENTITY_SUMMARY = pd.DataFrame()\n","    DEGREE_CONCENTRATION = pd.DataFrame()\n","    ENTITY_COLD_START_PATH = None\n","    LOG.warning(\"No candidate entity columns present: Section 8 is NOT COMPUTED.\")"]},{"cell_type":"markdown","id":"1bae0cd2","metadata":{"_cell_guid":"11843eb2-23d7-4de2-b545-b54bb1369ad9","_uuid":"0c73714e-a68b-4cd0-93a9-318738361068","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.019305,"end_time":"2026-09-29T09:25:21.254058+00:00","exception":false,"start_time":"2026-09-29T09:25:21.234753+00:00","status":"completed"},"tags":[]},"source":["### Interpreting Section 8\n","\n","Cold-start exposure is the single most consequential number for a graph-tabular\n","model. Any encoding built from an entity's history — frequency, running mean,\n","node embedding, degree — is **undefined** for a value first seen in the holdout,\n","and the share of the holdout in that position bounds how much of the graph story\n","can transfer at all. High singleton rates carry the same warning at the value\n","level: an entity seen once contributes a degree-1 node with no neighbourhood to\n","aggregate over.\n","\n","Degree bands are computed from an aggregated `value_counts` table. No dense\n","adjacency matrix is materialised anywhere, which is what keeps this affordable at\n","590k rows and is the pattern any later graph pre-analysis should follow."]},{"cell_type":"markdown","id":"5ceef1a1","metadata":{"_cell_guid":"46dd103a-9d36-4538-b414-a17f8adf52d0","_uuid":"824cfd70-d85a-4864-ac48-183ca7d1c5ec","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.018444,"end_time":"2026-09-29T09:25:21.291089+00:00","exception":false,"start_time":"2026-09-29T09:25:21.272645+00:00","status":"completed"},"tags":[]},"source":["## 9. Block-Count Sensitivity Analysis\n","\n","The 5-block split is a choice. If the conclusions depend on it, they are\n","artefacts. The key drift diagnostics are recomputed at 4, 5, 6 and 8 blocks;\n","each configuration reserves its own final chronological block as OOT and\n","**re-learns every reference statistic from its own development rows**. Nothing —\n","bin edges, cut points, fitted objects — is reused across configurations, because\n","an object learned under one split is not a development-only object under another."]},{"cell_type":"code","execution_count":12,"id":"9c7475bb","metadata":{"_cell_guid":"c2e66ca8-3a61-4ace-bfbd-8da98a577dcf","_uuid":"5b91885a-919c-4f8b-901d-eec874c135a4","collapsed":false,"execution":{"iopub.execute_input":"2026-09-29T09:25:21.330615Z","iopub.status.busy":"2026-09-29T09:25:21.33017Z","iopub.status.idle":"2026-09-29T09:36:05.239701Z","shell.execute_reply":"2026-09-29T09:36:05.238733Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":643.932957,"end_time":"2026-09-29T09:36:05.242658+00:00","exception":false,"start_time":"2026-09-29T09:25:21.309701+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Workload estimate: 4 configurations x 282 features, each re-splitting 590,540 rows.\n"]},{"name":"stderr","output_type":"stream","text":["09:27:48 | INFO    | Sensitivity configuration with 4 blocks complete (development blocks 1-3, OOT block 4).\n","09:30:25 | INFO    | Sensitivity configuration with 5 blocks complete (development blocks 1-4, OOT block 5).\n","09:33:09 | INFO    | Sensitivity configuration with 6 blocks complete (development blocks 1-5, OOT block 6).\n","09:36:04 | INFO    | Sensitivity configuration with 8 blocks complete (development blocks 1-7, OOT block 8).\n","09:36:04 | INFO    | Wrote ./artifacts/block_sensitivity_summary.csv\n"]},{"name":"stdout","output_type":"stream","text":["\n","Features whose verdict is identical under 4, 5, 6 and 8 blocks: 156 of 282.\n","Features whose verdict changes with the block count: ['C10', 'C4', 'C8', 'C9', 'D13', 'D14', 'D3', 'D6', 'D9', 'TransactionAmt', 'V167', 'V168', 'V169', 'V170', 'V171', 'V172', 'V173', 'V174', 'V175', 'V176', 'V177', 'V178', 'V179', 'V180', 'V181', 'V182', 'V183', 'V184', 'V185', 'V186', 'V187', 'V188', 'V189', 'V190', 'V191', 'V192', 'V193', 'V194', 'V195', 'V196', 'V197', 'V198', 'V199', 'V200', 'V201', 'V202', 'V203', 'V204', 'V205', 'V206', 'V207', 'V208', 'V209', 'V210', 'V211', 'V212', 'V213', 'V214', 'V215', 'V216', 'V217', 'V218', 'V219', 'V220', 'V221', 'V222', 'V223', 'V224', 'V225', 'V226', 'V227', 'V228', 'V229', 'V230', 'V231', 'V232', 'V233', 'V234', 'V235', 'V236', 'V237', 'V238', 'V239', 'V240', 'V241', 'V242', 'V243', 'V244', 'V245', 'V246', 'V247', 'V248', 'V249', 'V250', 'V251', 'V252', 'V253', 'V254', 'V255', 'V256', 'V257', 'V258', 'V259', 'V260', 'V261', 'V262', 'V263', 'V264', 'V265', 'V266', 'V267', 'V268', 'V269', 'V270', 'V271', 'V272', 'V273', 'V274', 'V275', 'V276', 'V277', 'V278', 'V302', 'V303', 'V304', 'dist1']\n","\n","Verdict counts by configuration:\n","n_blocks         4    5    6    8\n","verdict                          \n","moderate_risk    9    9  125  123\n","stable          10   10   12   13\n","temporal_risk  263  263  145  146\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 880x396 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["\"\"\"Section 9 - block-count sensitivity of the drift conclusions.\"\"\"\n","\n","\n","def run_block_sensitivity(frame: pd.DataFrame, features: Sequence[str],\n","                          block_counts: Sequence[int] = CONFIG[\"SENSITIVITY_BLOCK_COUNTS\"],\n","                          time_column: str = TIME_COLUMN,\n","                          id_column: str = ID_COLUMN) -> pd.DataFrame:\n","    \"\"\"Recompute the key drift flags under several block-count configurations.\n","\n","    For each configuration the split is rebuilt from scratch, the final\n","    chronological block becomes that configuration's OOT, and every reference\n","    statistic - bin edges, decile cut point, verdict rule input - is re-learned\n","    from that configuration's development rows only. Nothing is reused across\n","    configurations, because a bin edge learned under a 5-block split is not a\n","    development-only object under an 8-block split.\n","\n","    Returns:\n","        Long DataFrame: one row per (n_blocks, feature) with psi_max_dev,\n","        spearman_corr_time, lift_stability and the resulting verdict.\n","    \"\"\"\n","    rows = []\n","    for n_blocks in block_counts:\n","        labels = create_temporal_blocks(frame, n_blocks, time_column, id_column)\n","        local = frame[[id_column, time_column, \"elapsed_days\"] + list(features)].copy()\n","        local[\"chrono_block\"] = labels\n","        local[TARGET_COLUMN] = frame[TARGET_COLUMN]\n","        dev_blocks = list(range(1, n_blocks))\n","        local_dev = local[local[\"chrono_block\"] < n_blocks]\n","        local_auditor = LeakageAuditor(\n","            oot_ids=local.loc[local[\"chrono_block\"] == n_blocks, id_column].to_numpy(),\n","            oot_blocks=[n_blocks])\n","        local_auditor.guard(f\"sensitivity_{n_blocks}_blocks\", local_dev[[id_column]])\n","\n","        spearman = calculate_spearman_time_risk(local_dev, features).set_index(\"feature\")\n","        for feature in features:\n","            reference = local_dev.loc[local_dev[\"chrono_block\"] == dev_blocks[0], feature]\n","            edges = learn_psi_bins(reference)\n","            psis = []\n","            for block in dev_blocks[1:]:\n","                psis.append(calculate_psi(\n","                    reference, local_dev.loc[local_dev[\"chrono_block\"] == block, feature],\n","                    edges=edges)[\"psi\"])\n","            psis = [p for p in psis if np.isfinite(p)]\n","            psi_max = max(psis) if psis else np.nan\n","\n","            values = local_dev[feature]\n","            values = values[pd.to_numeric(values, errors=\"coerce\").map(np.isfinite)]\n","            cut = (float(np.quantile(values, CONFIG[\"TOP_DECILE_QUANTILE\"]))\n","                   if len(values) >= CONFIG[\"MIN_NON_MISSING\"] else float(\"nan\"))\n","            lifts = {}\n","            for block in dev_blocks:\n","                result = calculate_top_decile_lift(\n","                    local.loc[local[\"chrono_block\"] == block, [feature, TARGET_COLUMN]],\n","                    feature, cut)\n","                if result[\"assessable\"]:\n","                    lifts[block] = result[\"lift\"]\n","            stability = calculate_lift_stability(lifts)\n","\n","            corr = spearman.loc[feature, \"spearman_corr_time\"] if feature in spearman.index else np.nan\n","            band = classify_psi(psi_max)\n","            strong_time = np.isfinite(corr) and abs(corr) >= CONFIG[\"SPEARMAN_RISK_THRESHOLD\"]\n","            unstable = (stability[\"lift_stability\"] is not None\n","                        and stability[\"lift_stability\"] < CONFIG[\"LIFT_STABILITY_THRESHOLD\"])\n","            if not np.isfinite(psi_max) and not np.isfinite(corr):\n","                verdict = \"insufficient_evidence\"\n","            elif band == \"severe_drift\" or (strong_time and unstable):\n","                verdict = \"temporal_risk\"\n","            elif band == \"moderate_drift\" or strong_time or unstable:\n","                verdict = \"moderate_risk\"\n","            else:\n","                verdict = \"stable\"\n","\n","            rows.append({\"n_blocks\": n_blocks, \"oot_block\": n_blocks, \"feature\": feature,\n","                         \"psi_max_dev\": psi_max, \"psi_band\": band,\n","                         \"spearman_corr_time\": corr,\n","                         \"lift_stability\": stability[\"lift_stability\"],\n","                         \"n_lift_blocks\": stability[\"n_blocks\"], \"verdict\": verdict})\n","        LOG.info(\"Sensitivity configuration with %d blocks complete \"\n","                 \"(development blocks 1-%d, OOT block %d).\", n_blocks, n_blocks - 1, n_blocks)\n","    return pd.DataFrame(rows)\n","\n","\n","# Restrict the sensitivity sweep to the families whose verdicts drive the\n","# protocol (D-series plus the amount) and any feature currently flagged, which\n","# keeps the four re-splits affordable without cherry-picking stable features.\n","SENSITIVITY_FEATURES = sorted(set(\n","    [c for c in AUDIT_FEATURES if family_of(c) in {\"D\", \"amount\", \"distance\"}]\n","    + feature_risk.loc[feature_risk.verdict.isin([\"temporal_risk\", \"moderate_risk\"]),\n","                       \"feature\"].tolist()\n","))\n","print(f\"Workload estimate: {len(CONFIG['SENSITIVITY_BLOCK_COUNTS'])} configurations x \"\n","      f\"{len(SENSITIVITY_FEATURES)} features, each re-splitting {len(df):,} rows.\")\n","\n","SENSITIVITY_SOURCE = dev_df.copy()\n","_original_oot_ids = set(oot_df[ID_COLUMN].tolist())\n","if not _original_oot_ids.isdisjoint(set(SENSITIVITY_SOURCE[ID_COLUMN].tolist())):\n","    raise AssertionError(\"Sensitivity source contains original OOT TransactionIDs.\")\n","BLOCK_SENSITIVITY = run_block_sensitivity(SENSITIVITY_SOURCE, SENSITIVITY_FEATURES)\n","\n","_baseline = BLOCK_SENSITIVITY[BLOCK_SENSITIVITY.n_blocks == N_BLOCKS][[\"feature\", \"verdict\"]] \\\n","    .rename(columns={\"verdict\": \"verdict_baseline\"})\n","BLOCK_SENSITIVITY = BLOCK_SENSITIVITY.merge(_baseline, on=\"feature\", how=\"left\")\n","BLOCK_SENSITIVITY[\"verdict_changed_vs_baseline\"] = (\n","    BLOCK_SENSITIVITY[\"verdict\"] != BLOCK_SENSITIVITY[\"verdict_baseline\"])\n","\n","_agreement = (BLOCK_SENSITIVITY.groupby(\"feature\")[\"verdict\"].nunique()\n","              .rename(\"distinct_verdicts\").reset_index())\n","_agreement[\"robust_to_block_count\"] = _agreement[\"distinct_verdicts\"] == 1\n","BLOCK_SENSITIVITY = BLOCK_SENSITIVITY.merge(_agreement, on=\"feature\", how=\"left\")\n","\n","BLOCK_SENSITIVITY_PATH = os.path.join(OUTPUT_DIRECTORY, \"block_sensitivity_summary.csv\")\n","BLOCK_SENSITIVITY.to_csv(BLOCK_SENSITIVITY_PATH, index=False)\n","LOG.info(\"Wrote %s\", BLOCK_SENSITIVITY_PATH)\n","\n","_unstable = _agreement[~_agreement.robust_to_block_count][\"feature\"].tolist()\n","print(f\"\\nFeatures whose verdict is identical under 4, 5, 6 and 8 blocks: \"\n","      f\"{int(_agreement.robust_to_block_count.sum())} of {len(_agreement)}.\")\n","print(f\"Features whose verdict changes with the block count: \"\n","      f\"{_unstable if _unstable else 'none'}\")\n","print(\"\\nVerdict counts by configuration:\")\n","print(BLOCK_SENSITIVITY.pivot_table(index=\"verdict\", columns=\"n_blocks\",\n","                                    values=\"feature\", aggfunc=\"count\", fill_value=0)\n","      .to_string())\n","\n","fig, ax = plt.subplots(figsize=(8, 3.6))\n","_pivot = BLOCK_SENSITIVITY.pivot_table(index=\"n_blocks\", columns=\"verdict\",\n","                                       values=\"feature\", aggfunc=\"count\", fill_value=0)\n","_pivot.plot(kind=\"bar\", stacked=True, ax=ax)\n","ax.set_xlabel(\"number of chronological blocks (final block reserved as OOT)\")\n","ax.set_ylabel(\"features\")\n","ax.set_title(\"Are the drift verdicts an artefact of the block count?\")\n","ax.legend(fontsize=8, title=\"verdict\")\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"345b0ea3","metadata":{"_cell_guid":"52e9367a-1ad5-4d5c-8519-bc5f4ff401d0","_uuid":"ed632f22-c201-45dd-95c5-e0d1c95f1b29","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.020189,"end_time":"2026-09-29T09:36:05.284289+00:00","exception":false,"start_time":"2026-09-29T09:36:05.2641+00:00","status":"completed"},"tags":[]},"source":["### Interpreting Section 9\n","\n","Read this table as a robustness statement about the *conclusions*, not about the\n","data. A feature whose verdict is identical under all four configurations is\n","robust to this particular arbitrary choice — which is weaker than \"correct\", but\n","considerably stronger than a single split. Features whose verdicts move are\n","demoted to `monitor` in the ledger and named explicitly, because a verdict that\n","depends on how many pieces the timeline was cut into should not be presented with\n","the same confidence as one that does not."]},{"cell_type":"markdown","id":"c050d3bf","metadata":{"_cell_guid":"86c5defa-f4ce-4aa8-bbd4-9b03a2d6e330","_uuid":"df0e1c8a-8942-4ca4-b8e8-b5131e26f745","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.020263,"end_time":"2026-09-29T09:36:05.324896+00:00","exception":false,"start_time":"2026-09-29T09:36:05.304633+00:00","status":"completed"},"tags":[]},"source":["## 10. Threshold Justification\n","\n","The source notebook flagged drift at `|Pearson r| >= 0.30` with no derivation.\n","That is replaced here by: Spearman (the association is monotone, not linear, and\n","the tails are heavy), the full empirical distribution of `|ρ|` across development\n","features, and a quantile-derived alternative cut-off computed from development\n","rows only. The configured value remains configurable and is fixed before any OOT\n","number is consulted."]},{"cell_type":"code","execution_count":13,"id":"8aea1c1d","metadata":{"_cell_guid":"9f2a9a3a-30b7-4493-a152-c11b0c32c40c","_uuid":"7dfa79c9-be34-4045-b0bc-12179c949b93","collapsed":false,"execution":{"iopub.execute_input":"2026-09-29T09:36:05.368356Z","iopub.status.busy":"2026-09-29T09:36:05.367692Z","iopub.status.idle":"2026-09-29T09:36:05.844148Z","shell.execute_reply":"2026-09-29T09:36:05.843326Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.501612,"end_time":"2026-09-29T09:36:05.847065+00:00","exception":false,"start_time":"2026-09-29T09:36:05.345453+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["{\n","  \"n_features\": 371,\n","  \"quantile\": 0.99,\n","  \"derived_threshold\": 0.2892023546721702,\n","  \"median_abs_corr\": 0.036274814554646956,\n","  \"p90_abs_corr\": 0.10838906393647053,\n","  \"max_abs_corr\": 0.3325707979066202,\n","  \"configured_threshold\": 0.3,\n","  \"share_above_configured\": 0.008086253369272238\n","}\n","\n","Reading this table: the configured threshold (0.3) flags 0.8% of assessable development features. The empirically derived cut-off is the 99% quantile of the same distribution. Neither is a law: a threshold sets how much review capacity is spent, and it is deliberately fixed BEFORE any OOT number is consulted.\n","\n","Statistical significance is not practical risk. At ~470k development rows a |Spearman| of 0.01 is significant at any conventional alpha and is practically irrelevant, which is why the verdict rule combines the correlation with PSI and with lift stability rather than relying on any single cut-off.\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1320x396 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["\"\"\"Section 10 - deriving the temporal-correlation threshold instead of asserting it.\"\"\"\n","\n","\n","def derive_correlation_threshold(correlations: Sequence[float],\n","                                 quantile: float = 0.99) -> Dict[str, Any]:\n","    \"\"\"Derive a temporal-correlation cut-off from the DEVELOPMENT distribution.\n","\n","    The source notebook used ``DRIFT_CORR = 0.30`` on a Pearson correlation with\n","    no stated provenance. Two changes are made here:\n","\n","      1. Spearman replaces Pearson, because the association of interest is\n","         monotone drift, not a linear relationship, and the D and V series have\n","         tails that dominate a Pearson estimate.\n","      2. The cut-off becomes an EMPIRICAL quantile of the observed |Spearman|\n","         distribution across development features, so it is a statement about\n","         this dataset (\"the most time-associated 1% of features\") rather than an\n","         imported constant. It is computed from development rows only.\n","\n","    Returns the derived value alongside the configured one so the difference is\n","    visible and the choice remains the analyst's.\n","    \"\"\"\n","    values = np.asarray([abs(c) for c in correlations if c is not None and np.isfinite(c)])\n","    if values.size == 0:\n","        raise ValueError(\"No finite correlations supplied; a threshold cannot be derived.\")\n","    return {\n","        \"n_features\": int(values.size),\n","        \"quantile\": quantile,\n","        \"derived_threshold\": float(np.quantile(values, quantile)),\n","        \"median_abs_corr\": float(np.median(values)),\n","        \"p90_abs_corr\": float(np.quantile(values, 0.90)),\n","        \"max_abs_corr\": float(values.max()),\n","        \"configured_threshold\": CONFIG[\"SPEARMAN_RISK_THRESHOLD\"],\n","        \"share_above_configured\": float((values >= CONFIG[\"SPEARMAN_RISK_THRESHOLD\"]).mean()),\n","    }\n","\n","\n","AUDITOR.guard(\"correlation_threshold_derivation\", dev_df[[ID_COLUMN]])\n","THRESHOLD_EVIDENCE = derive_correlation_threshold(\n","    feature_risk[\"spearman_corr_time\"].tolist())\n","AUDITOR.register_fit(\"temporal_correlation_threshold\", \"threshold\",\n","                     dev_df[ID_COLUMN].to_numpy(), DEV_BLOCKS)\n","\n","print(json.dumps(THRESHOLD_EVIDENCE, indent=2))\n","print(\"\\nReading this table: the configured threshold \"\n","      f\"({CONFIG['SPEARMAN_RISK_THRESHOLD']}) flags \"\n","      f\"{100 * THRESHOLD_EVIDENCE['share_above_configured']:.1f}% of assessable \"\n","      \"development features. The empirically derived cut-off is the \"\n","      f\"{THRESHOLD_EVIDENCE['quantile']:.0%} quantile of the same distribution. \"\n","      \"Neither is a law: a threshold sets how much review capacity is spent, and \"\n","      \"it is deliberately fixed BEFORE any OOT number is consulted.\")\n","print(\"\\nStatistical significance is not practical risk. At ~470k development rows \"\n","      \"a |Spearman| of 0.01 is significant at any conventional alpha and is \"\n","      \"practically irrelevant, which is why the verdict rule combines the \"\n","      \"correlation with PSI and with lift stability rather than relying on any \"\n","      \"single cut-off.\")\n","\n","fig, axes = plt.subplots(1, 2, figsize=(12, 3.6))\n","_abs_corr = feature_risk[\"spearman_corr_time\"].abs().dropna()\n","axes[0].hist(_abs_corr, bins=40)\n","axes[0].axvline(CONFIG[\"SPEARMAN_RISK_THRESHOLD\"], color=\"crimson\", ls=\"--\",\n","                label=f\"configured {CONFIG['SPEARMAN_RISK_THRESHOLD']}\")\n","axes[0].axvline(THRESHOLD_EVIDENCE[\"derived_threshold\"], color=\"seagreen\", ls=\"--\",\n","                label=f\"derived p{THRESHOLD_EVIDENCE['quantile']:.0%} \"\n","                      f\"{THRESHOLD_EVIDENCE['derived_threshold']:.3f}\")\n","axes[0].set_xlabel(\"|Spearman correlation with elapsed time| (development)\")\n","axes[0].set_ylabel(\"features\")\n","axes[0].set_title(\"Distribution of temporal association across development features\")\n","axes[0].legend(fontsize=8)\n","\n","_sorted = np.sort(_abs_corr)\n","axes[1].plot(_sorted, np.arange(1, _sorted.size + 1) / _sorted.size)\n","axes[1].axvline(CONFIG[\"SPEARMAN_RISK_THRESHOLD\"], color=\"crimson\", ls=\"--\")\n","axes[1].axvline(THRESHOLD_EVIDENCE[\"derived_threshold\"], color=\"seagreen\", ls=\"--\")\n","axes[1].set_xlabel(\"|Spearman correlation with elapsed time|\")\n","axes[1].set_ylabel(\"cumulative share of features\")\n","axes[1].set_title(\"How many features any given cut-off would flag\")\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"4e44d087","metadata":{"_cell_guid":"666a73b5-8cc9-4a8c-8fc6-3a4a81d6d432","_uuid":"6e4c68fa-9905-48c1-b5b0-6c8e13e4b64c","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.020558,"end_time":"2026-09-29T09:36:05.889861+00:00","exception":false,"start_time":"2026-09-29T09:36:05.869303+00:00","status":"completed"},"tags":[]},"source":["### Interpreting Section 10\n","\n","A threshold is a **capacity decision**: it determines how many features get human\n","review, and the honest way to set it is against the observed distribution, not\n","against a number inherited from a blog post. Two guarantees hold regardless of\n","the value chosen: it is derived from development data only, and PSI and lift\n","stability are carried alongside it, so no feature is condemned or exonerated by a\n","single statistic."]},{"cell_type":"markdown","id":"ebea41a0","metadata":{"_cell_guid":"eaa74a25-22f0-4bdd-aa79-2683b766815c","_uuid":"cdfe03be-c184-402e-ae48-1a23abcb909d","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.020172,"end_time":"2026-09-29T09:36:05.930388+00:00","exception":false,"start_time":"2026-09-29T09:36:05.910216+00:00","status":"completed"},"tags":[]},"source":["## 11. Machine-Readable Decisions Ledger\n","\n","One JSON entry per feature: family, the ten diagnostic values (with `null`\n","preserved wherever a metric was not applicable or not estimable), verdict,\n","reason, action, decision scope, the evidence sections that produced it, the\n","configuration snapshot, the data hash, the code version and a timestamp.\n","\n","`update_decisions_ledger` enforces the contract instead of trusting it: the\n","verdict and action vocabularies are closed, a non-empty reason is mandatory, and\n","at least one evidence section must be cited. A decision cannot enter the ledger\n","without its evidence."]},{"cell_type":"code","execution_count":14,"id":"dd07d0c4","metadata":{"_cell_guid":"d3701530-6862-4915-bcfb-0212fade3954","_uuid":"ef5bd6a2-d7af-40e1-bf48-643e21353a2a","collapsed":false,"execution":{"iopub.execute_input":"2026-09-29T09:36:05.973317Z","iopub.status.busy":"2026-09-29T09:36:05.973001Z","iopub.status.idle":"2026-09-29T09:36:06.345667Z","shell.execute_reply":"2026-09-29T09:36:06.344691Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.39719,"end_time":"2026-09-29T09:36:06.347726+00:00","exception":false,"start_time":"2026-09-29T09:36:05.950536+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["09:36:06 | INFO    | Wrote ./artifacts/decisions_ledger.json (371 features).\n"]},{"name":"stdout","output_type":"stream","text":["              verdict       action  features\n","insufficient_evidence  investigate         1\n","        moderate_risk      monitor        13\n","            redundant tag_not_drop        23\n","               stable         keep        68\n","               stable      monitor         3\n","        temporal_risk tag_not_drop       263\n","\n","Example entry:\n","{\n","  \"feature_family\": \"C\",\n","  \"diagnostic_results\": {\n","    \"psi_max\": 0.05029087097817326,\n","    \"ks_stat\": 0.10927286889965115,\n","    \"ks_adjusted_pvalue\": 0.0,\n","    \"spearman_corr_time\": 0.06099916706675135,\n","    \"lift_stability\": 0.8759263602153,\n","    \"missingness_drift\": 0.0,\n","    \"cluster_id\": null,\n","    \"cluster_stability\": null,\n","    \"mutual_information_dev\": null,\n","    \"oot_cold_start_rate\": null\n","  },\n","  \"verdict\": \"stable\",\n","  \"reason\": \"dev PSI_max 0.050 below 0.1, |Spearman| 0.061 below 0.300\",\n","  \"action\": \"keep\",\n","  \"decision_scope\": \"development_only\",\n","  \"evidence_sections\": [\n","    \"5. D-Series Temporal Risk Analysis\"\n","  ],\n","  \"config_snapshot\": {\n","    \"RANDOM_SEED\": 42,\n","    \"N_BLOCKS\": 5,\n","    \"OOT_BLOCK\": 5,\n","    \"PSI_BINS\": 10,\n","    \"PSI_EPSILON\": 1e-06,\n","    \"PSI_MODERATE_THRESHOLD\": 0.1,\n","    \"PSI_SEVERE_THRESHOLD\": 0.25,\n","    \"KS_ALPHA\": 0.05,\n","    \"TEMPORAL_CORRELATION_METHOD\": \"spearman\",\n","    \"SPEARMAN_RISK_THRESHOLD\": 0.3,\n","    \"CLUSTER_DISTANCE_THRESHOLD\": 0.1,\n","    \"CLUSTER_STABILITY_THRESHOLD\": 0.75,\n","    \"TOP_DECILE_QUANTILE\": 0.9,\n","    \"MIN_POSITIVES_FOR_LIFT\": 30,\n","    \"LIFT_STABILITY_THRESHOLD\": 0.75,\n","    \"ENTITY_COLD_START_MODERATE_THRESHOLD\": 0.05,\n","    \"ENTITY_COLD_START_HIGH_THRESH\n","\n","'tag_not_drop' means the column is retained and carried into modelling with a risk tag attached; it is NOT an automatic exclusion. 'drop' is reserved for columns with no usable content at all.\n"]}],"source":["\"\"\"Section 11 - the machine-readable decisions ledger.\"\"\"\n","\n","\n","def _nullable(value: Any) -> Optional[float]:\n","    \"\"\"Convert numpy/NaN values to JSON-safe floats, preserving null as null.\"\"\"\n","    if value is None:\n","        return None\n","    if isinstance(value, (np.floating, float)):\n","        return None if not np.isfinite(value) else float(value)\n","    if isinstance(value, (np.integer, int)):\n","        return int(value)\n","    if isinstance(value, (np.bool_, bool)):\n","        return bool(value)\n","    return value\n","\n","\n","def update_decisions_ledger(ledger: Dict[str, Dict[str, Any]], feature: str,\n","                            feature_family: str, diagnostics: Mapping[str, Any],\n","                            verdict: str, reason: str, action: str,\n","                            evidence_sections: Sequence[str],\n","                            config_snapshot: Mapping[str, Any],\n","                            data_hash: str, code_version: str,\n","                            decision_scope: str = \"development_only\") -> Dict[str, Dict[str, Any]]:\n","    \"\"\"Insert or replace one feature's entry in the decisions ledger.\n","\n","    Contract enforced here rather than trusted:\n","      * ``verdict`` and ``action`` must be drawn from the allowed vocabularies;\n","      * a metric that was not computed stays ``null`` - it is never coerced to 0;\n","      * a non-empty ``reason`` and at least one evidence section are required for\n","        every verdict, so no decision can be recorded without its evidence.\n","    \"\"\"\n","    allowed_verdicts = {\"stable\", \"moderate_risk\", \"temporal_risk\", \"redundant\",\n","                        \"insufficient_evidence\"}\n","    allowed_actions = {\"keep\", \"drop\", \"tag_not_drop\", \"monitor\", \"investigate\"}\n","    allowed_scopes = {\"development_only\", \"oot_evaluation_only\", \"development_plus_oot_evaluation\"}\n","    if verdict not in allowed_verdicts:\n","        raise ValueError(f\"verdict '{verdict}' is not one of {sorted(allowed_verdicts)}.\")\n","    if action not in allowed_actions:\n","        raise ValueError(f\"action '{action}' is not one of {sorted(allowed_actions)}.\")\n","    if decision_scope not in allowed_scopes:\n","        raise ValueError(f\"decision_scope {decision_scope!r} is not one of {sorted(allowed_scopes)}.\")\n","    if not reason:\n","        raise ValueError(f\"A reason is mandatory; '{feature}' supplied none.\")\n","    if not evidence_sections:\n","        raise ValueError(f\"'{feature}' must cite at least one evidence section.\")\n","\n","    ledger[feature] = {\n","        \"feature_family\": feature_family,\n","        \"diagnostic_results\": {\n","            \"psi_max\": _nullable(diagnostics.get(\"psi_max\")),\n","            \"ks_stat\": _nullable(diagnostics.get(\"ks_stat\")),\n","            \"ks_adjusted_pvalue\": _nullable(diagnostics.get(\"ks_adjusted_pvalue\")),\n","            \"spearman_corr_time\": _nullable(diagnostics.get(\"spearman_corr_time\")),\n","            \"lift_stability\": _nullable(diagnostics.get(\"lift_stability\")),\n","            \"missingness_drift\": _nullable(diagnostics.get(\"missingness_drift\")),\n","            \"cluster_id\": _nullable(diagnostics.get(\"cluster_id\")),\n","            \"cluster_stability\": _nullable(diagnostics.get(\"cluster_stability\")),\n","            \"mutual_information_dev\": _nullable(diagnostics.get(\"mutual_information_dev\")),\n","            \"oot_cold_start_rate\": _nullable(diagnostics.get(\"oot_cold_start_rate\")),\n","        },\n","        \"verdict\": verdict,\n","        \"reason\": reason,\n","        \"action\": action,\n","        \"decision_scope\": decision_scope,\n","        \"evidence_sections\": list(evidence_sections),\n","        \"config_snapshot\": dict(config_snapshot),\n","        \"data_hash\": data_hash,\n","        \"code_version\": code_version,\n","        \"created_at\": datetime.now(timezone.utc).isoformat(timespec=\"seconds\"),\n","    }\n","    return ledger\n","\n","\n","CONFIG_SNAPSHOT = {k: CONFIG[k] for k in [\n","    \"RANDOM_SEED\", \"N_BLOCKS\", \"OOT_BLOCK\", \"PSI_BINS\", \"PSI_EPSILON\",\n","    \"PSI_MODERATE_THRESHOLD\", \"PSI_SEVERE_THRESHOLD\", \"KS_ALPHA\",\n","    \"TEMPORAL_CORRELATION_METHOD\", \"SPEARMAN_RISK_THRESHOLD\",\n","    \"CLUSTER_DISTANCE_THRESHOLD\", \"CLUSTER_STABILITY_THRESHOLD\",\n","    \"TOP_DECILE_QUANTILE\", \"MIN_POSITIVES_FOR_LIFT\", \"LIFT_STABILITY_THRESHOLD\",\n","    \"ENTITY_COLD_START_MODERATE_THRESHOLD\", \"ENTITY_COLD_START_HIGH_THRESHOLD\",\n","    \"FIXED_FPR\"]}\n","\n","DECISIONS_LEDGER: Dict[str, Dict[str, Any]] = {}\n","_cluster_lookup = (V_SUMMARY.set_index(\"feature\") if len(V_SUMMARY) else pd.DataFrame())\n","_cold_lookup = (ENTITY_SUMMARY.set_index(\"entity\")[\"cold_start_rate\"].to_dict()\n","                if len(ENTITY_SUMMARY) else {})\n","\n","for _, row in feature_risk.iterrows():\n","    feature = row[\"feature\"]\n","    verdict, action, reason = row[\"verdict\"], row[\"action\"], row[\"reason\"]\n","    sections = [\"5. D-Series Temporal Risk Analysis\"]\n","    cluster_id = cluster_stability_value = mi_value = None\n","\n","    if len(_cluster_lookup) and feature in _cluster_lookup.index:\n","        entry = _cluster_lookup.loc[feature]\n","        cluster_id = entry.get(\"cluster_id\")\n","        cluster_stability_value = entry.get(\"cluster_stability\")\n","        mi_value = entry.get(\"mutual_information_dev\")\n","        sections.append(\"7. V-Series Redundancy and Stability\")\n","        if entry.get(\"final_action\") == \"tag_not_drop\" and verdict == \"stable\":\n","            verdict = \"redundant\"\n","            action = \"tag_not_drop\"\n","            reason = (f\"co-clusters with {entry.get('partners', '')} at distance \"\n","                      f\"<= {CONFIG['CLUSTER_DISTANCE_THRESHOLD']} in \"\n","                      f\"{entry.get('n_blocks_assessed', 0)} development blocks \"\n","                      f\"(stability {entry.get('cluster_stability')}); \"\n","                      f\"{entry.get('selection_reason', '')}\")\n","\n","    sensitivity_rows = BLOCK_SENSITIVITY[BLOCK_SENSITIVITY.feature == feature]\n","    if len(sensitivity_rows):\n","        sections.append(\"9. Block-Count Sensitivity Analysis\")\n","        if not bool(sensitivity_rows[\"robust_to_block_count\"].iloc[0]):\n","            reason += (\"; verdict is NOT robust to the block count \"\n","                       f\"({sorted(set(sensitivity_rows.verdict))} under \"\n","                       f\"{sorted(set(sensitivity_rows.n_blocks))} blocks)\")\n","            if action == \"keep\":\n","                action = \"monitor\"\n","\n","    DECISIONS_LEDGER = update_decisions_ledger(\n","        DECISIONS_LEDGER, feature=feature, feature_family=row[\"family\"],\n","        diagnostics={\n","            \"psi_max\": row[\"PSI_max_development_only\"],\n","            \"ks_stat\": row[\"ks_stat\"],\n","            \"ks_adjusted_pvalue\": row[\"ks_adjusted_pvalue\"],\n","            \"spearman_corr_time\": row[\"spearman_corr_time\"],\n","            \"lift_stability\": row[\"lift_stability\"],\n","            \"missingness_drift\": row[\"missingness_drift\"],\n","            \"cluster_id\": cluster_id,\n","            \"cluster_stability\": cluster_stability_value,\n","            \"mutual_information_dev\": mi_value,\n","            \"oot_cold_start_rate\": None,\n","        },\n","        verdict=verdict, reason=reason, action=action,\n","        evidence_sections=sections, config_snapshot=CONFIG_SNAPSHOT,\n","        data_hash=DATA_HASH[\"sha256\"], code_version=CONFIG[\"CODE_VERSION\"])\n","\n","for entity in ENTITY_COLUMNS:\n","    rate = _cold_lookup.get(entity)\n","    reliable = (bool(ENTITY_SUMMARY.set_index(\"entity\").loc[entity, \"cold_start_reliable\"])\n","                if len(ENTITY_SUMMARY) and \"cold_start_reliable\" in ENTITY_SUMMARY.columns\n","                else False)\n","    diagnostic = {\n","        \"oot_cold_start_rate\": (float(rate) if rate is not None and np.isfinite(rate) else None),\n","        \"cold_start_reliable\": reliable,\n","        \"decision_scope\": \"oot_evaluation_only\",\n","        \"development_action_changed\": False,\n","    }\n","    # OOT cold-start is evaluation evidence only. It may enrich an existing\n","    # development decision, but it must never create or overwrite verdict/action.\n","    if entity in DECISIONS_LEDGER:\n","        DECISIONS_LEDGER[entity].setdefault(\"evaluation_diagnostics\", {})\n","        DECISIONS_LEDGER[entity][\"evaluation_diagnostics\"][\"oot_cold_start\"] = diagnostic\n","\n","LEDGER_PATH = os.path.join(OUTPUT_DIRECTORY, \"decisions_ledger.json\")\n","_serialised = json.dumps(DECISIONS_LEDGER, indent=2, allow_nan=False)\n","with open(LEDGER_PATH, \"w\", encoding=\"utf-8\") as handle:\n","    handle.write(_serialised)\n","LOG.info(\"Wrote %s (%d features).\", LEDGER_PATH, len(DECISIONS_LEDGER))\n","\n","_ledger_frame = pd.DataFrame([\n","    {\"feature\": k, \"family\": v[\"feature_family\"], \"verdict\": v[\"verdict\"],\n","     \"action\": v[\"action\"]} for k, v in DECISIONS_LEDGER.items()])\n","print(_ledger_frame.groupby([\"verdict\", \"action\"]).size().rename(\"features\")\n","      .reset_index().to_string(index=False))\n","print(\"\\nExample entry:\")\n","print(json.dumps(DECISIONS_LEDGER[_ledger_frame.feature.iloc[0]], indent=2)[:1200])\n","print(\"\\n'tag_not_drop' means the column is retained and carried into modelling with \"\n","      \"a risk tag attached; it is NOT an automatic exclusion. 'drop' is reserved for \"\n","      \"columns with no usable content at all.\")"]},{"cell_type":"markdown","id":"bbe573f9","metadata":{"_cell_guid":"7233ad89-85ea-4852-8c95-caf3a9b5e7ca","_uuid":"2f643e8b-bf8e-4a41-abc4-9d15d5272631","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.02119,"end_time":"2026-09-29T09:36:06.38977+00:00","exception":false,"start_time":"2026-09-29T09:36:06.36858+00:00","status":"completed"},"tags":[]},"source":["### Interpreting Section 11\n","\n","`tag_not_drop` is the deliberate middle path and the reason the action vocabulary\n","is not binary. It means: keep the column, carry the risk tag into modelling, and\n","test its removal as an **ablation** rather than assuming the removal is an\n","improvement. Dropping a temporally unstable feature is itself a modelling\n","decision with a cost, and this notebook does not have the evidence to make it.\n","\n","`insufficient_evidence` is recorded explicitly for the same reason. An unrunnable\n","diagnostic is a fact about the data — a constant column, a near-empty block, too\n","few positives — and hiding it behind a default value would misrepresent the\n","audit's coverage."]},{"cell_type":"markdown","id":"2f793391","metadata":{"_cell_guid":"8878eb8f-3894-41dd-9f88-c45964c9c822","_uuid":"186e1769-9765-4c6c-a6dc-e3f514181faa","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.021558,"end_time":"2026-09-29T09:36:06.432262+00:00","exception":false,"start_time":"2026-09-29T09:36:06.410704+00:00","status":"completed"},"tags":[]},"source":["## 12. Consolidated Findings\n","\n","Assembled from the computed artifacts, with observed evidence, configured\n","decision rules, methodological interpretation and forward-looking\n","recommendations kept in separate blocks so they cannot be read as one anoth