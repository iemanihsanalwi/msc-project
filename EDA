ersion. Call result.infer_objects(copy=False) instead. To opt-in to the future behavior, set `pd.set_option('future.no_silent_downcasting', True)`\n","  np.where(V_SUMMARY[\"is_representative\"].fillna(False), \"keep\", \"tag_not_drop\"))\n","/tmp/ipykernel_16/4029322801.py:213: FutureWarning: Downcasting object dtype arrays on .fillna, .ffill, .bfill is deprecated and will change in a future version. Call result.infer_objects(copy=False) instead. To opt-in to the future behavior, set `pd.set_option('future.no_silent_downcasting', True)`\n","  f\"representatives kept: {int(V_SUMMARY.is_representative.fillna(False).sum())}.\")\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 770x374 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["\"\"\"Section 7 - V-series redundancy, cross-block stability and representatives.\"\"\"\n","\n","\n","def evenly_spaced_sample(frame: pd.DataFrame, max_rows: int) -> pd.DataFrame:\n","    \"\"\"Return at most ``max_rows`` deterministic, evenly spaced rows.\"\"\"\n","    if max_rows < 1:\n","        raise ValueError(f\"max_rows must be positive, got {max_rows}.\")\n","    if len(frame) <= max_rows:\n","        return frame\n","    positions = np.linspace(0, len(frame) - 1, num=max_rows, dtype=np.int64)\n","    return frame.iloc[positions]\n","\n","\n","def cluster_v_features_by_block(frame: pd.DataFrame, features: Sequence[str],\n","                                block: int, block_column: str = \"chrono_block\",\n","                                distance_threshold: float = CONFIG[\"CLUSTER_DISTANCE_THRESHOLD\"],\n","                                sample_rows: int = CONFIG[\"CORR_SAMPLE_ROWS\"],\n","                                seed: int = RANDOM_SEED) -> Dict[str, Any]:\n","    \"\"\"Cluster features within ONE block using distance = 1 - |Spearman|.\n","\n","    An evenly-spaced (not random) sample is drawn when the block exceeds\n","    ``sample_rows``, which preserves the chronology inside the block instead of\n","    over-weighting any part of it, and is deterministic. Average linkage on the\n","    condensed distance matrix keeps memory at O(k^2) for k features and avoids\n","    any dense row-by-row adjacency structure.\n","\n","    Returns:\n","        dict with cluster_map (feature -> cluster id), n_features, n_rows_used,\n","        block, and the approximation note describing any sampling applied.\n","    \"\"\"\n","    block_frame = frame.loc[frame[block_column] == block, list(features)]\n","    n_rows = len(block_frame)\n","    note = \"full block\"\n","    if n_rows > sample_rows:\n","        block_frame = evenly_spaced_sample(block_frame, sample_rows)\n","        note = (f\"evenly spaced deterministic sample of the block \"\n","                f\"({len(block_frame):,} of {n_rows:,} rows); APPROXIMATION\")\n","    usable = [c for c in features if block_frame[c].notna().sum() >= CONFIG[\"MIN_NON_MISSING\"]\n","              and block_frame[c].nunique(dropna=True) > 1]\n","    if len(usable) < 2:\n","        return {\"cluster_map\": {}, \"n_features\": len(usable), \"n_rows_used\": len(block_frame),\n","                \"block\": int(block), \"note\": note + \"; too few usable features to cluster\"}\n","    corr = block_frame[usable].corr(method=\"spearman\", min_periods=CONFIG[\"MIN_NON_MISSING\"])\n","    distance = (1 - corr.abs()).to_numpy()\n","    distance = np.nan_to_num(distance, nan=1.0)\n","    np.fill_diagonal(distance, 0.0)\n","    distance = np.clip((distance + distance.T) / 2, 0, None)\n","    linkage_matrix = linkage(squareform(distance, checks=False), method=\"average\")\n","    labels = fcluster(linkage_matrix, t=distance_threshold, criterion=\"distance\")\n","    return {\"cluster_map\": {f: int(l) for f, l in zip(usable, labels)},\n","            \"n_features\": len(usable), \"n_rows_used\": int(len(block_frame)),\n","            \"block\": int(block), \"note\": note}\n","\n","\n","def assess_cluster_stability(cluster_maps: Mapping[int, Mapping[str, int]],\n","                             features: Sequence[str]) -> pd.DataFrame:\n","    \"\"\"Measure how often two features co-cluster across development blocks.\n","\n","    For every feature pair assessable in at least two blocks, the co-membership\n","    rate is the share of those blocks in which the pair shares a cluster. A\n","    feature's ``cluster_stability`` is the mean co-membership rate over the\n","    partners it shares its reference-block cluster with; a singleton scores 1.0\n","    only if it is a singleton everywhere, and NaN when it was never assessable.\n","    \"\"\"\n","    blocks = sorted(cluster_maps)\n","    if len(blocks) < 2:\n","        raise ValueError(\"Cluster stability needs at least two blocks.\")\n","    reference = cluster_maps[blocks[0]]\n","    rows = []\n","    for feature in features:\n","        if feature not in reference:\n","            rows.append({\"feature\": feature, \"cluster_id\": None,\n","                         \"cluster_stability\": np.nan, \"n_blocks_assessed\": 0,\n","                         \"partners\": \"\"})\n","            continue\n","        partners = [f for f, c in reference.items()\n","                    if c == reference[feature] and f != feature]\n","        assessed = [b for b in blocks if feature in cluster_maps[b]]\n","        if not partners:\n","            singleton_rate = float(np.mean([\n","                sum(1 for f, c in cluster_maps[b].items()\n","                    if c == cluster_maps[b][feature] and f != feature) == 0\n","                for b in assessed])) if assessed else np.nan\n","            rows.append({\"feature\": feature, \"cluster_id\": int(reference[feature]),\n","                         \"cluster_stability\": singleton_rate,\n","                         \"n_blocks_assessed\": len(assessed), \"partners\": \"\"})\n","            continue\n","        rates = []\n","        for partner in partners:\n","            shared = [b for b in assessed if partner in cluster_maps[b]]\n","            if shared:\n","                rates.append(np.mean([cluster_maps[b][feature] == cluster_maps[b][partner]\n","                                      for b in shared]))\n","        rows.append({\"feature\": feature, \"cluster_id\": int(reference[feature]),\n","                     \"cluster_stability\": float(np.mean(rates)) if rates else np.nan,\n","                     \"n_blocks_assessed\": len(assessed),\n","                     \"partners\": \", \".join(sorted(partners)[:8])\n","                                 + (\" ...\" if len(partners) > 8 else \"\")})\n","    return pd.DataFrame(rows)\n","\n","\n","def select_cluster_representatives(frame: pd.DataFrame, stability: pd.DataFrame,\n","                                   target: str = TARGET_COLUMN,\n","                                   stability_threshold: float = CONFIG[\"CLUSTER_STABILITY_THRESHOLD\"],\n","                                   sample_rows: int = CONFIG[\"CORR_SAMPLE_ROWS\"],\n","                                   seed: int = RANDOM_SEED) -> pd.DataFrame:\n","    \"\"\"Pick one representative per sufficiently stable cluster.\n","\n","    Ranking key, applied in this exact order so ties are broken deterministically\n","    and never by dict or file ordering:\n","        1. higher mutual information with the target (DEVELOPMENT rows only),\n","        2. lower development missing rate,\n","        3. lexicographically smaller feature name.\n","\n","    ``frame`` must be development-only; the caller passes it through the leakage\n","    auditor first, and this function never receives an OOT target column.\n","    \"\"\"\n","    if target not in frame.columns:\n","        raise KeyError(f\"'{target}' is required to score representatives.\")\n","    stable = stability[stability.cluster_id.notna()\n","                       & (stability.cluster_stability >= stability_threshold)]\n","    rows = []\n","    for cluster_id, members in stable.groupby(\"cluster_id\"):\n","        columns = sorted(members.feature)\n","        subset = frame[columns + [target]]\n","        if len(subset) > sample_rows:\n","            subset = evenly_spaced_sample(subset, sample_rows)\n","        filled = subset[columns].astype(float)\n","        filled = filled.replace([np.inf, -np.inf], np.nan)\n","        # Median imputation for the MI estimate only; medians come from the same\n","        # development sample and are never applied to OOT or to the modelling data.\n","        filled = filled.fillna(filled.median(numeric_only=True)).fillna(0.0)\n","        try:\n","            mi = mutual_info_classif(filled.to_numpy(), subset[target].to_numpy(),\n","                                     discrete_features=False, random_state=seed)\n","        except ValueError as exc:\n","            LOG.warning(\"Mutual information failed for cluster %s (%s). Falling back \"\n","                        \"to the completeness + name ordering and recording the \"\n","                        \"fallback in the reason.\", cluster_id, exc)\n","            mi = np.full(len(columns), np.nan)\n","        missing_rate = frame[columns].isna().mean()\n","        ranked = sorted(\n","            range(len(columns)),\n","            key=lambda i: (-(mi[i] if np.isfinite(mi[i]) else -1.0),\n","                           float(missing_rate[columns[i]]), columns[i]),\n","        )\n","        best = ranked[0]\n","        for i, column in enumerate(columns):\n","            rows.append({\n","                \"cluster_id\": int(cluster_id), \"feature\": column,\n","                \"cluster_size\": len(columns),\n","                \"mutual_information_dev\": float(mi[i]) if np.isfinite(mi[i]) else None,\n","                \"development_missing_rate\": float(missing_rate[column]),\n","                \"is_representative\": i == best,\n","                \"selection_reason\": (\n","                    \"highest development mutual information; ties broken by lower \"\n","                    \"missing rate then lexicographic name\"\n","                    if i == best else\n","                    f\"redundant with {columns[best]} (same stable cluster)\"),\n","            })\n","    return pd.DataFrame(rows)\n","\n","\n","if V_SERIES:\n","    _v_missing_dev = dev_df[V_SERIES].isna().mean()\n","    V_USABLE = sorted([c for c in V_SERIES\n","                       if _v_missing_dev[c] * 100 < CONFIG[\"V_MAX_MISSING_PCT\"]],\n","                      key=lambda c: int(c[1:]))\n","    V_TOO_SPARSE = [c for c in V_SERIES if c not in V_USABLE]\n","    print(f\"Workload estimate: {len(V_USABLE)} V columns x {len(DEV_BLOCKS)} development \"\n","          f\"blocks; each block correlates a {len(V_USABLE)}x{len(V_USABLE)} Spearman \"\n","          f\"matrix on at most {CONFIG['CORR_SAMPLE_ROWS']:,} rows \"\n","          f\"(~{len(V_USABLE) ** 2 * 8 / 1e6:.0f} MB per matrix, one at a time).\")\n","\n","    CLUSTER_MAPS: Dict[int, Dict[str, int]] = {}\n","    CLUSTER_NOTES: Dict[int, str] = {}\n","    for block in DEV_BLOCKS:\n","        AUDITOR.guard(f\"v_cluster_block{block}\", df.loc[df.chrono_block == block, [ID_COLUMN]])\n","        result = cluster_v_features_by_block(dev_df, V_USABLE, block=block)\n","        CLUSTER_MAPS[block] = result[\"cluster_map\"]\n","        CLUSTER_NOTES[block] = result[\"note\"]\n","        AUDITOR.register_fit(f\"v_clustering_block{block}\", \"clustering\",\n","                             df.loc[df.chrono_block == block, ID_COLUMN].to_numpy(), [block])\n","        LOG.info(\"Block %d: %d features clustered into %d clusters (%s).\", block,\n","                 result[\"n_features\"], len(set(result[\"cluster_map\"].values())), result[\"note\"])\n","\n","    CLUSTER_STABILITY = assess_cluster_stability(CLUSTER_MAPS, V_USABLE)\n","    AUDITOR.guard(\"v_representative_selection\", dev_df[[ID_COLUMN]])\n","    V_REPRESENTATIVES = select_cluster_representatives(dev_df, CLUSTER_STABILITY)\n","    AUDITOR.register_fit(\"v_representative_selection\", \"feature_selection\",\n","                         dev_df[ID_COLUMN].to_numpy(), DEV_BLOCKS)\n","\n","    V_SUMMARY = (CLUSTER_STABILITY\n","                 .merge(V_REPRESENTATIVES[[\"feature\", \"cluster_size\",\n","                                           \"mutual_information_dev\", \"is_representative\",\n","                                           \"selection_reason\"]],\n","                        on=\"feature\", how=\"left\")\n","                 .merge(feature_risk[[\"feature\", \"PSI_max_development_only\", \"verdict\"]]\n","                        .rename(columns={\"verdict\": \"temporal_verdict\"}),\n","                        on=\"feature\", how=\"left\"))\n","    V_SUMMARY[\"development_missing_rate\"] = V_SUMMARY[\"feature\"].map(_v_missing_dev)\n","    V_SUMMARY[\"stable_cluster\"] = V_SUMMARY[\"cluster_stability\"] >= CONFIG[\"CLUSTER_STABILITY_THRESHOLD\"]\n","    V_SUMMARY[\"final_action\"] = np.where(\n","        ~V_SUMMARY[\"stable_cluster\"].fillna(False), \"monitor\",\n","        np.where(V_SUMMARY[\"is_representative\"].fillna(False), \"keep\", \"tag_not_drop\"))\n","\n","    _multi = V_SUMMARY[V_SUMMARY.cluster_size.fillna(1) > 1]\n","    print(f\"\\nUsable V columns: {len(V_USABLE)} (excluded as too sparse: {len(V_TOO_SPARSE)}).\")\n","    print(f\"Clusters judged stable across all {len(DEV_BLOCKS)} development blocks \"\n","          f\"(co-membership >= {CONFIG['CLUSTER_STABILITY_THRESHOLD']}): \"\n","          f\"{int(V_SUMMARY.loc[V_SUMMARY.stable_cluster.fillna(False), 'cluster_id'].nunique())}.\")\n","    print(f\"Columns inside a stable multi-member cluster: {len(_multi)}; \"\n","          f\"representatives kept: {int(V_SUMMARY.is_representative.fillna(False).sum())}.\")\n","    print(\"\\nLargest stable clusters:\")\n","    print(_multi.sort_values([\"cluster_size\", \"cluster_id\", \"feature\"], ascending=[False, True, True])\n","          .head(15)[[\"cluster_id\", \"feature\", \"cluster_size\", \"cluster_stability\",\n","                     \"mutual_information_dev\", \"development_missing_rate\",\n","                     \"is_representative\", \"final_action\"]].to_string(index=False))\n","    print(\"\\nNo dimensionality reduction is FITTED here. Redundancy is a diagnosis; \"\n","          \"any reducer must be refitted inside each training fold to stay leakage-safe.\")\n","\n","    fig, ax = plt.subplots(figsize=(7, 3.4))\n","    ax.hist(CLUSTER_STABILITY.cluster_stability.dropna(), bins=20)\n","    ax.axvline(CONFIG[\"CLUSTER_STABILITY_THRESHOLD\"], color=\"crimson\", ls=\"--\",\n","               label=f\"stability threshold {CONFIG['CLUSTER_STABILITY_THRESHOLD']}\")\n","    ax.set_xlabel(\"cross-block co-membership rate\")\n","    ax.set_ylabel(\"V features\")\n","    ax.set_title(\"How reproducible is each V-series redundancy grouping across \"\n","                 \"development blocks?\")\n","    ax.legend(fontsize=8)\n","    plt.tight_layout()\n","    plt.show()\n","else:\n","    V_USABLE, V_TOO_SPARSE, CLUSTER_MAPS = [], [], {}\n","    CLUSTER_STABILITY = pd.DataFrame(columns=[\"feature\", \"cluster_id\", \"cluster_stability\"])\n","    V_REPRESENTATIVES = pd.DataFrame(columns=[\"feature\", \"is_representative\"])\n","    V_SUMMARY = pd.DataFrame(columns=[\"feature\", \"cluster_id\", \"final_action\"])\n","    LOG.warning(\"No V-series columns: Section 7 is recorded as NOT COMPUTED.\")"]},{"cell_type":"markdown","id":"e94444f1","metadata":{"_cell_guid":"a85b7cfd-2581-4035-a2d5-61698a8a84c6","_uuid":"7ddad2e1-86b0-4518-b0a0-b6a30cbc8bee","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.017167,"end_time":"2026-09-29T09:25:17.988108+00:00","exception":false,"start_time":"2026-09-29T09:25:17.970941+00:00","status":"completed"},"tags":[]},"source":["### Interpreting Section 7\n","\n","The source notebook grouped V columns **once**, on a pooled development sample,\n","with Pearson correlation and union-find. Two problems: transitive union-find\n","chains features that are not mutually correlated, and a single pooled estimate\n","cannot distinguish a structural redundancy from one that happens to hold in a\n","particular stretch of time.\n","\n","Measuring co-membership across blocks answers a sharper question: *would this\n","grouping still exist if I had looked at a different period?* Only groups that\n","survive that test earn a representative. Everything else is returned to\n","`monitor`, which is an admission of uncertainty rather than a decision."]},{"cell_type":"markdown","id":"9068587d","metadata":{"_cell_guid":"cac8cd9b-c27f-48f4-a565-d367f30480ab","_uuid":"b0d4bab0-024b-4576-9cac-4469eb8364a0","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.016964,"end_time":"2026-09-29T09:25:18.022035+00:00","exception":false,"start_time":"2026-09-29T09:25:18.005071+00:00","status":"completed"},"tags":[]},"source":["## 8. Entity and Graph Readiness Analysis\n","\n","For each available candidate entity column — `card1`–`card6`, `addr1`, `addr2`,\n","`P_emaildomain`, `R_emaildomain`, `DeviceInfo`, `DeviceType` — the notebook\n","computes coverage, cardinality, singleton rate, frequency distribution,\n","persistence across blocks, the share of OOT values previously seen in\n","development, cold-start rate, warm/cold transaction counts, fraud prevalence for\n","each, the entity-degree distribution and fraud concentration by degree band.\n","\n","**Cold-start rate is defined twice, and the two are never conflated:**\n","\n","* *primary* — OOT rows whose non-missing entity value was unseen in development,\n","  divided by **OOT rows with a non-missing value for that field**;\n","* *secondary* — the same numerator divided by **all OOT rows**, which is smaller\n","  whenever the field is sparse.\n","\n","**Two things this section deliberately does not do.** It does not compose\n","`card1 + addr1 + (day − D)` (or any other combination) into a synthetic customer\n","identity — that linkage rule is undocumented for these anonymised columns and\n","unvalidated here. And it does not treat a shared identifier as evidence that two\n","transactions belong to the same person; a shared value is a shared *attribute*."]},{"cell_type":"code","execution_count":11,"id":"8c8ad43b","metadata":{"_cell_guid":"2a86dea1-0226-4b2b-babd-6253f2ccad8e","_uuid":"702fb51f-f538-489c-8c42-9ad57241b6df","collapsed":false,"execution":{"iopub.execute_input":"2026-09-29T09:25:18.059397Z","iopub.status.busy":"2026-09-29T09:25:18.058719Z","iopub.status.idle":"2026-09-29T09:25:21.211666Z","shell.execute_reply":"2026-09-29T09:25:21.210712Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":3.174662,"end_time":"2026-09-29T09:25:21.214814+00:00","exception":false,"start_time":"2026-09-29T09:25:18.040152+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["09:25:19 | INFO    | Wrote ./artifacts/entity_cold_start_summary.csv\n"]},{"name":"stdout","output_type":"stream","text":["       entity  coverage  cardinality  singleton_rate  persistence_mean_blocks  share_in_all_blocks  oot_rows_non_missing  cold_start_rows  cold_start_rate  cold_start_rate_all_oot_rows\n","   DeviceInfo    0.2107         1639          0.2550                   2.1818               0.2282                 19130              374           0.0196                        0.0032\n","   DeviceType    0.2490            2          0.0000                   4.0000               1.0000                 23172                0           0.0000                        0.0000\n","P_emaildomain    0.8442           59          0.0000                   4.0000               1.0000                 97238                0           0.0000                        0.0000\n","R_emaildomain    0.2405           60          0.0000                   3.8500               0.8833                 23671                0           0.0000                        0.0000\n","        addr1    0.8