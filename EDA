atistics. Entity cold-start classifications are explicitly marked\n","    decision_scope=oot_evaluation_only and must not be represented as development-only.\n","  * Association is not causation, and predictive lift is not an effect. A\n","    missingness indicator that separates fraud may be recording a failed join\n","    rather than customer behaviour; the ProductCD stratification in Section 6\n","    is what distinguishes the two, not the aggregate contrast.\n","  * Shared card, address, email-domain or device values are shared ATTRIBUTES.\n","    They do not establish that two transactions belong to one person, and no\n","    composite identity is built here.\n","\n","=== RECOMMENDATIONS FOR LATER MODELLING (not results) ===\n","  1. Forward-chaining folds with an embargo; random cross-validation must never\n","     be the primary estimate.\n","  2. Fit every encoder, scaler, imputer and reducer inside the training fold.\n","     The redundancy groups above say what COULD be reduced, not a fitted reducer.\n","  3. Report PR-AUC and recall at a fixed FPR per block, and separately for\n","     warm-start and cold-start entities; ROC-AUC alone is inadequate at ~3.5%\n","     prevalence.\n","  4. Treat 'tag_not_drop' features as carried-with-a-tag, and test their removal\n","     as an ablation rather than assuming it.\n"]},{"name":"stderr","output_type":"stream","text":["/tmp/ipykernel_16/1750737903.py:32: FutureWarning: Downcasting object dtype arrays on .fillna, .ffill, .bfill is deprecated and will change in a future version. Call result.infer_objects(copy=False) instead. To opt-in to the future behavior, set `pd.set_option('future.no_silent_downcasting', True)`\n","  int(v_summary.get(\"is_representative\", pd.Series(dtype=bool)).fillna(False).sum())\n"]}],"source":["\"\"\"Section 12 - consolidated findings, assembled from computed objects only.\"\"\"\n","\n","\n","def build_findings(feature_risk: pd.DataFrame, checks: pd.DataFrame,\n","                   sensitivity: pd.DataFrame, entity_summary: pd.DataFrame,\n","                   v_summary: pd.DataFrame, missing_tests: pd.DataFrame,\n","                   confounding: pd.DataFrame) -> Dict[str, Any]:\n","    \"\"\"Collect the headline counts. Every value is read back from a computed\n","    artifact; nothing here is typed in by hand.\"\"\"\n","    verdicts = feature_risk[\"verdict\"].value_counts().to_dict()\n","    findings: Dict[str, Any] = {\n","        \"leakage_checks_passed\": int(checks[\"passed\"].sum()) if len(checks) else 0,\n","        \"leakage_checks_failed\": int((~checks[\"passed\"]).sum()) if len(checks) else 0,\n","        \"failed_check_names\": checks.loc[~checks[\"passed\"], \"check\"].tolist() if len(checks) else [],\n","        \"features_assessed\": int(len(feature_risk)),\n","        \"verdict_counts\": {k: int(v) for k, v in verdicts.items()},\n","        \"severe_psi_features\": feature_risk.loc[\n","            feature_risk.PSI_band_development_only == \"severe_drift\", \"feature\"].tolist(),\n","        \"moderate_psi_features\": feature_risk.loc[\n","            feature_risk.PSI_band_development_only == \"moderate_drift\", \"feature\"].tolist(),\n","        \"unstable_missingness_patterns\": (\n","            confounding.loc[confounding.flag == \"sign_reverses_in_some_strata\",\n","                            \"pattern_lead\"].tolist() if len(confounding) else []),\n","        \"missingness_patterns_supported\": (\n","            int(missing_tests.keep_indicator.sum()) if len(missing_tests) else 0),\n","        \"missingness_patterns_tested\": (\n","            int(missing_tests.tested.sum()) if len(missing_tests) else 0),\n","        \"stable_v_clusters\": (\n","            int(v_summary.loc[v_summary.get(\"stable_cluster\", pd.Series(dtype=bool))\n","                              .fillna(False), \"cluster_id\"].nunique()) if len(v_summary) else 0),\n","        \"v_representatives_kept\": (\n","            int(v_summary.get(\"is_representative\", pd.Series(dtype=bool)).fillna(False).sum())\n","            if len(v_summary) else 0),\n","        \"entity_columns_assessed\": (entity_summary[\"entity\"].tolist()\n","                                    if len(entity_summary) else []),\n","        \"max_oot_cold_start_rate\": (\n","            float(entity_summary[\"cold_start_rate\"].max()) if len(entity_summary) else None),\n","        \"features_robust_to_block_count\": (\n","            int(sensitivity.drop_duplicates(\"feature\")[\"robust_to_block_count\"].sum())\n","            if len(sensitivity) else 0),\n","        \"features_sensitive_to_block_count\": (\n","            sensitivity.loc[~sensitivity.robust_to_block_count, \"feature\"].unique().tolist()\n","            if len(sensitivity) else []),\n","    }\n","    return findings\n","\n","\n","FINDINGS = build_findings(feature_risk, CHECKS, BLOCK_SENSITIVITY, ENTITY_SUMMARY,\n","                          V_SUMMARY, MISSINGNESS_TESTS, CONFOUNDING)\n","\n","print(\"=== OBSERVED EVIDENCE (computed in this run) ===\")\n","print(json.dumps(\n","    {k: (v if not isinstance(v, list) or len(v) <= 12 else v[:12] + [\"...\"])\n","     for k, v in FINDINGS.items()}, indent=2))\n","\n","print(\"\"\"\n","=== CONFIGURED DECISION RULES (chosen, not discovered) ===\n","  PSI bands            stable < {psi_mod}, moderate <= {psi_sev}, severe above\n","  KS multiplicity      Benjamini-Hochberg at alpha = {alpha}\n","  Temporal association Spearman, flag at |rho| >= {rho} (Section 10 shows the\n","                       empirical distribution this cut-off sits in)\n","  Lift stability       1 - coefficient of variation, \"stable\" at >= 0.75, and only\n","                       estimated with >= {minblocks} blocks and >= {minpos} positives\n","  Cluster redundancy   distance 1 - |Spearman| <= {cdist}, co-membership >= {cstab}\n","                       across development blocks\n","  Entity cold start    moderate at >= 5%, high at >= 20% of OOT rows with a value\n","\"\"\".format(psi_mod=CONFIG[\"PSI_MODERATE_THRESHOLD\"], psi_sev=CONFIG[\"PSI_SEVERE_THRESHOLD\"],\n","           alpha=CONFIG[\"KS_ALPHA\"], rho=CONFIG[\"SPEARMAN_RISK_THRESHOLD\"],\n","           minblocks=CONFIG[\"LIFT_STABILITY_MIN_BLOCKS\"], minpos=CONFIG[\"MIN_POSITIVES_FOR_LIFT\"],\n","           cdist=CONFIG[\"CLUSTER_DISTANCE_THRESHOLD\"], cstab=CONFIG[\"CLUSTER_STABILITY_THRESHOLD\"]))\n","\n","print(\"\"\"=== METHODOLOGICAL INTERPRETATION ===\n","  * Every fitted object above - bin edges, decile cut points, cluster maps,\n","    mutual-information scores, the correlation threshold, the seen-value sets -\n","    is registered in the leakage auditor with the blocks it was fitted on. The\n","    registry, printed in the run manifest, is the auditable form of the claim\n","    that OOT was quarantined.\n","  * OOT appears as an evaluation-only comparison sample and as the population\n","    whose cold-start exposure is measured. Development feature verdicts do not\n","    read OOT statistics. Entity cold-start classifications are explicitly marked\n","    decision_scope=oot_evaluation_only and must not be represented as development-only.\n","  * Association is not causation, and predictive lift is not an effect. A\n","    missingness indicator that separates fraud may be recording a failed join\n","    rather than customer behaviour; the ProductCD stratification in Section 6\n","    is what distinguishes the two, not the aggregate contrast.\n","  * Shared card, address, email-domain or device values are shared ATTRIBUTES.\n","    They do not establish that two transactions belong to one person, and no\n","    composite identity is built here.\n","\n","=== RECOMMENDATIONS FOR LATER MODELLING (not results) ===\n","  1. Forward-chaining folds with an embargo; random cross-validation must never\n","     be the primary estimate.\n","  2. Fit every encoder, scaler, imputer and reducer inside the training fold.\n","     The redundancy groups above say what COULD be reduced, not a fitted reducer.\n","  3. Report PR-AUC and recall at a fixed FPR per block, and separately for\n","     warm-start and cold-start entities; ROC-AUC alone is inadequate at ~3.5%\n","     prevalence.\n","  4. Treat 'tag_not_drop' features as carried-with-a-tag, and test their removal\n","     as an ablation rather than assuming it.\"\"\")"]},{"cell_type":"markdown","id":"1346c086","metadata":{"_cell_guid":"00161677-39e1-431e-b9f4-deb087984704","_uuid":"3f7b3517-ee95-479e-932c-a224a13aa235","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.020623,"end_time":"2026-09-29T09:36:06.540821+00:00","exception":false,"start_time":"2026-09-29T09:36:06.520198+00:00","status":"completed"},"tags":[]},"source":["## 13. Thesis Defence Notes\n","\n","Each note pairs a likely examiner criticism with the evidence this notebook now\n","produces, the limitation that remains, and what it implies for graph-tabular\n","fraud modelling.\n","\n","**13.1 \"Your split leaks — you computed statistics before splitting.\"**\n","*Evidence now produced:* the split is derived before any statistic; every fitted\n","object registers its rows and blocks in `LeakageAuditor` and is exported in\n","`run_manifest.json`; `guard()` raises at the call site if a quarantined\n","identifier reaches a fit, selection, threshold or clustering call; the quarantine\n","assertions run as pass/fail invariants.\n","*Remaining limitation:* the guard proves that OOT rows did not enter a *tracked*\n","call. It cannot detect leakage through analyst knowledge — a threshold chosen\n","because an earlier run's OOT result was disappointing. Only the fixed-before-\n","results discipline and the versioned config snapshot address that.\n","*Implication:* a graph model must extend the same registry to edge construction,\n","degrees and community assignments, all of which leak topologically even when\n","labels are hidden.\n","\n","**13.2 \"Your drift threshold is arbitrary.\"**\n","*Evidence now produced:* Spearman replaces an unsourced Pearson rule; Section 10\n","shows the full distribution of `|ρ|` and derives a quantile-based alternative;\n","PSI and lift stability provide two independent views; every band is configurable\n","and snapshotted into each decision.\n","*Remaining limitation:* the band boundaries (0.10 / 0.25) remain conventions.\n","They are labelled as configured decision rules everywhere they appear, but they\n","are not derived from a loss function.\n","*Implication:* the defensible version of \"this feature drifts\" is a cost\n","statement — how much performance is lost by keeping it — which requires a model\n","and therefore belongs to the next stage.\n","\n","**13.3 \"A significant KS test does not mean the drift matters.\"**\n","*Evidence now produced:* KS reports statistic, both sample sizes, raw and\n","BH-adjusted p-values; the interpretation text states that at these sample sizes\n","significance is near-automatic; verdicts require PSI or lift evidence, never a\n","p-value alone.\n","*Remaining limitation:* no minimum practically-important KS statistic is\n","specified, because none can be justified without downstream cost information.\n","*Implication:* drift monitoring in production should trigger on effect size and\n","on realised performance, not on test significance.\n","\n","**13.4 \"Missingness looks predictive because of product mix.\"**\n","*Evidence now produced:* patterns collapsed before testing (one test per\n","underlying signal); ProductCD stratification with per-stratum sample and positive\n","counts; an explicit sign-reversal flag; a direction-consistency requirement\n","across development blocks; BH correction.\n","*Remaining limitation:* ProductCD is one stratifier. Device, issuer and channel\n","could confound in the same way and are not adjusted for; no multivariate\n","adjustment is attempted.\n","*Implication:* missingness indicators should enter a graph-tabular model as\n","node/edge *attributes* carrying their provenance, not as free-standing\n","predictors, so their product dependence stays visible.\n","\n","**13.5 \"Your V-series groups are an artefact of one sample.\"**\n","*Evidence now produced:* per-block clustering, cross-block co-membership,\n","retention only above a configured stability threshold, representatives chosen by\n","development mutual information with deterministic tie-breaking and a recorded\n","reason; the sampling approximation is labelled per block.\n","*Remaining limitation:* the distance threshold and the stability threshold are\n","both conventions, and correlation-based redundancy ignores interactions — two\n","weakly correlated columns can still be jointly redundant.\n","*Implication:* redundancy findings are inputs to an ablation, not a licence to\n","delete columns before a baseline exists.\n","\n","**13.6 \"You are treating shared identifiers as identities.\"**\n","*Evidence now produced:* no synthetic customer key is constructed; entity\n","statistics are reported per column with explicit denominators; the text states\n","that anonymised card/address/email/device values are shared attributes, not\n","verified persons; degree analysis is bipartite transaction-to-value.\n","*Remaining limitation:* without ground-truth linkage, entity resolution quality\n","is unknown, and both false merges and false splits are possible in any downstream\n","graph.\n","*Implication:* every graph result must be reported against a stated linkage rule,\n","and a shuffled-edge ablation is required before any relational lift is believed.\n","\n","**13.7 \"The 5-block split drives your conclusions.\"**\n","*Evidence now produced:* the full diagnostic recomputation at 4, 5, 6 and 8\n","blocks with per-configuration re-learning, verdict-change tracking and an\n","exported summary; features whose verdicts move are demoted and named.\n","*Remaining limitation:* all configurations use equal-row-count blocks on one\n","dataset over one ~6-month window; equal-duration blocks and other datasets are\n","untested.\n","*Implication:* forward-validation window design should be treated as a reported\n","sensitivity, not a fixed hyperparameter.\n","\n","**13.8 \"You report no model performance.\"**\n","*Evidence now produced:* the evaluation function is defined, documented,\n","denominator-explicit and unit-tested on synthetic data; no metric is invented for\n","a model that does not exist.\n","*Remaining limitation:* the audit's practical importance is therefore unquantified\n","— it constrains modelling without demonstrating a performance benefit.\n","*Implication:* the first modelling deliverable should be a tabular baseline under\n","these constraints, with the graph ladder attempted only after entity-history\n","features demonstrate lift.\n","\n","**13.9 \"Generalizability.\"**\n","This is one competition dataset, anonymised, covering a single ~6-month relative\n","window from one payment population. Nothing here establishes that the same\n","features drift, the same fields are informative when blank, or the same\n","cold-start rates hold anywhere else. The transferable content is the protocol and\n","the tooling, not the feature verdicts."]},{"cell_type":"markdown","id":"75c2139f","metadata":{"_cell_guid":"a269f552-ca46-40dc-b13b-dbd197aab589","_uuid":"271d5900-7b80-4507-b781-d19a3981619b","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.020618,"end_time":"2026-09-29T09:36:06.5823+00:00","exception":false,"start_time":"2026-09-29T09:36:06.561682+00:00","status":"completed"},"tags":[]},"source":["## 14. Function Validation — unit-style checks on synthetic data\n","\n","These verify the helper functions' documented behaviour, including that the\n","guards **fail** when they should. Synthetic data only: nothing here is evidence\n","about IEEE-CIS."]},{"cell_type":"markdown","id":"49e8e18b","metadata":{"_cell_guid":"4324c6da-62cf-49ad-b479-ec0b0501f4e7","_uuid":"69825221-03df-4140-ad96-1f190256d658","collapsed":false,"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.021363,"end_time":"2026-09-29T09:36:06.625722+00:00","exception":false,"start_time":"2026-09-29T09:36:06.604359+00:00","status":"completed"},"tags":[]},"source":["## 15. Run Manifest and Artifact Export\n","\n","`export_run_artifacts` writes `run_manifest.json` and verifies every declared\n","artifact exists on disk — a silent write failure cannot be reported as success.\n","The manifest carries the configuration, the environment, the data hash, the full\n","fitted-object registry with the blocks each object was fitted on, the leakage\n","checks, the synthetic checks and a byte-level hash of every file written."]},{"cell_type":"code","execution_count":16,"id":"cac74625","metadata":{"_cell_guid":"4ffa20d8-5fff-41c9-8a79-968fd6855c5e","_uuid":"0ecf1fa9-b305-4628-bbd6-e1da5cf256b2","collapsed":false,"execution":{"iopub.execute_input":"2026-09-29T09:36:06.669883Z","iopub.status.busy":"2026-09-29T09:36:06.669251Z","iopub.status.idle":"2026-09-29T09:36:06.872659Z","shell.execute_reply":"2026-09-29T09:36:06.871714Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.227792,"end_time":"2026-09-29T09:36:06.874552+00:00","exception":false,"start_time":"2026-09-29T09:36:06.64676+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stderr","output_type":"stream","text":["09:36:06 | INFO    | CHECK oot_strictly_after_dev                     PASS dev max 48000 < oot min 48100\n","09:36:06 | INFO    | CHECK row_identifiers_disjoint                   PASS 480 dev ids, 120 oot ids, 0 shared\n","09:36:06 | INFO    | CHECK blocks_mutually_exclusive                  PASS dev [1, 2, 3, 4] / oot [5]\n","09:36:06 | INFO    | CHECK blocks_ordered_in_time                     PASS each block ends no later than the next block starts\n","09:36:06 | INFO    | CHECK target_leakage_columns_excluded            PASS none present\n"]},{"name":"stdout","output_type":"stream","text":["                                              check  passed                                                                                                 detail\n","               psi_zero_for_identical_distributions    True                                                                                          psi=0.000e+00\n","                        psi_increases_under_a_shift    True                                                                     identical=0.0000 vs shifted=0.9224\n","               psi_bins_learned_from_reference_only    True                                              supplying reference-learned edges reproduces the same PSI\n","                      psi_is_monotone_in_shift_size    True                                                                                        0.0222 < 0.9224\n","                    psi_missing_bin_registers_drift    True                                             a feature that becomes 50% missing must not read as stable\n","                    blocks_are_ordered_and_disjoint    True                                                       each synthetic block ends before the next begins\n","                  oot_overlap_triggers_an_assertion    True                                 passing the full frame as 'development' must fail the quarantine check\n","                     auditor_guard_rejects_oot_rows    True                                         guard() must refuse a frame containing quarantined identifiers\n","               registering_a_fit_on_oot_is_rejected    True                                             register_fit() must refuse a declared fit on the OOT block\n","                cold_start_rate_primary_denominator    True                                                                                  expected 0.5, got 0.5\n","               cold_start_rate_all_rows_denominator    True                                                                                  expected 0.4, got 0.4\n","                   cold_start_counts_are_consistent    True                                                      warm + cold must exhaust the non-missing OOT rows\n","    representative_test_has_assessable_cluster_maps    True each development block must contain enough observations for both features; configured minimum is 1,000\n","           perfectly_correlated_features_co_cluster    True                          distance 1 - |Spearman| should be approximately zero for a monotone transform\n","representative_selection_returns_one_representative    True                               the stable two-feature cluster should produce exactly one representative\n","        representative_selection_ignores_oot_target    True                                 inverting every OOT label must not change a development-only selection\n","           top_decile_lift_detects_a_perfect_signal    True                                                                     lift=10.00 against a 10% base rate\n","                      lift_reports_its_denominators    True                                                 flagged count and positive count must both be returned\n","          lift_stability_is_one_for_identical_lifts    True                                                                                                       \n","   lift_stability_is_withheld_without_enough_blocks    True                                                                                                       \n","   recall_at_fixed_fpr_is_exact_on_a_separable_case    True                                                                   realised FPR 0.0101 on 990 negatives\n","       bh_adjusted_pvalues_are_not_smaller_than_raw    True                                                                                                       \n","                             bh_carries_nan_through    True                                  an unrunnable test must not be counted in the multiplicity correction\n","                 constant_feature_is_not_assessable    True                                                                                                       \n","              all_missing_feature_is_not_assessable    True                                                                                                       \n","                 empty_lift_input_is_not_assessable    True                                                                                                       \n","            evenly_spaced_sampling_respects_row_cap    True                                                                       expected 60,000 rows, got 60,000\n","             evenly_spaced_sampling_keeps_endpoints    True                                               deterministic sample should cover the full ordered block\n","  dataframe_hash_is_order_independent_after_sorting    True                                                                                                       \n","                        ledger_is_json_serialisable    True                                                                                                       \n","                      ledger_preserves_null_metrics    True                                                 a metric that was not computed must stay null, never 0\n","                      ledger_records_decision_scope    True                                                                                                       \n","                  ledger_rejects_an_unknown_verdict    True                                                                                                       \n","         ledger_requires_a_reason_for_every_verdict    True                                                                                                       \n","   schema_validation_names_missing_required_columns    True                                                                                                       \n","\n","35 / 35 synthetic checks passed.\n"]}],"source":["\"\"\"Section 14 - unit-style checks on small synthetic data.\n","\n","These run on synthetic frames only. They are not evidence about IEEE-CIS; they\n","verify that the helper functions behave as their docstrings claim, including the\n","guards that are supposed to fail.\n","\"\"\"\n","\n","\n","def _synthetic_frame(n: int = 600, seed: int = 0) -> pd.DataFrame:\n","    rng = np.random.RandomState(seed)\n","    return pd.DataFrame({\n","        ID_COLUMN: np.arange(1, n + 1),\n","        TIME_COLUMN: np.arange(1, n + 1) * 100,\n","        \"elapsed_days\": np.arange(1, n + 1) / 10.0,\n","        TARGET_COLUMN: rng.binomial(1, 0.1, n),\n","        \"feat\": rng.normal(size=n),\n","        \"entity\": rng.choice([f\"e{i}\" for i in range(20)], size=n),\n","    })\n","\n","\n","TEST_RESULTS: List[Dict[str, Any]] = []\n","\n","\n","def check(name: str, condition: bool, detail: str = \"\") -> None:\n","    TEST_RESULTS.append({\"check\": name, \"passed\": bool(condition), \"detail\": detail})\n","    if not condition:\n","        raise AssertionError(f\"Synthetic check failed: {name}. {detail}\")\n","\n","\n","rng = np.random.RandomState(RANDOM_SEED)\n","\n","# 1. PSI is ~0 for identical distributions and rises for a shifted one.\n","_base = rng.normal(size=20_000)\n","_same = calculate_psi(_base, _base.copy())[\"psi\"]\n","_shifted = calculate_psi(_base, _base + 1.0)[\"psi\"]\n","check(\"psi_zero_for_identical_distributions\", abs(_same) < 1e-9, f\"psi={_same:.3e}\")\n","check(\"psi_increases_under_a_shift\", _shifted > _same + 0.25,\n","      f\"identical={_same:.4f} vs shifted={_shifted:.4f}\")\n","check(\"psi_bins_learned_from_reference_only\",\n","      calculate_psi(_base, _base + 1.0, edges=learn_psi_bins(_base))[\"psi\"] == _shifted,\n","      \"supplying reference-learned edges reproduces the same PSI\")\n","\n","# 2. A moderate and a severe shift land in the configured bands in order.\n","_small = calculate_psi(_base, _base + 0.15)[\"psi\"]\n","check(\"psi_is_monotone_in_shift_size\", _small < _shifted, f\"{_small:.4f} < {_shifted:.4f}\")\n","\n","# 3. Missing values form their own bin.\n","_with_missing = pd.Series(np.concatenate([_base[:10_000], np.full(10_000, np.nan)]))\n","check(\"psi_missing_bin_registers_drift\",\n","      calculate_psi(pd.Series(_base), _with_missing)[\"psi\"] > 0.25,\n","      \"a feature that becomes 50% missing must not read as stable\")\n","\n","# 4. Temporal blocks are ordered, exhaustive and mutually exclusive.\n","_frame = _synthetic_frame()\n","_frame[\"chrono_block\"] = create_temporal_blocks(_frame, 5)\n","_bounds = _frame.groupby(\"chrono_block\")[TIME_COLUMN].agg([\"min\", \"max\"]).sort_index()\n","check(\"blocks_are_ordered_and_disjoint\",\n","      bool((_bounds[\"max\"].values[:-1] < _bounds[\"min\"].values[1:]).all())\n","      and _frame[\"chrono_block\"].nunique() == 5,\n","      \"each synthetic block ends before the next begins\")\n","\n","# 5. OOT overlap must TRIGGER the assertion, not pass quietly.\n","_dev = _frame[_frame.chrono_block < 5]\n","_oot = _frame[_frame.chrono_block == 5]\n","_auditor = LeakageAuditor(_oot[ID_COLUMN], [5])\n","assert_oot_quarantine(_dev, _oot, _auditor, predictors=[\"feat\"])\n","_overlap_detected = False\n","try:\n","    assert_oot_quarantine(_frame, _oot, LeakageAuditor(_oot[ID_COLUMN], [5]))\n","except AssertionError:\n","    _overlap_detected = True\n","check(\"oot_overlap_triggers_an_assertion\", _overlap_detected,\n","      \"passing the full frame as 'development' must fail the quarantine check\")\n","\n","_guard_detected = False\n","try:\n","    _auditor.guard(\"deliberate_violation\", _frame)\n","except AssertionError:\n","    _guard_detected = True\n","check(\"auditor_guard_rejects_oot_rows\", _guard_detected,\n","      \"guard() must refuse a frame containing quarantined identifiers\")\n","\n","_register_detected = False\n","try:\n","    _auditor.register_fit(\"deliberate_violation\", \"scaler\", _frame[ID_COLUMN].to_numpy(), [1, 5])\n","except AssertionError:\n","    _register_detected = True\n","check(\"registering_a_fit_on_oot_is_rejected\", _register_detected,\n","      \"register_fit() must refuse a declared fit on the OOT block\")\n","\n","# 6. Cold-start rate matches a hand-computed expectation on both denominators.\n","_cold_dev = pd.DataFrame({ID_COLUMN: range(1, 5), \"entity\": [\"a\", \"a\", \"b\", \"b\"],\n","                          TARGET_COLUMN: [0, 1, 0, 0]})\n","_cold_oot = pd.DataFrame({ID_COLUMN: range(5, 15),\n","                          \"entity\": [\"a\", \"b\", \"z\", \"z\", \"y\", None, None, \"a\", \"x\", \"b\"],\n","                          TARGET_COLUMN: [0, 0, 1, 1, 0, 1, 0, 0, 1, 0]})\n","_cold = calculate_cold_start_rate(_cold_dev, _cold_oot, \"entity\")\n","# 8 OOT rows carry a value; 4 of them (z, z, y, x) are unseen in dev.\n","check(\"cold_start_rate_primary_denominator\", abs(_cold[\"cold_start_rate\"] - 4 / 8) < 1e-12,\n","      f\"expected 0.5, got {_cold['cold_start_rate']}\")\n","check(\"cold_start_rate_all_rows_denominator\",\n","      abs(_cold[\"cold_start_rate_all_oot_rows\"] - 4 / 10) < 1e-12,\n","      f\"expected 0.4, got {_cold['cold_start_rate_all_oot_rows']}\")\n","check(\"cold_start_counts_are_consistent\",\n","      _cold[\"cold_start_rows\"] + _cold[\"warm_start_rows\"] == _cold[\"oot_rows_non_missing\"],\n","      \"warm + cold must exhaust the non-missing OOT rows\")\n","\n","# 7. Representative selection uses development target data only.\n","#\n","# The clustering function requires MIN_NON_MISSING observations for each\n","# feature in each block. Build enough rows so every development block meets\n","# that configured requirement.\n","_mi_rows = 5 * max(CONFIG[\"MIN_NON_MISSING\"], 1_200)\n","_mi_frame = _synthetic_frame(n=_mi_rows, seed=3)\n","_mi_frame[\"chrono_block\"] = create_temporal_blocks(_mi_frame, 5)\n","_mi_frame[\"a\"] = _mi_frame[\"feat\"]\n","_mi_frame[\"b\"] = _mi_frame[\"feat\"] * 2 + 1e-6\n","_mi_dev = _mi_frame.loc[_mi_frame[\"chrono_block\"] < 5].copy()\n","_mi_oot = _mi_frame.loc[_mi_frame[\"chrono_block\"] == 5].copy()\n","_maps = {\n","    block: cluster_v_features_by_block(\n","        _mi_dev,\n","        [\"a\", \"b\"],\n","        block=block,\n","    )[\"cluster_map\"]\n","    for block in [1, 2, 3, 4]\n","}\n","check(\n","    \"representative_test_has_assessable_cluster_maps\",\n","    all({\"a\", \"b\"}.issubset(cluster_map) for cluster_map in _maps.values()),\n","    (\n","        \"each development block must contain enough observations for both \"\n","        f\"features; configured minimum is {CONFIG['MIN_NON_MISSING']:,}\"\n","    ),\n",")\n","_stab = assess_cluster_stability(_maps, [\"a\", \"b\"])\n","_reps = select_cluster_representatives(\n","    _mi_dev,\n","    _stab,\n",")\n","check(\n","    \"perfectly_correlated_features_co_cluster\",\n","    all(\n","        cluster_map[\"a\"] == cluster_map[\"b\"]\n","        for cluster_map in _maps.values()\n","    ),\n","    \"distance 1 - |Spearman| should be approximately zero for a monotone transform\",\n",")\n","check(\n","    \"representative_selection_returns_one_representative\",\n","    (\n","        not _reps.empty\n","        and \"is_representative\" in _reps.columns\n","        and int(_reps[\"is_representative\"].sum()) == 1\n","    ),\n","    \"the stable two-feature cluster should produce exactly one representative\",\n",")\n","_representatives_before = (\n","    _reps.loc[_reps[\"is_representative\"], \"feature\"]\n","    .sort_values()\n","    .tolist()\n",")\n","\n","# Poison only the OOT labels. The development frame passed to representative\n","# selection remains unchanged.\n","_mi_oot[TARGET_COLUMN] = 1 - _mi_oot[TARGET_COLUMN]\n","_reps_poisoned = select_cluster_representatives(\n","    _mi_dev,\n","    _stab,\n",")\n","_representatives_after = (\n","    _reps_poisoned.loc[\n","        _reps_poisoned[\"is_representative\"],\n","        \"feature\",\n","    ]\n","    .sort_values()\n","    .tolist()\n",")\n","check(\n","    \"representative_selection_ignores_oot_target\",\n","    _representatives_before == _representatives_after,\n","    \"inverting every OOT label must not change a development-only selection\",\n",")\n","\n","# 8. Lift, lift stability and the fixed-FPR evaluator behave as documented.\n","_lift_frame = pd.DataFrame({\"x\": np.arange(1000.0), TARGET_COLUMN: (np.arange(1000) >= 900).astype(int)})\n","_lift = calculate_top_decile_lift(_lift_frame, \"x\", cut_point=900.0)\n","check(\"top_decile_lift_detects_a_perfect_signal\", _lift[\"lift\"] > 9,\n","      f\"lift={_lift['lift']:.2f} against a 10% base rate\")\n","check(\"lift_reports_its_denominators\",\n","      _lift[\"n_flagged\"] == 100 and _lift[\"positives_flagged\"] == 100,\n","      \"flagged count and positive count must both be returned\")\n","check(\"lift_stability_is_one_for_identical_lifts\",\n","      calculate_lift_stability({1: 2.0, 2: 2.0, 3: 2.0})[\"lift_stability\"] == 1.0)\n","check(\"lift_stability_is_withheld_without_enough_blocks\",\n","      calculate_lift_stability({1: 2.0})[\"verdict\"] == \"insufficient_evidence\")\n","_eval = recall_at_fixed_fpr([0] * 990 + [1] * 10, list(np.arange(990.0)) + [2000.0] * 10, fpr=0.01)\n","check(\"recall_at_fixed_fpr_is_exact_on_a_separable_case\", _eval[\"recall\"] == 1.0,\n","      f\"realised FPR {_eval['realised_fpr']:.4f} on {_eval['n_negatives']} negatives\")\n","\n","# 9. Multiplicity correction is monotone and never below the raw p-value.\n","_p = np.array([0.001, 0.01, 0.04, 0.2, np.nan])\n","_adj = adjust_multiple_tests(_p)\n","check(\"bh_adjusted_pvalues_are_not_smaller_than_raw\",\n","      bool((_adj.adjusted_pvalue.dropna().to_numpy()\n","            >= _p[np.isfinite(_p)] - 1e-12).all()))\n","check(\"bh_carries_nan_through\", bool(np.isnan(_adj.adjusted_pvalue.iloc[-1])),\n","      \"an unrunnable test must not be counted in the multiplicity correction\")\n","\n","# 10. Empty, constant and all-missing inputs degrade to \"not assessable\".\n","check(\"constant_feature_is_not_assessable\",\n","      not calculate_psi(np.ones(100), np.ones(100))[\"assessable\"])\n","check(\"all_missing_feature_is_not_assessable\",\n","      not calculate_psi([np.nan] * 100, [np.nan] * 100)[\"assessable\"])\n","check(\"empty_lift_input_is_not_assessable\",\n","      not calculate_top_decile_lift(\n","          pd.DataFrame({\"x\": [np.nan] * 5, TARGET_COLUMN: [0] * 5}), \"x\", 1.0)[\"assessable\"])\n","\n","# 11. Deterministic sampling respects the configured row cap.\n","_sample_source = pd.DataFrame({\"x\": np.arange(119_999)})\n","_sampled = evenly_spaced_sample(_sample_source, 60_000)\n","check(\"evenly_spaced_sampling_respects_row_cap\", len(_sampled) == 60_000,\n","      f\"expected 60,000 rows, got {len(_sampled):,}\")\n","check(\"evenly_spaced_sampling_keeps_endpoints\",\n","      int(_sampled.iloc[0, 0]) == 0 and int(_sampled.iloc[-1, 0]) == 119_998,\n","      \"deterministic sample should cover the full ordered block\")\n","\n","# 12. Hashing is deterministic and order-independent under the declared sort.\n","_h1 = compute_dataframe_hash(_frame, columns=[ID_COLUMN, TIME_COLUMN], sort_by=[TIME_COLUMN, ID_COLUMN])\n","_h2 = compute_dataframe_hash(_frame.sample(frac=1, random_state=7),\n","                             columns=[ID_COLUMN, TIME_COLUMN], sort_by=[TIME_COLUMN, ID_COLUMN])\n","check(\"dataframe_hash_is_order_independent_after_sorting\", _h1[\"sha256\"] == _h2[\"sha256\"])\n","\n","# 13. The ledger is JSON-serialisable with nulls preserved and contracts enforced.\n","_ledger = update_decisions_ledger({}, \"synthetic_feature\", \"other\",\n","                                  {\"psi_max\": 0.02, \"ks_stat\": None},\n","                                  \"stable\", \"synthetic check\", \"keep\",\n","                                  [\"14. Function Validation\"], {\"RANDOM_SEED\": RANDOM_SEED},\n","                                  \"deadbeef\", CONFIG[\"CODE_VERSION\"])\n","_round_trip = json.loads(json.dumps(_ledger, allow_nan=False))\n","check(\"ledger_is_json_serialisable\", _round_trip[\"synthetic_feature\"][\"verdict\"] == \"stable\")\n","check(\"ledger_preserves_null_metrics\",\n","      _round_trip[\"synthetic_feature\"][\"diagnostic_results\"][\"ks_stat\"] is None,\n","      \"a metric that was not computed must stay null, never 0\")\n","check(\"ledger_records_decision_scope\",\n","      _round_trip[\"synthetic_feature\"][\"decision_scope\"] == \"development_only\")\n","_rejected = False\n","try:\n","    update_decisions_ledger({}, \"f\", \"other\", {}, \"great\", \"\", \"keep\", [\"x\"], {}, \"h\", \"v\")\n","except ValueError:\n","    _rejected = True\n","check(\"ledger_rejects_an_unknown_verdict\", _rejected)\n","_rejected = False\n","try:\n","    update_decisions_ledger({}, \"f\", \"other\", {}, \"stable\", \"\", \"keep\", [\"x\"], {}, \"h\", \"v\")\n","except ValueError:\n","    _rejected = True\n","check(\"ledger_requires_a_reason_for_every_verdict\", _rejected)\n","\n","# 14. Schema validation fails loudly on a missing required column.\n","_rejected = False\n","try:\n","    validate_schema(pd.DataFrame({\"a\": [1]}), [\"a\", \"b\"], name=\"synthetic\")\n","except KeyError:\n","    _rejected = True\n","check(\"schema_validation_names_missing_required_columns\", _rejected)\n","\n","TEST_TABLE = pd.DataFrame(TEST_RESULTS)\n","print(TEST_TABLE.to_string(index=False))\n","print(f\"\\n{int(TEST_TABLE.passed.sum())} / {len(TEST_TABLE)} synthetic checks passed.\")"]},{"cell_type":"code","execution_count":17,"id":"21fdfe76","metadata":{"_cell_guid":"a3d5ecbe-af0b-4291-ac6b-667da20bc904","_uuid":"d2baecf3-f582-4bff-9883-c7d42f6fb51e","collapsed":false,"execution":{"iopub.execute_input":"2026-09-29T09:36:06.919185Z","iopub.status.busy":"2026-09-29T09:36:06.918747Z","iopub.status.idle":"2026-09-29T09:36:06.960033Z","shell.execute_reply":"2026-09-29T09:36:06.959033Z"},"jupyter":{"output