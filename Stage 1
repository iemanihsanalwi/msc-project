nt(f\"    Cohorts: first-seen AP {ap_new:.4f} | seen-before AP {ap_seen:.4f} \"\n","          f\"(first-seen share {first_seen_sub.mean():.1%})\")\n","    print(f\"    Entity overlap train->val: card {card_overlap:.1%} | device {device_overlap:.1%}\")\n","    print(f\"    Calibration: ECE {m_raw['ECE']:.5f} -> {m_cal['ECE']:.5f} | \"\n","          f\"ECE_q {m_raw['ECE_quantile']:.5f} -> {m_cal['ECE_quantile']:.5f} | \"\n","          f\"Brier {m_raw['Brier']:.5f} -> {m_cal['Brier']:.5f}\")\n","\n","results_df = pd.DataFrame(fold_results)\n","cohort_metrics_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage1_cohort_metrics.csv\")\n","pd.DataFrame(cohort_rows).to_csv(cohort_metrics_path, index=False)\n"]},{"cell_type":"code","execution_count":7,"id":"3d1cf3f3","metadata":{"_cell_guid":"504ddcf8-b019-4688-98b1-dea57959c9fe","_uuid":"8d8fdfe2-3cf1-4a9d-a375-ea6afa0a0921","collapsed":false,"execution":{"iopub.execute_input":"2026-09-30T04:22:45.41631Z","iopub.status.busy":"2026-09-30T04:22:45.415944Z","iopub.status.idle":"2026-09-30T04:22:45.445292Z","shell.execute_reply":"2026-09-30T04:22:45.444536Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.035486,"end_time":"2026-09-30T04:22:45.446917+00:00","exception":false,"start_time":"2026-09-30T04:22:45.411431+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[4] Auditing cross-fold feature-importance stability...\n","    Spearman rank correlation of gain importance across folds:\n","            gain_fold1  gain_fold2  gain_fold3\n","gain_fold1      1.0000      0.8800      0.8553\n","gain_fold2      0.8800      1.0000      0.9056\n","gain_fold3      0.8553      0.9056      1.0000\n","    Top-10 features by mean gain: V258, C13, C14, TransactionAmt, C1, D2, D15, V294, C12, V189\n","    Saved: ./artifacts/stage1_feature_importance.csv\n"]},{"name":"stderr","output_type":"stream","text":["/tmp/ipykernel_23/894181042.py:20: RuntimeWarning: 53 features have gain_cv > 1.0 across folds.\n","  warnings.warn(\n"]}],"source":["# ==============================================================================\n","# 6. Feature Importance Stability Audit\n","# ==============================================================================\n","print(\"\\n[4] Auditing cross-fold feature-importance stability...\")\n","importance_df = pd.concat(importance_frames, axis=1).fillna(0.0)\n","gain_cols = [c for c in importance_df.columns if c.startswith(\"gain_\")]\n","gain_ranks = importance_df[gain_cols].rank(ascending=False)\n","rank_corr = gain_ranks.corr(method=\"spearman\")\n","\n","importance_df[\"gain_mean\"] = importance_df[gain_cols].mean(axis=1)\n","importance_df[\"gain_cv\"] = (\n","    importance_df[gain_cols].std(axis=1) / importance_df[gain_cols].mean(axis=1).replace(0, np.nan)\n",")\n","importance_df = importance_df.sort_values(\"gain_mean\", ascending=False)\n","importance_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage1_feature_importance.csv\")\n","importance_df.to_csv(importance_path)\n","\n","unstable_features = importance_df.loc[importance_df[\"gain_cv\"] > 1.0].reset_index()\n","if not unstable_features.empty:\n","    warnings.warn(\n","        f\"{len(unstable_features)} features have gain_cv > 1.0 across folds.\",\n","        RuntimeWarning,\n","    )\n","unstable_features_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage1_unstable_features.csv\")\n","unstable_features.to_csv(unstable_features_path, index=False)\n","\n","print(\"    Spearman rank correlation of gain importance across folds:\")\n","print(rank_corr.round(4).to_string())\n","print(f\"    Top-10 features by mean gain: \"\n","      f\"{', '.join(importance_df.index[:10].tolist())}\")\n","print(f\"    Saved: {importance_path}\")"]},{"cell_type":"code","execution_count":8,"id":"77e56b54","metadata":{"_cell_guid":"709e05e9-abbc-448d-87ec-465561570340","_uuid":"edaeb35f-40b4-41ef-8b00-077d7825b18c","collapsed":false,"execution":{"iopub.execute_input":"2