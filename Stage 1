639 | Brier 0.02537 -> 0.02525\n","\n",">>> Fold 3: train [1, 2, 3] -> validate Block 4\n","    Fit rows: 283,459 | inner-stop rows: 70,865 | embargoed val rows: 115,420 (dropped 2,688 inside embargo)\n","    Boosting rounds selected on inner split: 179 (early stopping)\n","    AP 0.5330 | ROC-AUC 0.8887 | R@0.1%FPR 25.58%\n","    vs Random 0.0397 (delta +0.4933, 95% CI [0.4789, 0.5078], p_win 1.000)\n","    vs Amount 0.0477 (delta +0.4853, 95% CI [0.4708, 0.4995], p_win 1.000)\n","    Cohorts: first-seen AP 0.5669 | seen-before AP 0.5189 (first-seen share 31.0%)\n","    Entity overlap train->val: card 41.7% | device 92.1%\n","    Calibration: ECE 0.01029 -> 0.00378 | ECE_q 0.00965 -> 0.00243 | Brier 0.02515 -> 0.02497\n"]}],"source":["# ==============================================================================\n","# 5. PASS A - Expanding Chronological Forward Validation (reported metrics)\n","#    Embargo ON. These numbers are the thesis benchmark.\n","# ==============================================================================\n","folds = [\n","    ([1], 2),\n","    ([1, 2], 3),\n","    ([1, 2, 3], 4),\n","]\n","\n","fold_results: list[dict] = []\n","cohort_rows: list[dict] = []\n","fold_models: dict[int, dict] = {}\n","best_iterations: dict[int, int] = {}\n","importance_frames: list[pd.DataFrame] = []\n","\n","print(\"\\n\" + \"=\" * 80)\n","print(\"PASS A: EXPANDING CHRONOLOGICAL FORWARD VALIDATION (EMBARGOED EVALUATION)\")\n","print(\"=\" * 80)\n","\n","for fold_idx, (train_blocks, val_block) in enumerate(folds, 1):\n","    print(f\"\\n>>> Fold {fold_idx}: train {train_blocks} -> validate Block {val_block}\")\n","\n","    train_idx = df.index[df[\"chrono_block\"].isin(train_blocks)].to_numpy()\n","    train_max_dt = df.loc[train_idx, CONFIG[\"TIME_COLUMN\"]].max()\n","\n","    val_all_idx = df.index[df[\"chrono_block\"] == val_block].to_numpy()\n","    val_idx = df.index[\n","        (df[\"chrono_block\"] == val_block)\n","        & (df[CONFIG[\"TIME_COLUMN\"]] >= train_max_dt + CONFIG[\"EMBARGO_SECONDS\"])\n","    ].to_numpy()\n","\n","    assert not (set(train_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row entered training.\"\n","    assert_causal(df, train_idx, val_idx, f\"fold{fold_idx}\")\n","\n","    fallback = rounds_from_history(best_iterations, CONFIG[\"FINAL_ROUNDS_RULE\"])\n","    model, best_iter, fit_idx, stop_idx, used_es = train_causal_model(\n","        df, train_idx, features_clean, f\"fold{fold_idx}\", fallback\n","    )\n","    best_iterations[fold_idx] = best_iter\n","    print(f\"    Fit rows: {len(fit_idx):,} | inner-stop rows: {len(stop_idx):,} \"\n","          f\"| embargoed val rows: {len(val_idx):,} \"\n","          f\"(dropped {len(val_all_idx) - len(val_idx):,} inside embargo)\")\n","    print(f\"    Boosting rounds selected on inner split: {best_iter} \"\n","          f\"({'early stopping' if used_es else 'fixed fallback'})\")\n","\n","    calibrator = fit_calibrator(model, df, stop_idx, features_clean, best_iter)\n","\n","    X_val = df.loc[val_idx, features_clean]\n","    y_val = df.loc[val_idx, CONFIG[\"TARGET_COLUMN\"]].values\n","    val_amounts = df.loc[val_idx, CONFIG[\"AMOUNT_COLUMN\"]].values\n","\n","    val_raw = model.predict(X_val, num_iteration=best_iter).astype(np.float32)\n","    val_cal = apply_calibrator(calibrator, val_raw)\n","\n","    fold_models[fold_idx] = {\n","        \"model\": model,\n","        \"best_iter\": best_iter,\n","        \"calibrator\": calibrator,\n","        \"train_idx\": train_idx,\n","        \"val_block\": val_block,\n","    }\n","\n","    m_raw = compute_metrics(y_val, val_raw, val_amounts)\n","    m_cal = compute_metrics(y_val, val_cal, val_amounts)\n","\n","    # --- Reference rungs ---\n","    rng = np.random.default_rng(CONFIG[\"SEED\"] + fold_idx)\n","    rand_probs = rng.random(len(y_val))\n","    norm_amounts = val_amounts / max(val_amounts.max(), 1.0)\n","    m_rand = compute_metrics(y_val, rand_probs, val_amounts)\n","    m_amt = compute_metrics(y_val, norm_amounts, val_amounts)\n","\n","    boot_rand = bootstrap_ap_delta(y_val, val_raw, rand_probs)\n","    boot_amt = bootstrap_ap_delta(y_val, val_raw, norm_amounts)\n","\n","    # --- Entity cohort stratification ---\n","    first_seen_sub = df.loc[val_idx, \"card_first_seen\"].to_numpy()\n","    ap_new = (average_precision_score(y_val[first_seen_sub], val_raw[first_seen_sub])\n","              if y_val[first_seen_sub].sum() > 0 else np.nan)\n","    ap_seen = (average_precision_score(y_val[~first_seen_sub], val_raw[~first_seen_sub])\n","               if y_val[~first_seen_sub].sum() > 0 else np.nan)\n","\n","    # --- Entity overlap audit (contextualises the AP figure) ---\n","    card_overlap = entity_overlap_rate(df, train_idx, val_idx, \"uid_card\")\n","    device_overlap = entity_overlap_rate(df, train_idx, val_idx, \"uid_device\")\n","\n","    # --- Importance capture ---\n","    imp = pd.DataFrame({\n","        \"feature\": model.feature_name(),\n","        f\"gain_fold{fold_idx}\": model.feature_importance(\"gain\"),\n","        f\"split_fold{fold_idx}\": model.feature_importance(\"split\"),\n","    }).set_index(\"feature\")\n","    importance_frames.append(imp)\n","\n","    record = {\n","        \"fold\": fold_idx,\n","        \"train_blocks\": str(train_blocks),\n","        \"val_block\": val_block,\n","        \"n_fit\": int(len(fit_idx)),\n","        \"n_stop\": int(len(stop_idx)),\n","        \"n_val\": int(len(val_idx)),\n","        \"n_val_embargoed_out\": int(len(val_all_idx) - len(val_idx)),\n","        \"best_iter\": best_iter,\n","        \"early_stopped\": bool(used_es),\n","        \"val_fraud_rate\": float(y_val.mean()),\n","        \"AP_random\": m_rand[\"AP\"],\n","        \"AP_amount_only\": m_amt[\"AP\"],\n","        \"delta_AP_vs_rand\": boot_rand[\"delta\"],\n","        \"ci_low_rand\": boot_rand[\"ci_low\"],\n","        \"ci_high_rand\": boot_rand[\"ci_high\"],\n","        \"p_win_rand\": boot_rand[\"p_win\"],\n"," 