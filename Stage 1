======\n","print(\"\\n[5] Generating Stage-1 scores for every block (feature-generation pass)...\")\n","\n","oof_raw = np.full(len(df), np.nan, dtype=np.float32)\n","oof_cal = np.full(len(df), np.nan, dtype=np.float32)\n","oof_source = np.full(len(df), \"none\", dtype=object)\n","\n","fallback_rounds = rounds_from_history(best_iterations, CONFIG[\"FINAL_ROUNDS_RULE\"])\n","print(f\"    Fallback boosting rounds ({CONFIG['FINAL_ROUNDS_RULE']} of \"\n","      f\"{list(best_iterations.values())}): {fallback_rounds}\")\n","\n","# --- 7a. Block 1 via expanding chronological sub-folds ---\n","k = CONFIG[\"B1_SUBFOLDS\"]\n","b1_idx = df.index[df[\"chrono_block\"] == 1].to_numpy()\n","slices = np.array_split(b1_idx, k)\n","print(f\"    Block 1: expanding sub-fold scheme with K={k} \"\n","      f\"(slice sizes {[len(s) for s in slices]})\")\n","\n","for s in range(1, k):\n","    sub_train = np.concatenate(slices[:s])\n","    sub_score = slices[s]\n","    assert_causal(df, sub_train, sub_score, f\"b1_subfold{s}\")\n","\n","    sub_model, sub_iter, _, sub_stop, sub_es = train_causal_model(\n","        df, sub_train, features_clean, f\"b1_subfold{s}\", fallback_rounds\n","    )\n","    sub_cal = fit_calibrator(sub_model, df, sub_stop, features_clean, sub_iter)\n","    p_raw = sub_model.predict(df.loc[sub_score, features_clean],\n","                              num_iteration=sub_iter).astype(np.float32)\n","    oof_raw[sub_score] = p_raw\n","    oof_cal[sub_score] = apply_calibrator(sub_cal, p_raw)\n","    oof_source[sub_score] = f\"b1_subfold_{s}\"\n","    print(f\"      sub-fold {s}: train {len(sub_train):,} -> score {len(sub_score):,} \"\n","          f\"| rounds {sub_iter} ({'ES' if sub_es else 'fixed'})\")\n","\n","oof_source[slices[0]] = \"b1_seed_unscored\"\n","print(f\"      slice 0 ({len(slices[0]):,} rows) intentionally unscored - \"\n","      f\"no prior data exists. Flagged, not silently NaN.\")\n","\n","# --- 7b. Blocks 2-4 via the fold models, scoring the FULL block (embargo off) ---\n","for fold_idx, meta in fold_models.items():\n","    vb = meta[\"val_block\"]\n","    score_idx = df.index[df[\"chrono_block\"] == vb].to_numpy()\n","    assert_causal(df, meta[\"train_idx\"], score_idx, f\"featpass_block{vb}\")\n","    p_raw = meta[\"model\"].predict(df.loc[score_idx, features_clean],\n","                                  num_iteration=meta[\"best_iter\"]).astype(np.float32)\n","    oof_raw[score_idx] = p_raw\n","    oof_cal[score_idx] = apply_calibrator(meta[\"calibrator\"], p_raw)\n","    oof_source[score_idx] = f\"forward_fold_{fold_idx}\"\n","    print(f\"    Block {vb}: scored {len(score_idx):,} rows with the Fold-{fold_idx} model \"\n","          f\"(trained strictly on earlier blocks).\")\n","\n","# --- 7c. Block 5 (sealed OOT) via a frozen model fit on Blocks 1-4 ---\n","# This is deployment, not leakage: the OOT *features* are scored, the OOT\n","# *target* is never read here. Without this the Stage-2 model has no Stage-1\n","# input for the holdout and the OOT evaluation is impossible.\n","print(\"    Block 5 (sealed OOT): fitting frozen production model on Blocks 1-4...\")\n","dev_idx = df.index[df[\"chrono_block\"].isin(CONFIG[\"DEV_BLOCKS\"])].to_numpy()\n","oot_idx = df.index[df[\"chrono_block\"] == CONFIG[\"OOT_BLOCK\"]].to_numpy()\n","assert not (set(dev_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row inside development training index.\"\n","assert_causal(df, dev_idx, oot_idx, \"frozen_oot\")\n","\n","final_model, final_iter, final_fit_idx, final_stop_idx, final_es = train_causal_model(\n","    df, dev_idx, features_clean, \"frozen_oot\", fallback_rounds\n",")\n","final_calibrator = fit_calibrator(final_model, df, final_stop_idx, features_clean, final_iter)\n","p_oot_raw = final_model.predict(df.loc[oot_idx, features_clean],\n","                                num_iteration=final_iter).astype(np.float32)\n","oof_raw[oot_idx] = p_oot_raw\n","oof_cal[oot_idx] = apply_calibrator(final_calibrator, p_oot_raw)\n","oof_source[oot_idx] = \"frozen_oot_model\"\n","print(f\"      Frozen model: fit {len(final_fit_idx):,} rows | rounds {final_iter} \"\n","      f\"({'ES' if final_es else 'fixed'}) | scored {len(oot_idx):,} OOT rows.\")\n","print(\"      OOT target NOT read. No OOT metric is computed in Stage 1.\")\n","\n","model_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage1_frozen_model.txt\")\n","final_model.save_model(model_path, num_iteration=final_iter)"]},{"cell_type":"code","execution_count":9,"id":"771227a5","metadata":{"_cell_guid":"087ff61d-3f74-423d-a018-a76cfd0a8bf5","_uuid":"93f0864d-d3ce-4f7a-a1fa-51bcc7dc8d04","collapsed":false,"execution":{"iopub.execute_input":"2026-09-30T04:24:42.852948Z","iopub.status.busy":"2026-09-30T04:24:42.85272Z","iopub.status.idle":"2026-09-30T04:24:45.79293Z","shell.execute_reply":"2026-09-30T04:24:45.791639Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":2.947142,"end_time":"2026-09-30T04:24:45.795278+00:00","exception":false,"start_time":"2026-09-30T04:24:42.848136+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[6] Missingness policy: 29,527 unscored rows filled with seed-slice prior 0.02879 and flagged.\n","    Saved: ./artifacts/stage1_oof_predictions.csv\n","    Stage-1 score coverage by block:\n","      Block 1: 75.0%\n","      Block 2: 100.0%\n","      Block 3: 100.0%\n","      Block 4: 100.0%\n","      Block 5: 100.0% (Sealed OOT - frozen model)\n","    Coverage by generation source:\n","stage1_source\n","b1_seed_unscored     29527\n","b1_subfold_1         29527\n","b1_subfold_2         29527\n","b1_subfold_3         29527\n","forward_fold_1      118108\n","forward_fold_2      118108\n","forward_fold_3      118108\n","frozen_oot_model    118108\n","    Pooled development-block OOF AP (sanity, not the headline metric): 0.4703\n"]}],"source":["# ==============================================================================\n","# 8. Missingness Policy & OOF Manifest Export\n","# ==============================================================================\n","# Explicit policy: unscored rows (Block 1 seed slice only) are filled with the\n","# prevalence of the seed slice itself - a defensible prior - and flagged. Never\n","# fill with 0.0: that asserts \"certainly legitimate\", which is false and will\n","# distort any downstream graph aggregation.\n","missing_mask = np.isnan(oof_raw)\n","seed_prior = float(df.loc[slices[0], CONFIG[\"TARGET_COLUMN\"]].mean())\n","print(f\"\\n[6] Missingness policy: {missing_mask.sum():,} unscored rows \"\n","      f\"filled with seed-slice prior {seed_prior:.5f} and flagged.\")\n","\n","oof_df = pd.DataFrame({\n","    \"TransactionID\": df[CONFIG[\"ID_COLUMN\"]].values,\n","    \"chrono_block\": df[\"chrono_block\"].values,\n","    \"stage1_prob_raw\": oof_raw,\n","    \"stage1_prob_calibrated\": oof_cal if CONFIG[\"EXPORT_CALIBRATED_OOF\"] else np.nan,\n","    \"stage1_prob_filled\": np.where(missing_mask, seed_prior, oof_raw).astype(np.float32),\n","    \"stage1_available\": ~missing_mask,\n","    \"stage1_missing\": missing_mask,\n","    \"stage1_source\": oof_source,\n","})\n","\n","# Validate against the original Block-1 seed slice, never sealed OOT labels.\n","oof_prior_prevalence = float(df.loc[slices[0], CONFIG[\"TARGET_COLUMN\"]].mean())\n","oof_fill_validation = bool(np.isclose(\n","    oof_df.loc[missing_mask, \"stage1_prob_filled\"].to_numpy(),\n","    oof_prior_prevalence, atol=1e-6, rtol=0.0,\n",").all())\n","assert oof_fill_validation, \"Fatal: OOF missing-row fills differ from the seed-slice prior.\"\n","\n","oof_output_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage1_oof_predictions.csv\")\n","oof_df.to_csv(oof_output_path, index=False)\n","print(f\"    Saved: {oof_output_path}\")\n","\n","coverage = oof_df.groupby(\"chrono_block\")[\"stage1_available\"].mean()\n","print(\"    Stage-1 score coverage by block:\")\n","for blk, share in coverage.items():\n","    tag = \" 