,"block_profile = (\n","    df.groupby(\"chrono_block\")\n","      .agg(rows=(CONFIG[\"ID_COLUMN\"], \"size\"),\n","           fraud_rate=(CONFIG[\"TARGET_COLUMN\"], \"mean\"),\n","           first_day=(\"day_index\", \"min\"),\n","           last_day=(\"day_index\", \"max\"))\n",")\n","print(\"    Block profile (prevalence drift check):\")\n","print(block_profile.to_string())"]},{"cell_type":"code","execution_count":5,"id":"68d11f24","metadata":{"_cell_guid":"edc9bf4e-864d-46c9-bb58-031466cddfef","_uuid":"b812be9a-f197-459a-a4fa-6bf638d16302","collapsed":false,"execution":{"iopub.execute_input":"2026-09-30T04:19:28.518937Z","iopub.status.busy":"2026-09-30T04:19:28.518138Z","iopub.status.idle":"2026-09-30T04:19:28.587799Z","shell.execute_reply":"2026-09-30T04:19:28.586872Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.075434,"end_time":"2026-09-30T04:19:28.589266+00:00","exception":false,"start_time":"2026-09-30T04:19:28.513832+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[3] Ingesting feature-decision ledger and applying audit filters...\n","    Loaded decisions ledger: /kaggle/input/notebooks/iemanihsan/ieee-cis-eda-leakage-audit/artifacts/feature_risk_table.csv\n","    Features retained after audit screening: 371\n","    Categorical features cast for LightGBM: 0\n"]}],"source":["# ==============================================================================\n","# 4. Feature Ingestion & Leakage Quarantine\n","# ==============================================================================\n","print(\"[3] Ingesting feature-decision ledger and applying audit filters...\")\n","decision_file = resolve_first_existing(CONFIG[\"CANDIDATE_DECISION_PATHS\"])\n","print(f\"    Loaded decisions ledger: {decision_file}\")\n","decisions_df = pd.read_csv(decision_file)\n","\n","action_col = \"action\" if \"action\" in decisions_df.columns else \"verdict\"\n","drop_filter = decisions_df[action_col].astype(str).str.lower().str.startswith(\"drop\")\n","accepted_features = decisions_df.loc[~drop_filter, \"feature\"].tolist()\n","\n","features_clean = [\n","    col for col in accepted_features\n","    if col in df.columns\n","    and col not in TARGET_LEAKAGE_COLUMNS\n","    and col not in AUDIT_ONLY_COLUMNS\n","]\n","assert features_clean, \"Fatal: no features survived the audit filter.\"\n","assert CONFIG[\"TARGET_COLUMN\"] not in features_clean, \"Fatal: target present in feature matrix.\"\n","print(f\"    Features retained after audit screening: {len(features_clean)}\")\n","\n","feature_audit = decisions_df.reindex(columns=[\"feature\", \"verdict\", \"action\"]).rename(\n","    columns={\"verdict\": \"eda_verdict\", \"action\": \"eda_action\"}\n",")\n","unlisted_features = pd.DataFrame({\n","    \"feature\": [c for c in df.columns if c not in decisions_df[\"feature\"].values]\n","})\n","feature_audit = pd.concat([feature_audit, unlisted_features], ignore_index=True)\n","feature_audit[[\"eda_verdict\", \"eda_action\"]] = (\n","    feature_audit[[\"eda_verdict\", \"eda_action\"]].fillna(\"not_found\")\n",")\n","feature_audit[\"used_in_stage1\"] = feature_audit[\"feature\"].isin(features_clean)\n","feature_audit_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage1_feature_audit.csv\")\n","feature_audit.to_csv(feature_audit_path, index=False)\n","assert os.path.exists(feature_audit_path), \"Fatal: feature audit export missing.\"\n","\n","cat_cols = [c for c in features_clean\n","            if df[c].dtype == \"object\" or str(df[c].dtype) == \"category\"]\n","for c in cat_cols:\n","    df[c] = df[c].astype(\"category\")\n","print(f\"    Categorical features cast for LightGBM: {len(cat_cols)}\")"]},{"cell_type":"code","execution_count":6,"id":"522fe7c5","metadata":{"_cell_guid":"74d62503-219f-40ce-902d-5704a4b90022","_uuid":"3792e61a-a2c0-4b94-9329-4df22793096b","collapsed":false,"execution":{"iopub.execute_input":"2026-09-30T04:19:28.596457Z","iopub.status.busy":"2026-09-3