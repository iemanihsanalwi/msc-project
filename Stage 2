e > 0, running_sum / seen_before, amt_curr)\n        running_mean = np.nan_to_num(running_mean, nan=amt_curr).astype(np.float32)\n\n        out[f\"{key}_amt_running_mean\"] = running_mean\n        out[f\"{key}_amt_ratio\"] = (amt_curr / (running_mean + 1.0)).astype(np.float32)\n        out[f\"{key}_amt_diff\"] = (amt_curr - running_mean).astype(np.float32)\n\n    # 4. Card-anchored C-series running means (history only).\n    card_seen = out[f\"uid_card{suffix}_seen_before\"]\n    for c_col in [\"C1\", \"C2\", \"C13\", \"C14\"]:\n        if c_col in df_in.columns:\n            c_sum = (df_in.groupby(card_col, sort=False)[c_col].cumsum()\n                     - df_in[c_col]).to_numpy(dtype=np.float32)\n            with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n                c_mean = np.where(card_seen > 0, c_sum / card_seen, 0.0)\n            out[f\"uid_card{suffix}_{c_col}_running_mean\"] = np.nan_to_num(c_mean, nan=0.0).astype(np.float32)\n\n    # 5. Expanding counts for categorical proxies (dropna=False preserves missingness signal).\n    for cat in [\"card1\", \"card2\", \"addr1\", \"P_emaildomain\", \"R_emaildomain\"]:\n        if cat in df_in.columns:\n            out[f\"{cat}{suffix}_seen_before\"] = (\n                df_in.groupby(cat, sort=False, dropna=False).cumcount().to_numpy(dtype=np.float32)\n            )\n\n    return pd.DataFrame(out, index=df_in.index)\n\n\ndef audit_relational_causality(frame: pd.DataFrame, feat: pd.DataFrame,\n                               uid_col: str, key: str) -> None:\n    \"\"\"\n    Assert that history features are strictly backward-looking.\n\n    On an entity's FIRST appearance there is by construction no history, so\n    seen_before must be exactly 0 and dt_diff must be the -1 sentinel. Any\n    violation means future information has leaked backwards. v1 asserted none\n    of this.\n    \"\"\"\n    first = first_seen_flag(frame[uid_col])\n    sb = feat[f\"{key}_seen_before\"].to_numpy()\n    dt = feat[f\"{key}_dt_diff\"].to_numpy()\n\n    assert np.all(sb[first] == 0), (\n        f\"LEAKAGE [{key}]: first-seen rows carry non-zero history counts.\"\n    )\n    assert np.all(dt[first] == -1.0), (\n        f\"LEAKAGE [{key}]: first-seen rows carry a finite inter-arrival gap.\"\n    )\n    assert np.all(sb >= 0), f\"LEAKAGE [{key}]: negative history count.\"\n    print(f\"      causality audit [{key}]: PASSED \"\n          f\"({first.mean():.1%} first-seen, max history {sb.max():.0f})\")\n\n\nrel_features_df = build_relational_features(df, \"uid_card\", \"uid_device\")\naudit_relational_causality(df, rel_features_df, \"uid_card\", \"uid_card\")\naudit_relational_causality(df, rel_features_df, \"uid_device\", \"uid_device\")\nrel_features_df = reduce_memory(rel_features_df, \"relational\")\n\ndf = pd.concat([df, rel_features_df], axis=1)\nrelational_cols = list(rel_features_df.columns)\nstage2_features = base_features + relational_cols\ndel rel_features_df\ngc.collect()\n\nprint(f\"    Added {len(relational_cols)} relational features.\")\nprint(f\"    Stage 2 feature space: {len(stage2_features)} \"\n      f\"({len(base_features)} base + {len(relational_cols)} relational).\")\n\n# --- Shuffled-entity null control features (N1) ---\ncontrol_features: list[str] = []\nif CONFIG[\"RUN_SHUFFLE_CONTROL\"]:\n    print(\"    Building shuffled-entity null control (entity topology destroyed,\"\n          \" feature count preserved)...\")\n    rng = np.random.default_rng(CONFIG[\"SEED\"])\n    shuffled_df = pd.DataFrame({\n        \"TransactionDT\": df[\"TransactionDT\"],\n        \"TransactionAmt\": df[\"TransactionAmt\"],\n        \"uid_card_shuf\": rng.permutation(df[\"uid_card\"].values),\n        \"uid_device_shuf\": rng.permutation(df[\"uid_device\"].values),\n    }, index=df.index)\n\n    for c_col in [\"C1\", \"C2\", \"C13\", \"C14\"]:\n        if c_col in df.columns:\n            shuffled_df[c_col] = df[c_col]\n    for col in [\"card1\", \"card2\", \"addr1\", \"P_emaildomain\", \"R_emaildomain\"]:\n        if col in df.columns:\n            shuffled_df[col] = rng.permutation(df[col].values)\n\n    rel_shuf_df = build_relational_features(\n        shuffled_df, \"uid_card_shuf\", \"uid_device_shuf\", suffix=\"_shuf\"\n    )\n    rel_shuf_df = reduce_memory(rel_shuf_df, \"relational_shuffled\")\n    df = pd.concat([df, rel_shuf_df], axis=1)\n    control_features = base_features + list(rel_shuf_df.columns)\n    del shuffled_df, rel_shuf_df\n    gc.collect()\n    print(f\"    Control feature space: {len(control_features)} columns \"\n          \"(same cardinality as the real arm).\")\n\n# --- Categorical casting across every arm ---\nall_model_cols = sorted(set(stage2_features) | set(control_features) | set(relational_cols))\ncat_cols = [c for c in all_model_cols\n            if df[c].dtype == \"object\" or str(df[c].dtype) == \"category\"]\nfor c in cat_cols:\n    df[c] = df[c].astype(\"category\")\nprint(f\"    Categorical features cast for LightGBM: {len(cat_cols)}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-24T07:13:08.868075Z","iopub.execute_input":"2026-09-24T07:13:08.868366Z","iopub.status.idle":"2026-09-24T07:13:15.135076Z","shell.execute_reply.started":"2026-09-24T07:13:08.868339Z","shell.execute_reply":"2026-09-24T07:13:15.13421Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==============================================================================\n# 6. PASS A — Expanding Forward Validation (embargoed, reported metrics)\n# ==============================================================================\nfolds = [\n    ([1], 2),\n    ([1, 2], 3),\n    ([1, 2, 3], 4),\n]\n\n\ndef run_variant(feature_list: list[str], variant_name: str):\n    \"\"\"\n    Train and evaluate one experimental arm across expanding forward folds.\n\n    Pass A semantics: embargo ON, metrics reported. Returns per-fold records,\n    the fitted models (reused in Pass B), the round history and gain importance.\n    \"\"\"\n    fold_rows: list[dict] = []\n    models: dict[int, dict] = {}\n    iters: dict[int, int] = {}\n    importances: list[pd.DataFrame] = []\n\n    print(f\"\\n>>> Variant: {variant_name.upper()} ({len(feature_list)} features)\")\n\n    for fold_idx, (train_blocks, val_block) in enumerate(folds, 1):\n        train_idx = df.index[df[\"chrono_block\"].isin(train_blocks)].to_numpy()\n        train_max_dt = df.loc[train_idx, CONFIG[\"TIME_COLUMN\"]].max()\n\n        val_all_idx = df.index[df[\"chrono_block\"] == val_block].to_numpy()\n        val_idx = df.index[\n            (df[\"chrono_block\"] == val_block)\n            & (df[CONFIG[\"TIME_COLUMN\"]] >= train_max_dt + CONFIG[\"EMBARGO_SECONDS\"])\n        ].to_numpy()\n\n        assert not (set(train_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row entered training.\"\n        assert_causal(df, train_idx, val_idx, f\"{variant_name}_fold{fold_idx}\")\n\n        fallback = rounds_from_history(iters, CONFIG[\"FINAL_ROUNDS_RULE\"])\n        model, best_iter, fit_idx, stop_idx, used_es = train_causal_model(\n            df, train_idx, feature_list, f\"{variant_name}_fold{fold_idx}\", fallback\n        )\n        iters[fold_idx] = best_iter\n        calibrator = fit_calibrator(model, df, stop_idx, feature_list, best_iter)\n\n        X_val = df.loc[val_idx, feature_list]\n        y_val = df.loc[val_idx, CONFIG[\"TARGET_COLUMN\"]].values\n        val_amounts = df.loc[val_idx, CONFIG[\"AMOUNT_COLUMN\"]].values\n\n        val_raw = model.predict(X_val, num_iteration=best_iter).astype(np.float32)\n        val_cal = apply_calibrator(calibrator, val_raw)\n\n        models[fold_idx] = {\n            \"model\": model, \"best_iter\": best_iter, \"calibrator\": calibrator,\n            \"train_idx\": train_idx, \"val_block\": val_block,\n        }\n\n        m_raw = compute_metrics(y_val, val_raw, val_amounts)\n        m_cal = compute_metrics(y_val, val_cal, val_amounts)\n\n        first_seen_val = df.loc[val_idx, \"card_first_seen\"].to_numpy()\n        ap_new = (average_precision_score(y_val[first_seen_val], val_raw[first_seen_val])\n                  if y_val[first_seen_val].sum() > 0 else np.nan)\n        ap_seen = (average_precision_score(y_val[~first_seen_val], val_raw[~first_seen_val])\n                   if y_val[~first_seen_val].sum() > 0 else np.nan)\n\n        card_overlap = entity_overlap_rate(df, train_idx, val_idx, \"uid_card\")\n        device_overlap = entity_overlap_rate(df, train_idx, val_idx, \"uid_device\")\n\n        importances.append(pd.DataFrame({\n            \"feature\": model.feature_name(),\n            f\"gain_fold{fold_idx}\": model.feature_importance(\"gain\"),\n        }).set_index(\"feature\"))\n\n        fold_rows.append({\n            \"variant\": variant_name,\n            \"fold\": fold_idx,\n            \"train_blocks\": str(train_blocks),\n            \"val_block\": val_block,\n            \"n_features\": len(feature_list),\n            \"n_fit\": int(len(fit_idx)),\n            \"n_stop\": int(len(stop_idx)),\n            \"n_val\": int(len(val_idx)),\n            \"n_val_embargoed_out\": int(len(val_all_idx) - len(val_idx)),\n            \"best_iter\": best_iter,\n            \"early_stopped\": bool(used_es),\n            \"val_fraud_rate\": float(y_val.mean()),\n            \"AP_new_entity\": ap_new,\n            \"AP_seen_entity\": ap_seen,\n            \"first_seen_share\": float(first_seen_val.mean()),\n            \"card_overlap_rate\": card_overlap,\n            \"device_overlap_rate\": device_overlap,\n            \"AP_calibrated\": m_cal[\"AP\"],\n            \"ECE_calibrated\": m_cal[\"ECE\"],\n            \"ECE_quantile_calibrated\": m_cal[\"ECE_quantile\"],\n            \"Brier_calibrated\": m_cal[\"Brier\"],\n            \"Loss_cost_rule_calibrated\": m_cal[\"Loss_cost_rule\"],\n            \"AlertRate_calibrated\": m_cal[\"AlertRate\"],\n            **m_raw,\n        })\n\n        print(f\"    Fold {fold_idx} (val B{val_block}): AP {m_raw['AP']:.4f} | \"\n              f\"ROC-AUC {m_raw['ROC_AUC']:.4f} | R@0.1%FPR {m_raw['Recall@0.1%FPR']:.2%} | \"\n              f\"rounds {best_iter}{'' if used_es else ' (fixed)'}\")\n        print(f\"             cohorts: new {ap_new:.4f} / seen {ap_seen:.4f} \"\n              f\"| card overlap {card_overlap:.1%} | ECE_q {m_raw['ECE_quantile']:.5f} \"\n              f\"-> {m_cal['ECE_quantile']:.5f}\")\n\n    imp_df = pd.concat(importances, axis=1).fillna(0.0)\n    return pd.DataFrame(fold_rows), models, iters, imp_df\n\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"PASS A: EXPANDING CHRONOLOGICAL FORWARD VALIDATION (EMBARGOED EVALUATION)\")\nprint(\"=\" * 80)\n\nreal_results, real_models, real_iters, real_importance = run_variant(stage2_features, \"real\")\n\nif CONFIG[\"RUN_BASE_ONLY\"]:\n    print(\"\\n[5] Internal base-feature-only control — the valid paired comparator for H1.\")\n    print(\"    (Cross-stage comparison against a separate Stage 1 run confounds the\")\n    print(\"     feature set with run configuration; this arm does not.)\")\n    base_results, base_models, base_iters, base_importance = run_variant(base_features, \"base_only\")\nelse:\n    base_results, base_models, base_iters, base_importance = pd.DataFrame(), {}, {}, pd.DataFrame()\n\nif CONFIG[\"RUN_SHUFFLE_CONTROL\"]:\n    print(\"\\n[6] Shuffled-entity null control (N1).\")\n    control_results, control_models, control_iters, _ = run_variant(control_features, \"shuffled\")\nelse:\n    control_results, control_models, control_iters = pd.DataFrame(), {}, {}\n\nif CONFIG[\"RUN_RELATIONAL_ONLY\"]:\n    print(\"\\n[7] Relational features in isolation (standalone graph signal).\")\n    rel_only_results, rel_only_models, rel_only_iters, _ = run_variant(relational_cols, \"relational_only\")\nelse:\n    rel_only_results, rel_only_models, rel_only_iters = pd.DataFrame(), {}, {}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-24T07:13:15.136339Z","iopub.execute_input":"202