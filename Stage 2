=====================================================================\n# 9. Missingness Policy & OOF Manifest Export\n# ==============================================================================\nmissing_mask = np.isnan(oof_raw)\nseed_prior = float(df.loc[slices[0], CONFIG[\"TARGET_COLUMN\"]].mean())\nprint(f\"\\n[10] Missingness policy: {missing_mask.sum():,} unscored rows filled with \"\n      f\"seed-slice prior {seed_prior:.5f} and flagged.\")\nprint(\"     Never fill with 0.0 — that asserts 'certainly legitimate', which is false \"\n      \"and will distort downstream graph aggregation.\")\n\noof_df = pd.DataFrame({\n    \"TransactionID\": df[CONFIG[\"ID_COLUMN\"]].values,\n    \"chrono_block\": df[\"chrono_block\"].values,\n    \"stage2_prob_raw\": oof_raw,\n    \"stage2_prob_calibrated\": oof_cal if CONFIG[\"EXPORT_CALIBRATED_OOF\"] else np.nan,\n    \"stage2_prob_filled\": np.where(missing_mask, seed_prior, oof_raw).astype(np.float32),\n    \"stage2_available\": ~missing_mask,\n    \"stage2_missing\": missing_mask,\n    \"stage2_source\": oof_source,\n})\n\noof_output_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage2_oof_predictions.csv\")\noof_df.to_csv(oof_output_path, index=False)\nprint(f\"     Saved: {oof_output_path}\")\n\ncoverage = oof_df.groupby(\"chrono_block\")[\"stage2_available\"].mean()\nprint(\"     Stage-2 score coverage by block:\")\nfor blk, share in coverage.items():\n    tag = \" (Sealed OOT — frozen model)\" if blk == CONFIG[\"OOT_BLOCK\"] else \"\"\n    print(f\"       Block {blk}: {share:.1%}{tag}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-24T07:25:35.949762Z","iopub.execute_input":"2026-09-24T07:25:35.950005Z","iopub.status.idle":"2026-09-24T07:25:39.246171Z","shell.execute_reply.started":"2026-09-24T07:25:35.949982Z","shell.execute_reply":"2026-09-24T07:25:39.245466Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==============================================================================\n# 10. Hypothesis Testing — Paired Bootstrap with FDR Control\n# ==============================================================================\nprint(\"\\n[11] Executing paired bootstrap hypothesis tests...\")\n\nhypothesis_tests: list[dict] = []\n\n\ndef run_bootstrap_test(test_name: str, probs_new: np.ndarray, probs_ref: np.ndarray,\n                       subset_mask_fn=None, confirmatory: bool = True) -> list[dict]:\n    \"\"\"\n    Paired bootstrap per fold plus a pooled development test.\n\n    Rows are matched exactly between arms; any row missing a score in either arm\n    is dropped from BOTH, so the comparison stays paired.\n    \"\"\"\n    records = []\n    for fold_idx, (train_blocks, val_b) in enumerate(folds, 1):\n        train_idx = df.index[df[\"chrono_block\"].isin(train_blocks)].to_numpy()\n        train_max_dt = df.loc[train_idx, CONFIG[\"TIME_COLUMN\"]].max()\n        val_mask = (\n            (df[\"chrono_block\"] == val_b)\n            & (df[CONFIG[\"TIME_COLUMN\"]] >= train_max_dt + CONFIG[\"EMBARGO_SECONDS\"])\n        ).to_numpy()\n\n        active = val_mask & subset_mask_fn(df) if subset_mask_fn is not None else val_mask\n\n        y_eval = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].values\n        p_new = probs_new[active]\n        p_ref = probs_ref[active]\n        valid = ~(np.isnan(p_new) | np.isnan(p_ref))\n        if valid.sum() < 100 or y_eval[valid].sum() < 10:\n            continue\n\n        res = bootstrap_ap_delta(y_eval[valid], p_new[valid], p_ref[valid])\n        records.append({\n            \"test\": test_name, \"scope\": f\"fold_{fold_idx}\", \"val_block\": str(val_b),\n            \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()),\n            \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"],\n            \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"],\n        })\n\n    pooled = df[\"chrono_block\"].isin([2, 3, 4]).to_numpy()\n    active