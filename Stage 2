dtype=object)\n","\n","fallback_rounds = rounds_from_history(real_iters, CONFIG[\"FINAL_ROUNDS_RULE\"])\n","print(f\"    Fallback rounds ({CONFIG['FINAL_ROUNDS_RULE']} of \"\n","      f\"{list(real_iters.values())}): {fallback_rounds}\")\n","\n","# --- 8a. Block 1 via expanding chronological sub-folds ---\n","k = CONFIG[\"B1_SUBFOLDS\"]\n","b1_idx = df.index[df[\"chrono_block\"] == 1].to_numpy()\n","slices = np.array_split(b1_idx, k)\n","print(f\"    Block 1: expanding sub-folds K={k} (sizes {[len(s) for s in slices]}) \"\n","      f\"-> {(k - 1) / k:.0%} coverage vs. 50% under the v1 half-split.\")\n","\n","for s in range(1, k):\n","    sub_train = np.concatenate(slices[:s])\n","    sub_score = slices[s]\n","    assert_causal(df, sub_train, sub_score, f\"b1_subfold{s}\")\n","\n","    sub_model, sub_iter, _, sub_stop, sub_es = train_causal_model(\n","        df, sub_train, stage2_features, f\"b1_subfold{s}\", fallback_rounds\n","    )\n","    sub_cal = fit_calibrator(sub_model, df, sub_stop, stage2_features, sub_iter)\n","    p_raw = sub_model.predict(df.loc[sub_score, stage2_features],\n","                              num_iteration=sub_iter).astype(np.float32)\n","    oof_raw[sub_score] = p_raw\n","    oof_cal[sub_score] = apply_calibrator(sub_cal, p_raw)\n","    oof_source[sub_score] = f\"b1_subfold_{s}\"\n","    print(f\"      sub-fold {s}: train {len(sub_train):,} -> score {len(sub_score):,} \"\n","          f\"| rounds {sub_iter} ({'ES' if sub_es else 'fixed'})\")\n","\n","oof_source[slices[0]] = \"b1_seed_unscored\"\n","print(f\"      slice 0 ({len(slices[0]):,} rows) intentionally unscored — no prior \"\n","      \"data exists. Flagged, not silently NaN.\")\n","\n","# --- 8b. Blocks 2-4 via the fold models, scoring the FULL block (embargo off) ---\n","for fold_idx, meta in real_models.items():\n","    vb = meta[\"val_block\"]\n","    score_idx = df.index[df[\"chrono_block\"] == vb].to_numpy()\n","    assert_causal(df, meta[\"train_idx\"], score_idx, f\"featpass_block{vb}\")\n","    p_raw = meta[\"model\"].predict(df.loc[score_idx, stage2_features],\n","                                  num_iteration=meta[\"best_iter\"]).astype(np.float32)\n","    oof_raw[score_idx] = p_raw\n","    oof_cal[score_idx] = apply_calibrator(meta[\"calibrator\"], p_raw)\n","    oof_source[score_idx] = f\"forward_fold_{fold_idx}\"\n","    print(f\"    Block {vb}: scored {len(score_idx):,} rows with the Fold-{fold_idx} model.\")\n","\n","# --- 8c. Block 5 (sealed OOT) via a frozen model fit on Blocks 1-4 ---\n","print(\"    Block 5 (sealed OOT): fitting frozen production model on Blocks 1-4...\")\n","dev_idx = df.index[df[\"chrono_block\"].isin(CONFIG[\"DEV_BLOCKS\"])].to_numpy()\n","oot_idx = df.index[df[\"chrono_block\"] == CONFIG[\"OOT_BLOCK\"]].to_numpy()\n","assert not (set(dev_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row inside development index.\"\n","assert_causal(df, dev_idx, oot_idx, \"frozen_oot\")\n","\n","selection_model, final_iter, final_fit_idx, final_stop_idx, final_es = train_causal_model(\n","    df, dev_idx, stage2_features, \"frozen_oot\", fallback_rounds\n",")\n","final_calibrator = fit_calibrator(selection_model, df, final_stop_idx, stage2_features, final_iter)\n","# Calibration uses held-out selection-model scores, never in-sample refit scores.\n","if final_es:\n","    final_refit_idx = dev_idx.copy()\n","    final_train_data = lgb.Dataset(\n","        df.loc[final_refit_idx, stage2_features],\n","        label=df.loc[final_refit_idx, CONFIG[\"TARGET_COLUMN\"]].values,\n","    )\n","    final_model = lgb.train(\n","        CONFIG[\"LGB_PARAMS\"], final_train_data, num_boost_round=final_iter\n","    )\n","    assert final_train_data.num_data() == len(dev_idx), \"Actual refit dataset must contain all dev rows.\"\n","else:\n","    # The fixed-round fallback already fitted all development rows.\n","    final_refit_idx = final_fit_idx.copy()\n","    final_model = selection_model\n","assert np.array_equal(np.sort(final_refit_idx), np.sort(dev_idx)), \"Frozen fit must cover all dev rows.\"\n","assert not (set(final_refit_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row entered frozen refit.\"\n","final_calibration_provenance = {\n","    \"method\": CONFIG[\"CALIBRATION\"],\n","    \"fitted\": final_calibrator is not None,\n","    \"source\": \"selection_model_held_out_stop_slice\" if final_calibrator is not None else \"identity\",\n","    \"n_calibration_rows\": int(len(final_stop_idx)) if final_calibrator is not None else 0,\n","    \"transferred_to_refit\": bool(final_es and final_calibrator is not None),\n","    \"refit_calibration_revalidated\": False,\n","}\n","p_oot_raw = final_model.predict(df.loc[oot_idx, stage2_features],\n","                                num_iteration=final_iter).astype(np.float32)\n","oof_raw[oot_idx] = p_oot_raw\n","oof_cal[oot_idx] = apply_calibrator(final_calibrator, p_oot_raw)\n","oof_source[oot_idx] = \"frozen_oot_model\"\n","print(f\"      Round selection: fit {len(final_fit_idx):,} / stop {len(final_stop_idx):,} rows | \"\n","      f\"rounds {final_iter} ({'ES' if final_es else 'fixed fallback'}).\")\n","print(f\"      Frozen model: fit {len(final_refit_idx):,} development rows at fixed rounds | \"\n","      f\"scored {len(oot_idx):,} OOT rows.\")\n","print(\"      Selection-model calibration transferred to refit when fitted; not revalidated.\")\n","print(\"      OOT target NOT read. No OOT metric is computed in Stage 2.\")\n","\n","model_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage2_frozen_model.txt\")\n","final_model.save_model(model_path, num_iteration=final_iter)\n","\n","# --- 8d. Companion coverage for the base_only arm (paired H1 needs aligned rows) ---\n","base_oof_raw = np.full(len(df), np.nan, dtype=np.float32)\n","if CONFIG[\"RUN_BASE_ONLY\"]:\n","    for fold_idx, meta in base_models.items():\n","        vb = meta[\"val_block\"]\n","        score_idx = df.index[df[\"chrono_block\"] == vb].to_numpy()\n","        assert_causal(df, meta[\"train_idx\"], score_idx, f\"base_featpass_block{vb}\")\n","        base_oof_raw[score_idx] = meta[\"model\"].predict(\n","            df.loc[score_idx, base_features], num_iteration=meta[\"best_iter\"]\n","        ).astype(np.float32)\n","\n","# --- 8e. Companion coverage for the shuffled control (paired N1) ---\n","control_oof_raw = np.full(len(df), np.nan, dtype=np.float32)\n","if CONFIG[\"RUN_SHUFFLE_CONTROL\"]:\n","    for fold_idx, meta in control_models.items():\n","        vb = meta[\"val_block\"]\n","        score_idx = df.index[df[\"chrono_block\"] == vb].to_numpy()\n","        control_oof_raw[score_idx] = meta[\"model\"].predict(\n","            df.loc[score_idx, control_features], num_iteration=meta[\"best_iter\"]\n","        ).astype(np.float32)"]},{"cell_type":"code","execution_count":11,"id":"f17668c6","metadata":{"execution":{"iopub.execute_input":"2026-09-30T09:27:19.845773Z","iopub.status.busy":"2026-09-30T09:27:19.845361Z","iopub.status.idle":"2026-09-30T09:27:22.986083Z","shell.execute_reply":"2026-09-30T09:27:22.984843Z"},"papermill":{"duration":3.151844,"end_time":"2026-09-30T09:27:22.988273+00:00","exception":false,"start_time":"2026-09-30T09:27:19.836429+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[10] Missingness policy: 29,527 unscored rows filled with seed-slice prior 0.02879 and flagged.\n","     Never fill with 0.0 — that asserts 'certainly legitimate', which is false and will distort downstream graph aggregation.\n","     Saved: ./artifacts/stage2_oof_predictions.csv\n","     Stage-2 score coverage by block:\n","       Block 1: 75.0%\n","       Block 2: 100.0%\n","       Block 3: 100.0%\n","       Block 4: 100.0%\n","       Block 5: 100.0% (Sealed OOT — frozen model)\n"]}],"source":["# ==============================================================================\n","# 9. Missingness Policy & OOF Manifest Export\n","# ==============================================================================\n","missing_mask = np.isnan(oof_raw)\n","seed_prior = float(df.loc[slices[0], CONFIG[\"TARGET_COLUMN\"]].mean())\n","print(f\"\\n[10] Missingness policy: {missing_mask.sum():,} unscored rows filled with \"\n","      f\"seed-slice prior {seed_prior:.5f} and flagged.\")\n","print(\"     Never fill with 0.0 — that asserts 'certainly legitimate', which is false \"\n","      \"and will distort downstream graph aggregation.\")\n","\n","oof_df = pd.DataFrame({\n","    \"TransactionID\": df[CONFIG[\"ID_COLUMN\"]].values,\n","    \"chrono_block\": df[\"chrono_block\"].values,\n","    \"stage2_prob_raw\": oof_raw,\n","    \"stage2_prob_calibrated\": oof_cal if CONFIG[\"EXPORT_CALIBRATED_OOF\"] else np.nan,\n","    \"stage2_prob_filled\": np.where(missing_mask, seed_prior, oof_raw).astype(np.float32),\n","    \"stage2_available\": ~missing_mask,\n","    \"stage2_missing\": missing_mask,\n","    \"stage2_source\": oof_source,\n","})\n","\n","oof_output_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage2_oof_predictions.csv\")\n","oof_df.to_csv(oof_output_path, index=False)\n","print(f\"     Saved: {oof_output_path}\")\n","\n","coverage = oof_df.groupby(\"chrono_block\")[\"stage2_available\"].mean()\n","print(\"     Stage-2 score coverage by block:\")\n","for blk, share in coverage.items():\n","    tag = \" (Sealed OOT — frozen model)\" if blk == CONFIG[\"OOT_BLOCK\"] else \"\"\n","    print(f\"       Block {blk}: {share:.1%}{tag}\")"]},{"cell_type":"code","execution_count":12,"id":"0e15fc7a","metadata":{"execution":{"iopub.execute_input":"2026-09-30T09:27:23.004388Z","iopub.status.busy":"2026-09-30T09:27:23.003984Z","iopub.status.idle":"2026-09-30T09:38:29.345379Z","shell.execute_reply":"2026-09-30T09:38:29.344163Z"},"papermill":{"duration":666.352989,"end_time":"2026-09-30T09:38:29.348276+00:00","exception":false,"start_time":"2026-09-30T09:27:22.995287+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[11] Executing paired bootstrap hypothesis tests...\n"]}],"source":["# ==============================================================================\n","# 10. Hypothesis Testing — Paired Bootstrap with FDR Control\n","# ==============================================================================\n","print(\"\\n[11] Executing paired bootstrap hypothesis tests...\")\n","\n","hypothesis_tests: list[dict] = []\n","\n","\n","def run_bootstrap_test(test_name: str, probs_new: np.ndarray, probs_ref: np.ndarray,\n","                       subset_mask_fn=None, confirmatory: bool = True) -> list[dict]:\n","    \"\"\"\n","    Paired bootstrap per fold plus a pooled development test.\n","\n","    Rows are matched exactly between arms; any row missing a score in either arm\n","    is dropped from BOTH, so the comparison stays paired.\n","    \"\"\"\n","    records = []\n","    pooled = np.zeros(len(df), dtype=bool)\n","    cohort = (np.asarray(subset_mask_fn(df), dtype=bool)\n","              if subset_mask_fn is not None else np.ones(len(df), dtype=bool))\n","    paired_valid = np.isfinite(probs_new) & np.isfinite(probs_ref)\n","    fold_aligned_counts = {}\n","    for fold_idx, (train_blocks, val_b) in enumerate(folds, 1):\n","        train_idx = df.index[df[\"chrono_block\"].isin(train_blocks)].to_numpy()\n","        train_max_dt = df.loc[train_idx, CONFIG[\"TIME_COLUMN\"]].max()\n","        val_mask = (\n","            (df[\"chrono_block\"] == val_b)\n","            & (df[CONFIG[\"TIME_COLUMN\"]] >= train_max_dt + CONFIG[\"EMBARGO_SECONDS\"])\n","        ).to_numpy()\n","\n","        assert not np.any(pooled & val_mask), \"Validation fold masks must be disjoint.\"\n","        pooled |= val_mask\n","        active = val_mask & cohort & paired_valid\n","\n","        y_eval = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].values\n","        p_new = probs_new[active]\n","        p_ref = probs_ref[active]\n","        valid = np.isfinite(p_new) & np.isfinite(p_ref)\n","        fold_aligned_counts[f\"fold_{fold_idx}\"] = int(valid.sum())\n","        if valid.sum() < 100 or y_eval[valid].sum() < 10:\n","            continue\n","\n","        res = bootstrap_ap_delta(y_eval[valid], p_new[valid], p_ref[valid])\n","        records.append({\n","            \"test\": test_name, \"scope\": f\"fold_{fold_idx}\", \"val_block\": str(val_b),\n","            \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()),\n","            \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"],\n","            \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"],\n","        })\n","\n","    active = pooled & cohort & paired_valid\n","    y_pool = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].values\n","    p_new = probs_new[active]\n","    p_ref = probs_ref[active]\n","    valid = np.isfinite(p_new) & np.isfinite(p_ref)\n","    # Include aligned rows even when a fold alone is too small to test.\n","    assert int(valid.sum()) == sum(fold_aligned_counts.values())\n","    if valid.sum() >= 100 and y_pool[valid].sum() >= 10:\n","        res = bootstrap_ap_delta(y_pool[valid], p_new[valid], p_ref[valid])\n","        records.append({\n","            \"test\": test_name, \"scope\": \"pooled_dev (B2-B4)\", \"val_block\": \"2-4\",\n","            \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()),\n","            \"aligned_rows_by_fold\": fold_aligned_counts,\n","            \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"],\n","            \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"],\n","        })\n","    return records\n","\n","\n","# --- H0 (internal, primary): relational uplift over base features, same run ---\n","if CONFIG[\"RUN_BASE_ONLY\"]:\n","    hypothesis_tests += run_bootstrap_test(\n","        \"H0  Relational vs Base-Only [INTERNAL]\", oof_raw, base_oof_raw\n","    )\n","    hypothesis_tests += run_bootstrap_test(\n","        \"H0a Seen-Before Cards [INTERNAL]\", oof_raw, base_oof_raw,\n","        subset_mask_fn=lambda d: (~d[\"card_first_seen\"]).to_numpy(),\n","    )\n","    hypothesis_tests += run_bootstrap_test(\n","        \"H0b First-Seen Cards [INTERNAL]\", oof_raw, base_oof_raw,\n","        subset_mask_fn=lambda d: d[\"card_first_seen\"].to_numpy(),\n","    )\n","\n","# --- N1: real entity topology vs. shuffled null ---\n","if CONFIG[\"RUN_SHUFFLE_CONTROL\"]:\n","    hypothesis_tests += run_bootstrap_test(\n","        \"N1  Real vs Shuffled Entities\", oof_raw, control_oof_raw\n","    )\n","\n","# --- H1 (cross-stage, secondary): Stage 2 vs. Stage 1 artifact ---\n","if STAGE1_OOF_AVAILABLE and not df[\"stage1_prob_raw\"].isna().all():\n","    s1 = df[\"stage1_prob_raw\"].values\n","    hypothesis_tests += run_bootstrap_test(\n","        \"H1  Stage2 vs Stage1 [CROSS-RUN]\", oof_raw, s1, confirmatory=False\n","    )\n","    hypothesis_tests += run_bootstrap_test(\n","        \"H1a Seen-Before Cards [CROSS-RUN]\", oof_raw, s1,\n","        subset_mask_fn=lambda d: (~d[\"card_first_seen\"]).to_numpy(), confirmatory=False,\n","    )\n","    hypothesis_tests += run_bootstrap_test(\n","        \"H1b First-Seen Cards [CROSS-RUN]\", oof_raw, s1,\n","        subset_mask_fn=lambda d: d[\"card_first_seen\"].to_numpy(), confirmatory=False,\n","    )\n","else:\n","    print(\"     H1/H1a/H1b SKIPPED — no Stage 1 OOF artifact resolved.\")\n","\n","tests_df = pd.DataFrame(hypothesis_tests)\n","\n","# --- Benjamini-Hochberg across the confirmatory family only ---\n","if not tests_df.empty:\n","    conf = tests_df[\"confirmatory\"].to_numpy()\n","    tests_df[\"p_adj\"] = np.nan\n","    tests_df[\"fdr_reject\"] = False\n","    if conf.sum() > 0:\n","        reject, p_adj = benjamini_hochberg(\n","            tests_df.loc[conf, \"p_value\"].to_numpy(), CONFIG[\"FDR_ALPHA\"]\n","        )\n","        tests_df.loc[conf, \"p_adj\"] = p_adj\n","        tests_df.loc[conf, \"fdr_reject\"] = reject\n","\n","    def verdict_of(row) -> str:\n","        if not row[\"confirmatory\"]:\n","            return \"EXPLORATORY\"\n","        material = row[\"delta_AP\"] >= CONFIG[\"ACCEPTANCE_DELTA\"]\n","        if row[\"fdr_reject\"] and material:\n","            return \"SUPPORTED\"\n","        if row[\"fdr_reject\"]:\n","            return \"REAL BUT < THRESH\"\n","        return \"NOT SUPPORTED\"\n","\n","    tests_df[\"verdict\"] = tests_df.apply(verdict_of, axis=1)"]},{"cell_type":"code","execution_count":13,"id":"7f135fcf","metadata":{"execution":{"iopub.execute_input":"2026-09-30T09:38:29.365135Z","iopub.status.busy":"2026-09-30T09:38:29.364734Z","iopub.status.idle":"2026-09-30T09:38:29.428177Z","shell.execute_reply":"2026-09-30T09:38:29.427048Z"},"papermill":{"duration":0.074213,"end_time":"2026-09-30T09:38:29.430439+00:00","exception":false,"start_time":"2026-09-30T09:38:29.356226+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","==================================================================================================================================\n","STAGE 2 GRAPH-AUGMENTED GBDT — EXPANDING FORWARD VALIDATION REPORT (EMBARGOED)\n","==================================================================================================================================\n","        variant  fold  val_block  n_features  best_iter  n_val       AP  AP_calibrated  AP_new_entity  AP_seen_entity  card_overlap_rate  ROC_AUC      ECE  ECE_quantile    Brier  Recall@0.1%FPR  Recall@1.0%FPR  Prec@1.0%cap  Loss_no_model  Loss_cost_rule  AlertRate\n","           real     1          2         390        429 114488 0.495992       0.473901       0.498965        0.492977           0.320339 0.832706 0.028844      0.028588 0.029489        0.269380        0.410637      0.943182  642186.539124   489686.843252   0.010813\n","           real     2          3         390        142 114355 0.475876       0.458965       0.540367        0.448494           0.343431