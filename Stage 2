n    oof_source[sub_score] = f\"b1_subfold_{s}\"\n    print(f\"      sub-fold {s}: train {len(sub_train):,} -> score {len(sub_score):,} \"\n          f\"| rounds {sub_iter} ({'ES' if sub_es else 'fixed'})\")\n\noof_source[slices[0]] = \"b1_seed_unscored\"\nprint(f\"      slice 0 ({len(slices[0]):,} rows) intentionally unscored — no prior \"\n      \"data exists. Flagged, not silently NaN.\")\n\n# --- 8b. Blocks 2-4 via the fold models, scoring the FULL block (embargo off) ---\nfor fold_idx, meta in real_models.items():\n    vb = meta[\"val_block\"]\n    score_idx = df.index[df[\"chrono_block\"] == vb].to_numpy()\n    assert_causal(df, meta[\"train_idx\"], score_idx, f\"featpass_block{vb}\")\n    p_raw = meta[\"model\"].predict(df.loc[score_idx, stage2_features],\n                                  num_iteration=meta[\"best_iter\"]).astype(np.float32)\n    oof_raw[score_idx] = p_raw\n    oof_cal[score_idx] = apply_calibrator(meta[\"calibrator\"], p_raw)\n    oof_source[score_idx] = f\"forward_fold_{fold_idx}\"\n    print(f\"    Block {vb}: scored {len(score_idx):,} rows with the Fold-{fold_idx} model.\")\n\n# --- 8c. Block 5 (sealed OOT) via a frozen model fit on Blocks 1-4 ---\nprint(\"    Block 5 (sealed OOT): fitting frozen production model on Blocks 1-4...\")\ndev_idx = df.index[df[\"chrono_block\"].isin(CONFIG[\"DEV_BLOCKS\"])].to_numpy()\noot_idx = df.index[df[\"chrono_block\"] == CONFIG[\"OOT_BLOCK\"]].to_numpy()\nassert not (set(dev_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row inside development index.\"\nassert_causal(df, dev_idx, oot_idx, \"frozen_oot\")\n\nfinal_model, final_iter, final_fit_idx, final_stop_idx, final_es = train_causal_model(\n    df, dev_idx, stage2_features, \"frozen_oot\", fallback_rounds\n)\nfinal_calibrator = fit_calibrator(final_model, df, final_stop_idx, stage2_features, final_iter)\np_oot_raw = final_model.predict(df.loc[oot_idx, stage2_features],\n                                num_iteration=final_iter).astype(np.float32)\noof_raw[