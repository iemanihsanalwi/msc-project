st()\n","\n","base_features = [\n","    col for col in accepted_features\n","    if col in df.columns\n","    and col not in TARGET_LEAKAGE_COLUMNS\n","    and col not in AUDIT_ONLY_COLUMNS\n","]\n","\n","v_cols = sorted([c for c in base_features if c.startswith(\"V\") and c[1:].isdigit()],\n","                key=lambda x: int(x[1:]))\n","num_cols = [c for c in base_features if c not in v_cols and df[c].dtype.kind in \"if\"]\n","assert num_cols, \"Fatal: no continuous features survived the audit filter.\"\n","assert v_cols, \"Fatal: no V-columns survived the audit filter.\"\n","print(f\"    Continuous features: {len(num_cols)} | V-columns: {len(v_cols)}\")\n","\n","\n","def load_upstream_probs(candidates: list[str], preferred_cols: list[str],\n","                        out_col: str, stage_name: str) -> bool:\n","    \"\"\"Preserve score preference; enforce join integrity for both upstream stages.\"\"\"\n","    global df\n","    artifact_name = out_col.split(\"_prob\")[0] + \"_oof\"\n","    optional = artifact_name != \"stage1_oof\"\n","    try:\n","        path = resolve_first_existing(candidates)\n","    except FileNotFoundError as exc:\n","        record_input_artifact(artifact_name, None, optional=optional)\n","        df[out_col] = np.nan\n","        upstream_availability[out_col] = np.zeros(len(df), dtype=bool)\n","        print(f\"    {stage_name}: NOT FOUND ({exc})\")\n","        return False\n","\n","    frame = pd.read_csv(path)\n","    record_input_artifact(artifact_name, path, optional=optional)\n","    id_col = CONFIG[\"ID_COLUMN\"]\n","    assert id_col in frame.columns, f\"{stage_name}: missing {id_col} schema\"\n","    assert frame[id_col].notna().all(), f\"{stage_name}: null upstream IDs\"\n","    assert frame[id_col].is_unique, f\"{stage_name}: duplicate upstream IDs\"\n","    assert df[id_col].notna().all() and df[id_col].is_unique, \"Invalid main IDs\"\n","    col = next((c for c in preferred_cols if c in frame.columns), None)\n","    if col is None:\n","        input_artifacts[artifact_name][\"score_status\"] = \"no_recognised_probability_column\"\n","        df[out_col] = np.nan\n","        upstream_availability[out_col] = np.zeros(len(df), dtype=bool)\n","        print(f\"    {stage_name}: no recognised probability column in {path}\")\n","        return False\n","\n","    prefix = artifact_name.removesuffix(\"_oof\")\n","    original_available = frame[col].notna().to_numpy(copy=True)\n","    if not optional:\n","        for suffix, invert in ((\"available\", False), (\"missing\", True)):\n","            flag_col = f\"{prefix}_{suffix}\"\n","            if flag_col in frame:\n","                flags = frame[flag_col]\n","                assert flags.notna().all() and flags.isin([True, False, 0, 1]).all(), (\n","                    f\"{stage_name}: invalid Boolean metadata {flag_col}\"\n","                )\n","                flags = flags.to_numpy(dtype=bool)\n","                original_available &= ~flags if invert else flags\n","        source_col = f\"{prefix}_source\"\n","        if source_col in frame:\n","            source = frame[source_col].astype(\"string\")\n","            unscored = source.str.contains(r\"unscored|prior|fill|fallback|^none$\", case=False, na=True)\n","            original_available &= ~unscored.to_numpy(dtype=bool)\n","\n","    scores = frame[[id_col, col]].rename(columns={col: out_col}).copy()\n","    scores[\"_upstream_original_available\"] = original_available\n","    left_ids = df[id_col].to_numpy(copy=True)\n","    left_index = df.index.copy()\n","    before = len(df)\n","    merged = df.merge(scores, on=id_col, how=\"left\", sort=False, validate=\"many_to_one\")\n","    assert len(merged) == before, f\"{stage_name}: merge changed row count\"\n","    assert np.array_equal(merged[id_col].to_numpy(), left_ids), (\n","        f\"{stage_name}: merge changed left ID order/alignment\"\n","    )\n","    merged.index = left_index\n","    upstream_availability[out_col] = (\n",