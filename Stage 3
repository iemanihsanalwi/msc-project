.4f}]\"\n","        p_adj = \"     —\" if pd.isna(r[\"p_adj\"]) else f\"{r['p_adj']:.4f}\"\n","        print(f\"{r['test']:<44} {r['scope']:<20} {r['n_evaluated']:>8} \"\n","              f\"{r['delta_AP']:>+10.4f} {ci:>22} {r['p_value']:>7.4f} {p_adj:>7}  {r['verdict']}\")\n","\n","    print(f\"\\nDecision rule: SUPPORTED requires BH-adjusted p <= {CONFIG['FDR_ALPHA']} \"\n","          f\"AND delta AP >= {CONFIG['ACCEPTANCE_DELTA']}.\")\n","    print(\"Tests marked [CROSS-RUN] are EXPLORATORY: they compare against separately\")\n","    print(\"executed stages and confound model family with run configuration. They are\")\n","    print(\"excluded from the FDR family and carry no confirmatory weight.\")\n","\n","print(\"\\n--- Diagnostics ---\")\n","print(diag_df.to_string(index=False))\n","\n","# --- Exports ---\n","results_output_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage3_fold_results.csv\")\n","results_df.to_csv(results_output_path, index=False)\n","summary_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage3_variant_summary.csv\")\n","summary_df.to_csv(summary_path, index=False)\n","diag_output_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage3_diagnostics.csv\")\n","diag_df.to_csv(diag_output_path, index=False)\n","\n","tests_output_path = None\n","if not tests_df.empty:\n","    tests_output_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage3_hypothesis_tests.csv\")\n","    tests_df.to_csv(tests_output_path, index=False)\n","\n","real_slice = results_df[results_df[\"variant\"] == \"real\"]\n","run_manifest = {\n","    \"stage\": \"Stage 3 - Frozen Two-Stage Res-GNN (v2, audit-hardened)\",\n","    \"executed_at_utc\": datetime.now(timezone.utc).isoformat(timespec=\"seconds\"),\n","    \"device\": str(DEVICE),\n","    \"stage_exit_decision\": stage_exit_decision,\n","    \"stage_exit_gate\": stage_exit_gate,\n","    \"stage1_required_coverage_gate\": stage1_gate_coverage,\n","    \"predecessor_audits\": predecessor_audits,\n","    \"b1_skipped_subfolds\": b1_skipped_subfolds,\n","    \"input_artifact_fingerprints\": input_artifacts,\n","    **code_fingerprints(),\n","    \"dataset_rows\": int(len(df)),\n","    \"continuous_features\": int(len(num_cols)),\n","    \"v_columns\": int(len(v_cols)),\n","    \"variants\": VARIANTS,\n","    \"n_seeds_per_variant\": CONFIG[\"N_SEEDS\"],\n","    \"mean_ap_real\": float(real_slice[\"AP\"].mean()),\n","    \"std_ap_real\": float(real_slice[\"AP\"].std()),\n","    \"mean_ap_real_calibrated\": float(real_slice[\"AP_calibrated\"].mean()),\n","    \"mean_recall_at_0p1_fpr_real\": float(real_slice[\"Recall@0.1%FPR\"].mean()),\n","    \"seed_noise_floor_inner_ap_sd\": noise_floor,\n","    \"fraud_base_rate\": base_rate,\n","    \"mean_validation_connectivity\": float(diag_df[\"connectivity_val\"].mean()),\n","    \"stage1_artifact_available\": bool(STAGE1_AVAILABLE),\n","    \"stage1_logit_coverage_val_mean\": float(diag_df[\"stage1_logit_coverage_val\"].mean()),\n","    \"stage2_artifact_available\": bool(STAGE2_AVAILABLE),\n","    \"oof_coverage_by_block\": {str(k): float(v) for k, v in coverage.items()},\n","    \"oof_missing_rows\": int(missing_mask.sum()),\n","    \"oof_missing_fill_value\": seed_prior,\n","    \"representation_shift_max\": float(diag_df[\"shift_max_shift\"].max()),\n","    \"frozen_oot_shift_max\": float(oot_shift[\"max_shift\"]),\n","    \"fdr_alpha\": CONFIG[\"FDR_ALPHA\"],\n","    \"acceptance_delta\": CONFIG[\"ACCEPTANCE_DELTA\"],\n","    \"artifacts\": {\n","        \"oof_predictions\": oof_output_path,\n","        \"fold_results\": results_output_path,\n","        \"variant_summary\": summary_path,\n","        \"diagnostics\": diag_output_path,\n","        \"hypothesis_tests\": tests_output_path,\n","    },\n","    \"config\": {k: v for k, v in CONFIG.items() if not k.startswith(\"CANDIDATE\")},\n","}\n","manifest_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage3_run_manifest.json\")\n","with open(manifest_path, \"w\") as f:\n","    json.dump(run_m