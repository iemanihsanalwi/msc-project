aled, and unevaluated by design — reserved for the final joint-model comparison.\n"]}],"source":["# ==============================================================================\n","# 12. Reporting & Provenance\n","# ==============================================================================\n","\n","def derive_stage_exit_decision(tests: pd.DataFrame) -> dict:\n","    \"\"\"Fail closed; only the unique exact internal pooled H2a can advance.\"\"\"\n","    test_name = \"H2a Message Passing (Real - NoGraph)\"\n","    scope = \"pooled_dev (B2-B4)\"\n","    gate = {\n","        \"decision\": \"DO_NOT_ADVANCE_GRAPH_ARM\",\n","        \"criterion\": \"unique exact H2a at pooled_dev (B2-B4), confirmatory=True, \"\n","                     \"finite delta_AP >= ACCEPTANCE_DELTA and finite p_adj <= FDR_ALPHA\",\n","        \"test\": test_name, \"scope\": scope,\n","        \"acceptance_delta\": CONFIG[\"ACCEPTANCE_DELTA\"],\n","        \"fdr_alpha\": CONFIG[\"FDR_ALPHA\"], \"observed_internal_result\": None,\n","    }\n","    needed = {\"test\", \"scope\", \"confirmatory\", \"delta_AP\", \"p_adj\"}\n","    if not needed <= set(tests.columns):\n","        gate[\"reason\"] = \"missing comparator/test or required result columns\"\n","        return gate\n","    matches = tests.loc[(tests[\"test\"] == test_name) & (tests[\"scope\"] == scope)]\n","    if len(matches) != 1:\n","        gate[\"reason\"] = f\"exact pooled H2a result count is {len(matches)}, expected one\"\n","        return gate\n","    row = matches.iloc[0]\n","    delta = pd.to_numeric(row[\"delta_AP\"], errors=\"coerce\")\n","    p_adj = pd.to_numeric(row[\"p_adj\"], errors=\"coerce\")\n","    confirmatory = isinstance(row[\"confirmatory\"], (bool, np.bool_)) and bool(row[\"confirmatory\"])\n","    gate[\"observed_internal_result\"] = {\n","        \"delta_AP\": float(delta) if np.isfinite(delta) else None,\n","        \"p_adj\": float(p_adj) if np.isfinite(p_adj) else None,\n","        \"confirmatory\": confirmatory,\n","    }\n","    if not confirmatory:\n","        gate[\"reason\"] = \"exact H2a result is not confirmatory\"\n","    elif not np.isfinite(delta) or not np.isfinite(p_adj):\n","        gate[\"reason\"] = \"nonfinite delta_AP or adjusted p-value\"\n","    elif delta < CONFIG[\"ACCEPTANCE_DELTA\"]:\n","        gate[\"reason\"] = \"delta_AP below materiality threshold\"\n","    elif not 0 <= p_adj <= CONFIG[\"FDR_ALPHA\"]:\n","        gate[\"reason\"] = \"existing FDR significance does not pass\"\n","    else:\n","        gate[\"decision\"] = \"ADVANCE_GRAPH_ARM\"\n","        gate[\"reason\"] = \"exact confirmatory pooled H2a passes materiality and existing FDR\"\n","    return gate\n","\n","\n","stage_exit_gate = derive_stage_exit_decision(tests_df)\n","stage_exit_decision = stage_exit_gate[\"decision\"]\n","print(f\"Stage exit decision: {stage_exit_decision} — {stage_exit_gate['reason']}\")\n","\n","\n","cap_col = f\"Prec@{CONFIG['INVESTIGATION_CAPACITY']:.1%}cap\"\n","report_columns = [\n","    \"variant\", \"fold\", \"val_block\", \"n_seeds\", \"n_val\",\n","    \"AP\", \"AP_calibrated\", \"AP_connected\", \"AP_isolated\",\n","    \"AP_new_entity\", \"AP_seen_entity\", \"connected_share\", \"card_overlap_rate\",\n","    \"ROC_AUC\", \"ECE\", \"ECE_quantile\", \"ECE_calibrated\",\n","    \"Recall@0.1%FPR\", \"Recall@1.0%FPR\", cap_col,\n","    \"Loss_no_model\", \"Loss_cost_rule\", \"Loss_cost_rule_calibrated\",\n","]\n","\n","print(\"\\n\" + \"=\" * 140)\n","print(\"STAGE 3 FROZEN TWO-STAGE RES-GNN — EXPANDING FORWARD VALIDATION REPORT (EMBARGOED)\")\n","print(\"=\" * 140)\n","print(results_df[report_columns].to_string(index=False))\n","\n","print(\"\\n--- Mean across expanding folds, by variant ---\")\n","summary_rows = []\n","for variant in VARIANTS:\n","    v_df = results_df[results_df[\"variant\"] == variant]\n","    if v_df.empty:\n","        continue\n","    summary_rows.append({\n","        \"variant\": variant,\n","        \"AP\": v_df[\"AP\"].mean(