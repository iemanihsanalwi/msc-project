 & ~valid & (frame[\"chrono_block\"].to_numpy() == block)).sum())\n","            for block in sorted(frame[\"chrono_block\"].unique())\n","        },\n","        \"artifact_available\": bool(artifact_available),\n","    }\n","    print(\"    Mandatory Stage-1 gate:\", json.dumps(counts, sort_keys=True))\n","    if not artifact_available or counts[\"required_invalid_rows\"]:\n","        raise RuntimeError(\"Mandatory Stage 1 unavailable or required probability coverage \"\n","                           \"incomplete/invalid; refusing ANY training. \" + json.dumps(counts))\n","    # Preserve intentional seed missingness when a filled-only artifact has metadata.\n","    frame.loc[~original_available, \"stage1_prob_raw\"] = np.nan\n","    return counts\n","\n","\n","STAGE1_AVAILABLE = load_upstream_probs(\n","    CONFIG[\"CANDIDATE_STAGE1_OOF\"],\n","    [\"stage1_prob_raw\", \"stage1_prob_calibrated\", \"stage1_prob_filled\", \"stage1_oof_prob\"],\n","    \"stage1_prob_raw\", \"Stage 1 OOF\",\n",")\n","\n","stage1_gate_coverage = validate_stage1_coverage(\n","    df, STAGE1_AVAILABLE, upstream_availability[\"stage1_prob_raw\"]\n",")\n","\n","STAGE2_AVAILABLE = load_upstream_probs(\n","    CONFIG[\"CANDIDATE_STAGE2_OOF\"],\n","    [\"stage2_prob_raw\", \"stage2_prob_calibrated\", \"stage2_prob_filled\", \"stage2_oof_prob\"],\n","    \"stage2_prob_raw\", \"Stage 2 OOF\",\n",")\n","\n","STAGE2_AP: dict[int, float] = {}\n","try:\n","    s2_res_path = resolve_first_existing(CONFIG[\"CANDIDATE_STAGE2_RESULTS\"])\n","    s2_df = pd.read_csv(s2_res_path)\n","    record_input_artifact(\"stage2_fold_results\", s2_res_path, optional=True)\n","    if \"variant\" in s2_df.columns:\n","        s2_df = s2_df[s2_df[\"variant\"] == \"real\"]\n","    STAGE2_AP = {int(k): float(v) for k, v in s2_df.set_index(\"fold\")[\"AP\"].to_dict().items()}\n","    # BUG FIX: v1 double-braced this f-string and printed its own source text.\n","    print(f\"    Stage 2 reference APs: {{k: round(v, 4) f