loss $601,978 -> $416,981\n","    -- variant: NULL --\n","      null: seeds 3 | epochs [7, 4, 4] | inner AP 0.4479 +/- 0.0038\n","       AP 0.5307 | ROC-AUC 0.8887 | R@0.1%FPR 25.14% | connected 0.5305 / isolated 0.5570\n","       ECE_q 0.09188 -> 0.00260 | cost-rule loss $605,181 -> $418,118\n","    -- variant: NO_GRAPH --\n","      no_graph: seeds 3 | epochs [2, 6, 3] | inner AP 0.4505 +/- 0.0043\n","       AP 0.5365 | ROC-AUC 0.8903 | R@0.1%FPR 25.52% | connected 0.5365 / isolated 0.5449\n","       ECE_q 0.09185 -> 0.00267 | cost-rule loss $608,662 -> $402,639\n"]}],"source":["# ==============================================================================\n","# 8. PASS A — Expanding Forward Validation (embargoed, reported metrics)\n","#    Full blocks are scored for Pass B; the embargo filters only what is measured.\n","# ==============================================================================\n","folds = [\n","    ([1], 2),\n","    ([1, 2], 3),\n","    ([1, 2, 3], 4),\n","]\n","\n","VARIANTS = [\"real\"]\n","if CONFIG[\"RUN_NULL_CONTROL\"]:\n","    VARIANTS.append(\"null\")\n","if CONFIG[\"RUN_NO_GRAPH_ABLATION\"]:\n","    VARIANTS.append(\"no_graph\")\n","\n","fold_results: list[dict] = []\n","diagnostics: list[dict] = []\n","\n","full_block_probs = {v: np.full(len(df), np.nan, dtype=np.float32) for v in VARIANTS}\n","full_block_cal = {v: np.full(len(df), np.nan, dtype=np.float32) for v in VARIANTS}\n","oof_source = np.full(len(df), \"none\", dtype=object)\n","\n","\n","def subset_ap(y: np.ndarray, p: np.ndarray, mask: np.ndarray) -> float:\n","    \"\"\"AP on a row subset; NaN when the subset holds no positives.\"\"\"\n","    if not mask.any() or y[mask].sum() == 0:\n","        return float(\"nan\")\n","    return float(average_precision_score(y[mask], p[mask]))\n","\n","\n","print(\"\\n\" + \"=\" * 88)\n","print(\"PASS A: EXPANDING CHRONOLOGICAL FORWARD VALIDATION (EMBARGOED EVALUATION)\")\n","print(\"=\" * 88)\n","\n","for fold_idx, (train_blocks, val_block) in enumerate(folds, 1):\n","    print(f\"\\n--- Fold {fold_idx}: train {train_blocks} -> validate Block {val_block} ---\")\n","\n","    train_idx = df.index[df[\"chrono_block\"].isin(train_blocks)].to_numpy()\n","    val_idx_full = df.index[df[\"chrono_block\"] == val_block].to_numpy()\n","\n","    assert not (set(train_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row entered training.\"\n","    assert_causal(df, train_idx, val_idx_full, f\"fold{fold_idx}\")\n","\n","    train_max_dt = df.loc[train_idx, CONFIG[\"TIME_COLUMN\"]].max()\n","    embargo_keep = (df.loc[val_idx_full, CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","                    >= train_max_dt + CONFIG[\"EMBARGO_SECONDS\"])\n","\n","    df_tr = df.loc[train_idx].reset_index(drop=True)\n","    df_va = df.loc[val_idx_full].reset_index(drop=True)\n","    n_tr, n_va = len(df_tr), len(df_va)\n","\n","    # The embargo must not erase the evaluation set; a silent empty slice would\n","    # propagate NaNs into every downstream metric.\n","    y_va_full = df_va[CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","    assert embargo_keep.sum() >= 100, (\n","        f\"fold {fold_idx}: only {embargo_keep.sum()} validation rows survive the embargo.\"\n","    )\n","    assert y_va_full[embargo_keep].sum() >= 10, (\n","        f\"fold {fold_idx}: too few positives survive the embargo.\"\n","    )\n","\n","    # --- Representation space (fitted strictly on the training window) ---\n","    Z_tr, Z_va, info = build_neural_features(df_tr, df_va, v_cols, num_cols, CONFIG[\"N_PCA\"])\n","    shift = check_representation_shift(Z_tr, Z_va, f\"fold_{fold_idx}\")\n","    print(f\"    V-PCA({info['pca_components']}) explains {info['pca_explained']:.1%} | \"\n","          f\"Stage-1 logit coverage: train {info['avail_fit']:.1%}, val {info['avail_app']:.1%}\")\n","    if info[\"avail_fit\"] == 0.0 and info[\"avail_app\"] == 0.0:\n","        warnings.warn(\n","            f\"[fold {fold_idx}] Stage-1 logit is constant — the two-stage input is inert.\",\n","            RuntimeWarning,\n","        )\n","\n","    # --- Time-ordered inner split, positional over the training window ---\n","    dt_tr = df_tr[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","    fit_m, stop_m = rows_positional_split(n_tr, dt_tr, CONFIG[\"INNER_VAL_FRAC\"])\n","    n_fit, n_stop = int(fit_m.sum()), int(stop_m.sum())\n","    y_tr = df_tr[CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","    assert n_stop >= CONFIG[\"MIN_STOP_ROWS\"], f\"fold {fold_idx}: inner stop slice too small.\"\n","    assert y_tr[stop_m].sum() >= CONFIG[\"MIN_STOP_POSITIVES\"], (\n","        f\"fold {fold_idx}: too few positives in the inner stop slice.\"\n","    )\n","    assert dt_tr[fit_m].max() <= dt_tr[stop_m].min(), \"inner split is not time-ordered.\"\n","\n","    # --- Causal predecessors over the combined train+val stream ---\n","    # Both extractors return (hist, stats) and BOTH must receive strict_time,\n","    # otherwise the card and device graphs run under different causality rules.\n","    combined = pd.concat([df_tr, df_va], ignore_index=True)\n","    dt_all = combined[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","\n","    card_hist, card_stats = extract_causal_predecessors(\n","        dt_all, combined[\"uid_card\"].to_numpy(),\n","        CONFIG[\"CARD_MAX_NEIGHBORS\"],\n","        lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","    dev_hist, dev_stats = extract_causal_predecessors(\n","        dt_all, combined[\"uid_device\"].to_numpy(),\n","        CONFIG[\"DEVICE_MAX_NEIGHBORS\"],\n","        lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","\n","    # Audit each graph against ITSELF. Auditing card twice leaves the device\n","    # graph — the denser of the two — completely unchecked.\n","    audit_predecessor_causality(dt_all, card_hist, f\"fold{fold_idx}/card\",\n","                                lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], sample=CONFIG[\"PREDECESSOR_AUDIT_SAMPLE\"], seed=CONFIG[\"SEED\"] + 10 * fold_idx + 1, strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","    audit_predecessor_causality(dt_all, dev_hist, f\"fold{fold_idx}/device\",\n","                                lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], sample=CONFIG[\"PREDECESSOR_AUDIT_SAMPLE\"], seed=CONFIG[\"SEED\"] + 10 * fold_idx + 2, strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","\n","    if CONFIG[\"STRICT_TIME_CAUSALITY\"]:\n","        tie_dropped = card_stats[\"tie_edges_skipped\"] + dev_stats[\"tie_edges_skipped\"]\n","        tie_kept = card_stats[\"total_edges\"] + dev_stats[\"total_edges\"]\n","        print(f\"    Tie policy STRICT: {tie_dropped:,} same-second edges dropped, \"\n","              f\"{tie_kept:,} kept \"\n","              f\"({tie_dropped / max(tie_dropped + tie_kept, 1):.2%} of candidates)\")\n","\n","    Z_all = np.vstack([Z_tr, Z_va])\n","    d_dim = Z_all.shape[1]\n","    agg_real = neighbour_means(Z_all, card_hist, dev_hist)\n","\n","    conn_tr = report_connectivity(agg_real[1][:n_tr], agg_real[3][:n_tr], \"train\")\n","    conn_va = report_connectivity(agg_real[1][n_tr:], agg_real[3][n_tr:], \"val\")\n","\n","    # Connectivity is defined by the REAL graph and reused for every variant, so\n","    # the connected/isolated split compares identical row populations across\n","    # arms. Recomputing it per variant would make the cohorts incomparable.\n","    has_neighbours = ((agg_real[1][n_tr:] + agg_real[3][n_tr:]) > 0).ravel()\n","\n","    card_overlap = entity_overlap_rate(df, train_idx, val_idx_full, \"uid_card\")\n","    device_overlap = entity_overlap_rate(df, train_idx, val_idx_full, \"uid_device\")\n","    print(f\"    Entity overlap train->val: card {card_overlap:.1%} | device {device_overlap:.1%}\")\n","\n","    # --- Per-variant aggregate tensors ---\n","    variant_aggs: dict[str, tuple[np.ndarray, ...]] = {\"real\": agg_real}\n","    if CONFIG[\"RUN_NULL_CONTROL\"]:\n","        # strict_time must match the real graph, or the null may draw\n","        # same-second edges the real graph is forbidden — biasing N2.\n","        null_card = time_matched_null_predecessors(\n","            dt_all, card_hist, CONFIG[\"SEED\"] + fold_idx,\n","            lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","        null_dev = time_matched_null_predecessors(\n","            dt_all, dev_hist, CONFIG[\"SEED\"] + 100 + fold_idx,\n","            lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","        audit_predecessor_causality(dt_all, null_card, f\"fold{fold_idx}/null_card\",\n","                                    lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], sample=CONFIG[\"PREDECESSOR_AUDIT_SAMPLE\"], seed=CONFIG[\"SEED\"] + 10 * fold_idx + 3, strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","        variant_aggs[\"null\"] = neighbour_means(Z_all, null_card, null_dev)\n","        del null_card, null_dev\n","    if CONFIG[\"RUN_NO_GRAPH_ABLATION\"]:\n","        variant_aggs[\"no_graph\"] = blank_aggs(len(combined), d_dim)\n","\n","    del card_hist, dev_hist, combined\n","    gc.collect()\n","\n","    y_fit, y_stop = y_tr[fit_m], y_tr[stop_m]\n","    amt_va_full = df_va[CONFIG[\"AMOUNT_COLUMN\"]].to_numpy()\n","    first_seen_full = df_va[\"card_first_seen\"].to_numpy()\n","\n","    # Evaluation subsets, fixed once so every variant is scored identically.\n","    y_va = y_va_full[embargo_keep]\n","    amt_va = amt_va_full[embargo_keep]\n","    conn_sub = has_neighbours[embargo_keep]\n","    first_seen_sub = first_seen_full[embargo_keep]\n","\n","    for variant in VARIANTS:\n","        print(f\"    -- variant: {variant.upper()} --\")\n","        agg_v = variant_aggs[variant]\n","        agg_tr = slice_aggs(agg_v, 0, n_tr)\n","        agg_va = slice_aggs(agg_v, n_tr, n_tr + n_va)\n","\n","        probs_full, calibrator, minfo = train_multiseed(\n","            Z_tr[fit_m], tuple(a[fit_m] for a in agg_tr), y_fit,\n","            Z_tr[stop_m], tuple(a[stop_m] for a in agg_tr), y_stop,\n","            Z_va, agg_va, label=variant,\n","        )\n","        probs_cal_full = apply_calibrator(calibrator, probs_full)\n","\n","        # Store FULL-block scores for Pass B; evaluate on the embargoed subset only.\n","        full_block_probs[variant][val_idx_full] = probs_full\n","        full_block_cal[variant][val_idx_full] = probs_cal_full\n","        if variant == \"real\":\n","            oof_source[val_idx_full] = f\"forward_fold_{fold_idx}\"\n","\n","        p_raw = probs_full[embargo_keep]\n","        p_cal = probs_cal_full[embargo_keep]\n","\n","        m_raw = compute_metrics(y_va, p_raw, amt_va)\n","        m_cal = compute_metrics(y_va, p_cal, amt_va)\n","\n","        record = {\n","            \"variant\": variant,\n","            \"fold\": fold_idx,\n","            \"val_block\": val_block,\n","            \"n_fit\": n_fit,\n","            \"n_stop\": n_stop,\n","            \"n_val\": int(embargo_keep.sum()),\n","            \"n_val_embargoed_out\": int(n_va - embargo_keep.sum()),\n","            \"n_seeds\": minfo[\"n_seeds\"],\n","            \"best_epochs\": str(minfo[\"best_epochs\"]),\n","            \"inner_ap_mean\": minfo[\"inner_ap_mean\"],\n","            \"inner_ap_std\": minfo[\"inner_ap_std\"],\n","            \"val_fraud_rate\": float(y_va.mean()),\n","            \"AP_connected\": subset_ap(y_va, p_raw, conn_sub),\n","            \"AP_isolated\": subset_ap(y_va, p_raw, ~conn_sub),\n","            \"AP_new_entity\": subset_ap(y_va, p_raw, first_seen_sub),\n","            \"AP_seen_entity\": subset_ap(y_va, p_raw, ~first_seen_sub),\n","            \"connected_share\": float(conn_sub.mean()),\n","            \"first_seen_share\": float(first_seen_sub.mean()),\n","            \"card_overlap_rate\": card_overlap,\n","            \"device_overlap_rate\": device_overlap,\n","            \"AP_calibrated\": m_cal[\"AP\"],\n","            \"ECE_calibrated\": m_cal[\"ECE\"],\n","            \"ECE_quantile_calibrated\": m_cal[\"ECE_quantile\"],\n","            \"Brier_calibrated\": m_cal[\"Brier\"],\n","            \"Loss_cost_rule_calibrated\": m_cal[\"Loss_cost_rule\"],\n","            \"AlertRate_calibrated\": m_cal[\"AlertRate\"],\n","            **m_raw,\n","        }\n","        if variant == \"real\" and fold_idx in STAGE2_AP:\n","            record[\"delta_32_cross_run\"] = m_raw[\"AP\"] - STAGE2_AP[fold_idx]\n","        fold_results.append(record)\n","\n","        print(f\"       AP {m_raw['AP']:.4f} | ROC-AUC {m_raw['ROC_AUC']:.4f} | \"\n","              f\"R@0.1%FPR {m_raw['Recall@0.1%FPR']:.2%} | \"\n","              f\"connected {record['AP_connected']:.4f} / isolated {record['AP_isolated']:.4f}\")\n","        print(f\"       ECE_q {m_raw['ECE_quantile']:.5f} -> {m_cal['ECE_quantile']:.5f} | \"\n","              f\"cost-rule loss ${m_raw['Loss_cost_rule']:,.0f} -> ${m_cal['Loss_cost_rule']:,.0f}\")\n","\n","    diagnostics.append({\n","        \"fold\": fold_idx,\n","        \"val_block\": val_block,\n","        \"connectivity_train\": conn_tr,\n","        \"connectivity_val\": conn_va,\n","        \"card_overlap_rate\": card_overlap,\n","        \"device_overlap_rate\": device_overlap,\n","        \"share_first_seen_card\": float(first_seen_full.mean()),\n","        \"stage1_logit_coverage_val\": info[\"avail_app\"],\n","        \"pca_explained\": info[\"pca_explained\"],\n","        \"strict_time_causality\": bool(CONFIG[\"STRICT_TIME_CAUSALITY\"]),\n","        \"card_tie_edges_skipped\": int(card_stats[\"tie_edges_skipped\"]),\n","        \"device_tie_edges_skipped\": int(dev_stats[\"tie_edges_skipped\"]),\n","        \"card_edges_kept\": int(card_stats[\"total_edges\"]),\n","        \"device_edges_kept\": int(dev_stats[\"total_edges\"]),\n","        \"predecessor_audits\": json.dumps([\n","            audit for audit in predecessor_audits\n","            if audit[\"label\"].startswith(f\"fold{fold_idx}/\")\n","        ], sort_keys=True),\n","        **{f\"shift_{k}\": v for k, v in shift.items()},\n","    })\n","\n","    del Z_all, Z_tr, Z_va, agg_real, variant_aggs\n","    gc.collect()\n","\n","results_df = pd.DataFrame(fold_results)\n","diag_df = pd.DataFrame(diagnostics)\n","\n","# Seed noise is already carried per-row in results_df; derive rather than\n","# maintain a parallel list that can drift out of sync.\n","seed_noise_df = results_df[[\"fold\", \"variant\", \"inner_ap_std\"]].copy()"]},{"cell_type":"code","execution_count":10,"id":"ff25c509","metadata":{"execution":{"iopub.execute_input":"2026-10-01T03:37:15.618892Z","iopub.status.busy":"2026-10-01T03:37:15.618287Z","iopub.status.idle":"2026-10-01T03:43:46.607354Z","shell.execute_reply":"2026-10-01T03:43:46.606565Z"},"papermill":{"duration":391.002574,"end_time":"2026-10-01T03:43:46.614202+00:00","exception":false,"start_time":"2026-10-01T03:37:15.611628+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[4] Generating Stage-3 scores for the remaining blocks (feature-generation pass)...\n","    Block 1: expanding sub-folds K=4 (sizes [29527, 29527, 29527, 29527]) -> 75% coverage vs. 50% under the v1 half-split.\n","    Each sub-fold early-stops on its own disjoint tail slice (v1 stopped on its training set).\n","      causality audit [b1_subfold1/card]: PASSED (STRICT) 20,000 nodes sampled (requested 20,000), lookback=2592000s, seed=1053, 21,505 edges checked\n","      causality audit [b1_subfold1/device]: PASSED (STRICT) 20,000 nodes sampled (requested 20,000), lookback=2592000s, seed=1054, 96,247 edges checked\n","      b1_subfold_1: seeds 3 | epochs [8, 3, 13] | inner AP 0.3928 +/- 0.0215\n","      sub-fold 1: train 29,527 -> score 29,527\n","      causality audit [b1_subfold2/card]: PASSED (STRICT) 20,000 nodes sampled (requested 20,000), lookback=2592000s, seed=1063, 26,879 edges checked\n","      causality audit [b1_subfold2/device]: PASSED (STRICT) 20,000 nodes sampled (requested 20,000), lookback=2592000s, seed=1064, 96,258 edges checked\n","      b1_subfold_2: seeds 3 | epochs [19, 19, 17] | inner AP 0.3738 +/- 0.0231\n","      sub-fold 2: train 59,054 -> score 29,527\n","      causality audit [b1_subfold3/card]: PASSED (STRICT) 20,000 nodes sampled (requested 20,000), lookback=2592000s, seed=1073, 30,390 edges checked\n","      causality audit [b1_subfold3/device]: PASSED (STRICT) 20,000 nodes sampled (requested 20,000), lookback=2592000s, seed=1074, 96,738 edges checked\n","      b1_subfold_3: seeds 3 | epochs [18, 4, 11] | inner AP 0.5304 +/- 0.0169\n","      sub-fold 3: train 88,581 -> score 29,527\n","      slice 0 (29,527 rows) intentionally unscored — no prior data exists. Flagged, not silently NaN.\n","      Block 1 tie policy STRICT: 4,119 same-second edges dropped.\n","    Block 5 (sealed OOT): fitting frozen production model on Blocks 1-4...\n","    [WARNING] Representation shift (frozen_oot): max |mean diff| 9.564 across 47 dims | 12 dim(s) > 0.75\n","    OOT Stage-1 logit coverage: 100.0%\n","      causality audit [frozen_oot/card]: PASSED (STRICT) 20,000 nodes sampled (requested 20,000), lookback=2592000s, seed=2043, 39,570 edges checked\n","      causality audit [frozen_oot/device]: PASSED (STRICT) 20,000 nodes sampled (requested 20,000), lookback=2592000s, seed=2044, 97,598 edges checked\n","    Frozen-OOT tie policy STRICT: 10,821 same-second edges dropped.\n","      frozen_oot: seeds 3 | epochs [7, 2, 5] | inner AP 0.5441 +/- 0.0039\n","      Scored 118,108 OOT rows. OOT target NOT read; no OOT metric is computed in Stage 3.\n"]},{"data":{"text/plain":["0"]},"execution_count":10,"metadata":{},"output_type":"execute_result"}],"source":["# ==============================================================================\n","# 9. PASS B — Block 1 sub-folds and sealed-OOT scoring\n","# ==============================================================================\n","print(\"\\n[4] Generating Stage-3 scores for the remaining blocks (feature-generation pass)...\")\n","\n","# --- 9a. Block 1 via expanding chronological sub-folds -----------------------\n","k_sub = CONFIG[\"B1_SUBFOLDS\"]\n","b1_idx = df.index[df[\"chrono_block\"] == 1].to_numpy()\n","slices = np.array_split(b1_idx, k_sub)\n","print(f\"    Block 1: expanding sub-folds K={k_sub} (sizes {[len(s) for s in slices]}) \"\n","      f\"-> {(k_sub - 1) / k_sub:.0%} coverage vs. 50% under the v1 half-split.\")\n","print(\"    Each sub-fold early-stops on its own disjoint tail slice \"\n","      \"(v1 stopped on its training set).\")\n","\n","b1_tie_skipped = 0\n","b1_skipped_subfolds: list[int] = []\n","\n","for s in range(1, k_sub):\n","    sub_train = np.concatenate(slices[:s])\n","    sub_score = slices[s]\n","    assert_causal(df, sub_train, sub_score, f\"b1_subfold{s}\")\n","\n","    df_sub_tr = df.loc[sub_train].reset_index(drop=True)\n","    df_sub_sc = df.loc[sub_score].reset_index(drop=True)\n","\n","    Z_sub_tr, Z_sub_sc, _ = build_neural_features(df_sub_tr, df_sub_sc, v_cols, num_cols,\n","                                                  CONFIG[\"N_PCA\"])\n","    dt_sub_tr = df_sub_tr[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","    fit_m, stop_m = rows_positional_split(len(df_sub_tr), dt_sub_tr, CONFIG[\"INNER_VAL_FRAC\"])\n","    y_sub_tr = df_sub_tr[CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","\n","    if int(stop_m.sum()) < 500 or y_sub_tr[stop_m].sum() < 5:\n","        print(f\"      sub-fold {s}: stop slice too thin — skipped, rows left unscored.\")\n","        oof_source[sub_score] = f\"b1_subfold_{s}_unscored\"\n","        b1_skipped_subfolds.append(s)\n","        continue\n","\n","    sub_combined = pd.concat([df_sub_tr, df_sub_sc], ignore_index=True)\n","    dt_sub = sub_combined[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","\n","    # Both extractors return (hist, stats); both must receive strict_time so the\n","    # sub-fold graphs obey the same causality rule as Pass A.\n","    ch, ch_stats = extract_causal_predecessors(\n","        dt_sub, sub_combined[\"uid_card\"].to_numpy(),\n","        CONFIG[\"CARD_MAX_NEIGHBORS\"],\n","        lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","    dh, dh_stats = extract_causal_predecessors(\n","        dt_sub, sub_combined[\"uid_device\"].to_numpy(),\n","        CONFIG[\"DEVICE_MAX_NEIGHBORS\"],\n","        lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","\n","    # Pass A audits every graph it builds; these sub-fold graphs feed the\n","    # exported Block-1 scores, so they get the same treatment.\n","    audit_predecessor_causality(dt_sub, ch, f\"b1_subfold{s}/card\",\n","                                lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], sample=CONFIG[\"PREDECESSOR_AUDIT_SAMPLE\"], seed=CONFIG[\"SEED\"] + 1000 + 10 * s + 1, strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","    audit_predecessor_causality(dt_sub, dh, f\"b1_subfold{s}/device\",\n","                                lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], sample=CONFIG[\"PREDECESSOR_AUDIT_SAMPLE\"], seed=CONFIG[\"SEED\"] + 1000 + 10 * s + 2, strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","    b1_tie_skipped += ch_stats[\"tie_edges_skipped\"] + dh_stats[\"tie_edges_skipped\"]\n","\n","    Z_sub_all = np.vstack([Z_sub_tr, Z_sub_sc])\n","    agg_sub = neighbour_means(Z_sub_all, ch, dh)\n","    n_sub_tr = len(df_sub_tr)\n","    agg_sub_tr = slice_aggs(agg_sub, 0, n_sub_tr)\n","    agg_sub_sc = slice_aggs(agg_sub, n_sub_tr, n_sub_tr + len(df_sub_sc))\n","\n","    probs_sub, cal_sub, _ = train_multiseed(\n","        Z_sub_tr[fit_m], tuple(a[fit_m] for a in agg_sub_tr), y_sub_tr[fit_m],\n","        Z_sub_tr[stop_m], tuple(a[stop_m] for a in agg_sub_tr), y_sub_tr[stop_m],\n","        Z_sub_sc, agg_sub_sc, label=f\"b1_subfold_{s}\",\n","    )\n","    full_block_probs[\"real\"][sub_score] = probs_sub\n","    full_block_cal[\"real\"][sub_score] = apply_calibrator(cal_sub, probs_sub)\n","    oof_source[sub_score] = f\"b1_subfold_{s}\"\n","    print(f\"      sub-fold {s}: train {len(sub_train):,} -> score {len(sub_score):,}\")\n","\n","    del Z_sub_all, Z_sub_tr, Z_sub_sc, agg_sub, ch, dh, sub_combined\n","    gc.collect()\n","\n","oof_source[slices[0]] = \"b1_seed_unscored\"\n","print(f\"      slice 0 ({len(slices[0]):,} rows) intentionally unscored — no prior \"\n","      \"data exists. Flagged, not silently NaN.\")\n","if CONFIG[\"STRICT_TIME_CAUSALITY\"]:\n","    print(f\"      Block 1 tie policy STRICT: {b1_tie_skipped:,} same-second edges dropped.\")\n","\n","# --- 9b. Block 5 (sealed OOT) via a frozen model fit on Blocks 1-4 -----------\n","print(\"    Block 5 (sealed OOT): fitting frozen production model on Blocks 1-4...\")\n","dev_idx = df.index[df[\"chrono_block\"].isin(CONFIG[\"DEV_BLOCKS\"])].to_numpy()\n","oot_idx = df.index[df[\"chrono_block\"] == CONFIG[\"OOT_BLOCK\"]].to_numpy()\n","assert not (set(dev_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row inside development index.\"\n","assert_causal(df, dev_idx, oot_idx, \"frozen_oot\")\n","\n","df_dev = df.loc[dev_idx].reset_index(drop=True)\n","df_oot = df.loc[oot_idx].reset_index(drop=True)\n","\n","Z_dev, Z_oot, oot_info = build_neural_features(df_dev, df_oot, v_cols, num_cols, CONFIG[\"N_PCA\"])\n","oot_shift = check_representation_shift(Z_dev, Z_oot, \"frozen_oot\")\n","print(f\"    OOT Stage-1 logit coverage: {oot_info['avail_app']:.1%}\")\n","\n","dt_dev = df_dev[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","fit_m, stop_m = rows_positional_split(len(df_dev), dt_dev, CONFIG[\"INNER_VAL_FRAC\"])\n","y_dev = df_dev[CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","assert int(stop_m.sum()) >= CONFIG[\"MIN_STOP_ROWS\"], \"frozen_oot: inner stop slice too small.\"\n","assert y_dev[stop_m].sum() >= CONFIG[\"MIN_STOP_POSITIVES\"], (\n","    \"frozen_oot: too few positives in the inner stop slice.\"\n",")\n","\n","dev_oot = pd.concat([df_dev, df_oot], ignore_index=True)\n","dt_devoot = dev_oot[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","\n","ch_oot, ch_oot_stats = extract_causal_predecessors(\n","    dt_devoot, dev_oot[\"uid_card\"].to_numpy(),\n","    CONFIG[\"CARD_MAX_NEIGHBORS\"],\n","    lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","dh_oot, dh_oot_stats = extract_causal_predecessors(\n","    dt_devoot, dev_oot[\"uid_device\"].to_numpy(),\n","    CONFIG[\"DEVICE_MAX_NEIGHBORS\"],\n","    lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","\n","audit_predecessor_causality(dt_devoot, ch_oot, \"frozen_oot/card\",\n","                            lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], sample=CONFIG[\"PREDECESSOR_AUDIT_SAMPLE\"], seed=CONFIG[\"SEED\"] + 2001, strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","audit_predecessor_causality(dt_devoot, dh_oot, \"frozen_oot/device\",\n","                            lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], sample=CONFIG[\"PREDECESSOR_AUDIT_SAMPLE\"], seed=CONFIG[\"SEED\"] + 2002, strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","\n","if CONFIG[\"STRICT_TIME_CAUSALITY\"]:\n","    oot_ties = ch_oot_stats[\"tie_edges_skipped\"] + dh_oot_stats[\"tie_edges_skipped\"]\n","    print(f\"    Frozen-OOT tie policy STRICT: {oot_ties:,} same-second edges dropped.\")\n","\n","Z_devoot = np.vstack([Z_dev, Z_oot])\n","agg_devoot = neighbour_means(Z_devoot, ch_oot, dh_oot)\n","n_dev = len(df_dev)\n","agg_dev = slice_aggs(agg_devoot, 0, n_dev)\n","agg_oot = slice_aggs(agg_devoot, n_dev, n_dev + len(df_oot))\n","\n","probs_oot, cal_oot, oot_minfo = train_multiseed(\n","    Z_dev[fit_m], tuple(a[fit_m] for a in agg_dev), y_dev[fit_m],\n","    Z_dev[stop_m], tuple(a[stop_m] for a in agg_dev), y_dev[stop_m],\n","    Z_oot, agg_oot, label=\"frozen_oot\",\n",")\n","full_block_probs[\"real\"][oot_idx] = probs_oot\n","full_block_cal[\"real\"][oot_idx] = apply_calibrator(cal_oot, probs_oot)\n","oof_source[oot_idx] = \"frozen_oot_model\"\n","print(f\"      Scored {len(oot_idx):,} OOT rows. OOT target NOT read; \"\n","      \"no OOT metric is computed in Stage 3.\")\n","\n","del Z_devoot, Z_dev, Z_oot, agg_devoot, agg_dev, agg_oot, ch_oot, dh_oot, dev_oot\n","gc.collect()"]},{"cell_type":"code","execution_count":11,"id":"b7c191bb","metadata":{"execution":{"iopub.execute_input":"2026-10-01T03:43:46.628079Z","iopub.status.busy":"2026-10-01T03:43:46.627807Z","iopub.status.idle":"2026-10-01T03:43:50.070615Z","shell.execute_reply":"2026-10-01T03:43:50.069691Z"},"papermill":{"duration":3.451792,"end_time":"2026-10-01T03:43:50.072183+00:00","exception":false,"start_time":"2026-10-01T03:43:46.620391+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[5] Missingness policy: 29,527 unscored rows filled with seed-slice prior 0.02879 and flagged.\n","    Never fill with 0.0 — that asserts 'certainly legitimate', which is false and would distort any downstream aggregation.\n","    Saved: ./artifacts/stage3_oof_predictions.csv\n","    Stage-3 score coverage by block:\n","      Block 1: 75.0%\n","      Block 2: 100.0%\n","      Block 3: 100.0%\n","      Block 4: 100.0%\n","      Block 5: 100.0% (Sealed OOT — frozen model)\n"]}],"source":["# ==============================================================================\n","# 10. Missingness Policy & OOF Manifest Export\n","# ==============================================================================\n","\n","def validate_oof_export(export: pd.DataFrame, internal_raw: np.ndarray,\n","                        internal_cal: np.ndarray, prior: float,\n","                        block_slices: list[np.ndarray], forward_folds: list,\n","                        skipped_subfolds: list[int]) -> None:\n","    \"\"\"Assert missingness, exact prior-fill and row-level provenance before export.\"\"\"\n","    assert len(export) == len(df), \"OOF row count mismatch\"\n","    assert np.array_equal(export[\"TransactionID\"].to_numpy(), df[CONFIG[\"ID_COLUMN\"]].to_numpy()), (\n","        \"OOF ID order mismatch\"\n","    )\n","    blocks = export[\"chrono_block\"].to_numpy()\n","    assert np.array_equal(blocks, df[\"chrono_block\"].to_numpy()), \"OOF block mismatch\"\n","    raw = export[\"stage3_prob_raw\"].to_numpy()\n","    missing = export[\"stage3_missing\"].to_numpy()\n","    available = export[\"stage3_available\"].to_numpy()\n","    assert missing.dtype.kind == available.dtype.kind == \"b\", \"OOF flags must be Boolean\"\n","    assert np.array_equal(missing, np.isnan(raw)), \"OOF raw missingness mismatch\"\n","    assert np.array_equal(available, ~missing), \"OOF availability mismatch\"\n","    assert np.array_equal(raw, internal_raw, equal_nan=True), \"OOF raw/internal mismatch\"\n","    assert (np.isfinite(raw[available]) & (raw[available] >= 0) & (raw[available] <= 1)).all(), (\n","        \"Invalid available raw probabilities\"\n","    )\n","    assert np.isfinite(prior) and 0 <= prior <= 1, \"Invalid seed prior\"\n","    filled = export[\"stage3_prob_filled\"].to_numpy()\n","    assert np.isfinite(filled).all(), \"Nonfinite filled probabilities\"\n","    assert np.array_equal(filled, np.where(missing, prior, raw).astype(np.float32)), (\n","        \"OOF fill is not the existing seed prior/raw policy\"\n","    )\n","    assert np.array_equal(np.isnan(internal_cal), missing), \"Internal calibration missingness mismatch\"\n","    assert (np.isfinite(internal_cal[available]) & (internal_cal[available] >= 0)\n","            & (internal_cal[available] <= 1)).all(), \"Invalid internal calibration\"\n","    calibrated = export[\"stage3_prob_calibrated\"].to_numpy()\n","    if CONFIG[\"EXPORT_CALIBRATED_OOF\"]:\n","        assert np.array_equal(np.isnan(calibrated), missing), \"Export calibration missingness mismatch\"\n","        assert np.array_equal(calibrated, internal_cal, equal_nan=True), \"Export calibration mismatch\"\n","    else:\n","        assert np.isnan(calibrated).all(), \"Disabled calibrated export must be all NaN\"\n","\n","    expected_source = np.full(len(export), \"none\", dtype=object)\n","    expected_available = np.zeros(len(export), dtype=bool)\n","    assert len(block_slices) == CONFIG[\"B1_SUBFOLDS\"], \"B1 provenance slice count mismatch\"\n","    expected_source[block_slices[0]] = \"b1_seed_unscored\"\n","    assert set(skipped_subfolds) <= set(range(1, CONFIG[\"B1_SUBFOLDS\"])), \"Invalid skipped B1 slice\"\n","    for s in range(1, CONFIG[\"B1_SUBFOLDS\"]):\n","        unscored = s in skipped_subfolds\n","        idx = block_slices[s]\n","        assert (blocks[idx] == 1).all(), \"B1 provenance block mismatch\"\n","        expected_source[idx] = f\"b1_subfold_{s}\" + (\"_unscored\" if unscored else \"\")\n","        expected_available[idx] = not unscored\n","    assert (blocks[block_slices[0]] == 1).all(), \"Seed provenance block mismatch\"\n","    for fold_idx, (_, val_block) in enumerate(forward_folds, 1):\n","        idx = blocks == val_block\n","        expected_source[idx] = f\"forward_fold_{fold_idx}\"\n","        expected_available[idx] = True\n","    oot = blocks == CONFIG[\"OOT_BLOCK\"]\n","    expected_source[oot] = \"frozen_oot_model\"\n","    expected_available[oot] = True\n","    assert (expected_source != \"none\").all(), \"Unexplained provenance\"\n","    assert np.array_equal(export[\"stage3_source\"].to_numpy(), expected_source), (\n","        \"Source provenance does not match actual folds/seed/skipped slices/OOT\"\n","    )\n","    assert np.array_equal(available, expected_available), \"Provenance/availability mismatch\"\n","\n","\n","real_probs = full_block_probs[\"real\"]\n","missing_mask = np.isnan(real_probs)\n","seed_prior = float(df.loc[slices[0], CONFIG[\"TARGET_COLUMN\"]].mean())\n","print(f\"\\n[5] Missingness policy: {missing_mask.sum():,} unscored rows filled with \"\n","      f\"seed-slice prior {seed_prior:.5f} and flagged.\")\n","print(\"    Never fill with 0.0 — that asserts 'certainly legitimate', which is false \"\n","      \"and would distort any downstream aggregation.\")\n","\n","oof_export_df = pd.DataFrame({\n","    \"TransactionID\": df[CONFIG[\"ID_COLUMN\"]].values,\n","    \"chrono_block\": df[\"chrono_block\"].values,\n","    \"stage3_prob_raw\": real_probs,\n","    \"stage3_prob_calibrated\": (full_block_cal[\"real\"]\n","                               if CONFIG[\"EXPORT_CALIBRATED_OOF\"] else np.nan),\n","    \"stage3_prob_filled\": np.where(missing_mask, seed_prior, real_probs).astype(np.float32),\n","    \"stage3_available\": ~missing_mask,\n","    \"stage3_missing\": missing_mask,\n","    \"stage3_source\": oof_source,\n","    \"stage3_null_prob\": full_block_probs.get(\"null\", np.full(len(df), np.nan, np.float32)),\n","    \"stage3_no_graph_prob\": full_block_probs.get(\"no_graph\", np.full(len(df), np.nan, np.float32)),\n","})\n","\n","oof_output_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage3_oof_predictions.csv\")\n","validate_oof_export(oof_export_df, full_block_probs[\"real\"], full_block_cal[\"real\"],\n","                    seed_prior, slices, folds, b1_skipped_subfolds)\n","oof_export_df.to_csv(oof_output_path, index=False)\n","print(f\"    Saved: {oof_output_path}\")\n","\n","coverage = oof_export_df.groupby(\"chrono_block\")[\"stage3_available\"].mean()\n","print(\"    Stage-3 score coverage by block:\")\n","for blk, share in coverage.items():\n","    tag = \" (Sealed OOT — frozen model)\" if blk == CONFIG[\"OOT_BLOCK\"] else \"\"\n","    print(f\"      Block {blk}: {share:.1%}{tag}\")"]},{"cell_type":"code","execution_count":12,"id":"c69e2baf","metadata":{"execution":{"iopub.execute_input":"2026-10-01T03:43:50.087246Z","iopub.status.busy":"2026-10-01T03:43:50.086795Z","iopub.status.idle":"2026-10-01T03:51:14.344693Z","shell.execute_reply":"2026-10-01T03:51:14.343868Z"},"papermill":{"duration":444.26791,"end_time":"2026-10-01T03:51:14.346838+00:00","exception":false,"start_time":"2026-10-01T03:43:50.078928+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[6] Executing paired bootstrap hypothesis tests...\n"]}],"source":["# ==============================================================================\n","# 11. Hypothesis Testing — Paired Bootstrap with FDR Control\n","# ==============================================================================\n","print(\"\\n[6] Executing paired bootstrap hypothesis tests...\")\n","\n","hypothesis_tests: list[dict] = []\n","\n","\n","def run_bootstrap_test(test_name: str, probs_new: np.ndarray, probs_ref: np.ndarray,\n","                       subset_mask_fn=None, confirmatory: bool = True) -> list[dict]:\n","    \"\"\"\n","    Paired bootstrap per fold plus a pooled development test.\n","\n","    Evaluation uses the embargoed validation rows only. Any row missing a score\n","    in either arm is dropped from BOTH so the comparison stays paired.\n","    \"\"\"\n","    records = []\n","    for fold_idx, (train_blocks, val_b) in enumerate(folds, 1):\n","        tr_idx = df.index[df[\"chrono_block\"].isin(train_blocks)].to_numpy()\n","        train_max = df.loc[tr_idx, CONFIG[\"TIME_COLUMN\"]].max()\n","        val_mask = ((df[\"chrono_block\"] == val_b)\n","                    & (df[CONFIG[\"TIME_COLUMN\"]] >= train_max + CONFIG[\"EMBARGO_SECONDS\"])).to_numpy()\n","        active = val_mask & subset_mask_fn(df) if subset_mask_fn is not None else val_mask\n","\n","        y_eval = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","        p_new, p_ref = probs_new[active], probs_ref[active]\n","        valid = ~(np.isnan(p_new) | np.isnan(p_ref))\n","        if valid.sum() < 100 or y_eval[valid].sum() < 10:\n","            continue\n","\n","        res = bootstrap_ap_delta(y_eval[valid], p_new[valid], p_ref[valid])\n","        records.append({\n","            \"test\": test_name, \"scope\": f\"fold_{fold_idx}\", \"val_block\": str(val_b),\n","            \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()),\n","            \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"],\n","            \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"],\n","        })\n","\n","    pooled = df[\"chrono_block\"].isin([2, 3, 4]).to_numpy()\n","    active = pooled & subset_mask_fn(df) if subset_mask_fn is not None else pooled\n","    y_pool = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","    p_new, p_ref = probs_new[active], probs_ref[active]\n","    valid = ~(np.isnan(p_new) | np.isnan(p_ref))\n","    if valid.sum() >= 100 and y_pool[valid].sum() >= 10:\n","        res = bootstrap_ap_delta(y_pool[valid], p_new[valid], p_ref[valid])\n","        records.append({\n","            \"test\": test_name, \"scope\": \"pooled_dev (B2-B4)\", \"val_block\": \"2-4\",\n","            \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()),\n","            \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"],\n","            \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"],\n","        })\n","    return records\n","\n","\n","# --- Confirmatory family (internal, same run, same seeds, paired rows) ---\n","if CONFIG[\"RUN_NO_GRAPH_ABLATION\"]:\n","    hypothesis_tests += run_bootstrap_test(\n","        \"H2a Message Passing (Real - NoGraph)\", real_probs, full_block_probs[\"no_graph\"]\n","    )\n","    hypothesis_tests += run_bootstrap_test(\n","        \"H2b Connected Nodes Only (Real - NoGraph)\", real_probs, full_block_probs[\"no_graph\"],\n","        subset_mask_fn=lambda d: (~d[\"card_first_seen\"]).to_numpy(),\n","    )\n","if CONFIG[\"RUN_NULL_CONTROL\"]:\n","    hypothesis_tests += run_bootstrap_test(\n","        \"N2  Time-Matched Predecessors (Real - Null)\", real_probs, full_block_probs[\"null\"]\n","    )\n","\n","# --- Exploratory cross-run comparisons (different scripts, different configs) ---\n","if STAGE2_AVAILABLE and not df[\"stage2_prob_raw\"].isna().all():\n","    hypothesis_tests += run_bootstrap_test(\n","        \"H2  S3 - S2 [CROSS-RUN]\", real_probs, df[\"stage2_prob_raw\"].to_numpy(),\n","        confirmatory=False,\n","    )\n","if STAGE1_AVAILABLE and not df[\"stage1_prob_raw\"].isna().all():\n","    hypothesis_tests += run_bootstrap_test(\n","        \"R1  S3 - S1 [CROSS-RUN]\", real_probs, df[\"stage1_prob_raw\"].to_numpy(),\n","        confirmatory=False,\n","    )\n","\n","tests_df = pd.DataFrame(hypothesis_tests)\n","\n","if not tests_df.empty:\n","    conf = tests_df[\"confirmatory\"].to_numpy()\n","    tests_df[\"p_adj\"] = np.nan\n","    tests_df[\"fdr_reject\"] = False\n","    if conf.sum() > 0:\n","        reject, p_adj = benjamini_hochberg(tests_df.loc[conf, \"p_value\"].to_numpy(),\n","                                           CONFIG[\"FDR_ALPHA\"])\n","        tests_df.loc[conf, \"p_adj\"] = p_adj\n","        tests_df.loc[conf, \"fdr_reject\"] = reject\n","\n","    def verdict_of(row) -> str:\n","        if not row[\"confirmatory\"]:\n","            return \"EXPLORATORY\"\n","        material = row[\"delta_AP\"] >= CONFIG[\"ACCEPTANCE_DELTA\"]\n","        if row[\"fdr_reject\"] and material:\n","            return \"SUPPORTED\"\n","        if row[\"fdr_reject\"]:\n","            return \"REAL BUT < THRESH\"\n","        return \"NOT SUPPORTED\"\n","\n","    tests_df[\"verdict\"] = tests_df.apply(verdict_of, axis=1)"]},{"cell_type":"code","execution_count":13,"id":"bc52b12f","metadata":{"execution":{"iopub.execute_input":"2026-10-01T03:51:14.361932Z","iopub.status.busy":"2026-10-01T03:51:14.361674Z","iopub.status.idle":"2026-10-01T03:51:14.413593Z","shell.execute_reply":"2026-10-01T03:51:14.412423Z"},"papermill":{"duration":0.061586,"end_time":"2026-10-01T03:51:14.415401+00:00","exception":false,"start_time":"2026-10-01T03:51:14.353815+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Stage exit deci