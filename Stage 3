=================\nprint(\"\\n[6] Executing paired bootstrap hypothesis tests...\")\n\nhypothesis_tests: list[dict] = []\n\n\ndef run_bootstrap_test(test_name: str, probs_new: np.ndarray, probs_ref: np.ndarray,\n                       subset_mask_fn=None, confirmatory: bool = True) -> list[dict]:\n    \"\"\"\n    Paired bootstrap per fold plus a pooled development test.\n\n    Evaluation uses the embargoed validation rows only. Any row missing a score\n    in either arm is dropped from BOTH so the comparison stays paired.\n    \"\"\"\n    records = []\n    for fold_idx, (train_blocks, val_b) in enumerate(folds, 1):\n        tr_idx = df.index[df[\"chrono_block\"].isin(train_blocks)].to_numpy()\n        train_max = df.loc[tr_idx, CONFIG[\"TIME_COLUMN\"]].max()\n        val_mask = ((df[\"chrono_block\"] == val_b)\n                    & (df[CONFIG[\"TIME_COLUMN\"]] >= train_max + CONFIG[\"EMBARGO_SECONDS\"])).to_numpy()\n        active = val_mask & subset_mask_fn(df) if subset_mask_fn is not None else val_mask\n\n        y_eval = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n        p_new, p_ref = probs_new[active], probs_ref[active]\n        valid = ~(np.isnan(p_new) | np.isnan(p_ref))\n        if valid.sum() < 100 or y_eval[valid].sum() < 10:\n            continue\n\n        res = bootstrap_ap_delta(y_eval[valid], p_new[valid], p_ref[valid])\n        records.append({\n            \"test\": test_name, \"scope\": f\"fold_{fold_idx}\", \"val_block\": str(val_b),\n            \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()),\n            \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"],\n            \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"],\n        })\n\n    pooled = df[\"chrono_block\"].isin([2, 3, 4]).to_numpy()\n    active = pooled & subset_mask_fn(df) if subset_mask_fn is not None else pooled\n    y_pool = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n    p_new, p_ref = probs_new[active], probs_ref[active]\n    valid = ~(np.isnan(p_new) | np.isnan(p_ref))\n    if valid.sum() >= 100 and y_pool[valid].sum() >= 10:\n        res = bootstrap_ap_delta(y_pool[valid], p_new[valid], p_ref[valid])\n        records.append({\n            \"test\": test_name, \"scope\": \"pooled_dev (B2-B4)\", \"val_block\": \"2-4\",\n            \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()),\n            \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"],\n            \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"],\n        })\n    return records\n\n\n# --- Confirmatory family (internal, same run, same seeds, paired rows) ---\nif CONFIG[\"RUN_NO_GRAPH_ABLATION\"]:\n    hypothesis_tests += run_bootstrap_test(\n        \"H2a Message Passing (Real - NoGraph)\", real_probs, full_block_probs[\"no_graph\"]\n    )\n    hypothesis_tests += run_bootstrap_test(\n        \"H2b Connected Nodes Only (Real - NoGraph)\", real_probs, full_block_probs[\"no_graph\"],\n        subset_mask_fn=lambda d: (~d[\"card_first_seen\"]).to_numpy(),\n    )\nif CONFIG[\"RUN_NULL_CONTROL\"]:\n    hypothesis_tests += run_bootstrap_test(\n        \"N2  Time-Matched Predecessors (Real - Null)\", real_probs, full_block_probs[\"null\"]\n    )\n\n# --- Exploratory cross-run comparisons (different scripts, different configs) ---\nif STAGE2_AVAILABLE and not df[\"stage2_prob_raw\"].isna().all():\n    hypothesis_tests += run_bootstrap_test(\n        \"H2  S3 - S2 [CROSS-RUN]\", real_probs, df[\"stage2_prob_raw\"].to_numpy(),\n        confirmatory=False,\n    )\nif STAGE1_AVAILABLE and not df[\"stage1_prob_raw\"].isna().all():\n    hypothesis_tests += run_bootstrap_test(\n        \"R1  S3 - S1 [CROSS-RUN]\", real_probs, df[\"stage1_prob_raw\"].to_numpy(),\n        confirmatory=False,\n    )\n\ntests_df = pd.DataFrame(hypothesis_tests)\n\nif not tests_df.empty:\n    conf = tests_df[\"confirmatory\"].to_numpy()\n    tests_df[\"p_adj\"] = np.nan\