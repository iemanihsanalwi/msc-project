score, agg_score))\n        stop_stack.append(infer(model, Z_stop, agg_stop))\n        epochs.append(best_ep)\n        inner_aps.append(best_ap)\n        del model\n\n    probs_score = np.mean(np.vstack(score_stack), axis=0).astype(np.float32)\n    probs_stop = np.mean(np.vstack(stop_stack), axis=0).astype(np.float32)\n    calibrator = fit_calibrator(probs_stop, y_stop)\n\n    info = {\n        \"n_seeds\": n_seeds,\n        \"best_epochs\": epochs,\n        \"inner_ap_mean\": float(np.mean(inner_aps)),\n        \"inner_ap_std\": float(np.std(inner_aps, ddof=1)) if n_seeds > 1 else 0.0,\n    }\n    print(f\"      {label}: seeds {n_seeds} | epochs {epochs} | \"\n          f\"inner AP {info['inner_ap_mean']:.4f} +/- {info['inner_ap_std']:.4f}\")\n    return probs_score, calibrator, info","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-24T08:51:54.291161Z","iopub.execute_input":"2026-09-24T08:51:54.291506Z","iopub.status.idle":"2026-09-24T08:51:54.315229Z","shell.execute_reply.started":"2026-09-24T08:51:54.291484Z","shell.execute_reply":"2026-09-24T08:51:54.314597Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"# ==============================================================================\n# 6. Data Ingestion & Temporal Structuring\n# ==============================================================================\nprint(\"[1] Resolving environment and loading raw data...\")\ndata_dir = resolve_path(CONFIG[\"CANDIDATE_DATA_DIRS\"])\nprint(f\"    Data directory: {data_dir} | Device: {DEVICE}\")\n\ntrans_df = pd.read_csv(os.path.join(data_dir, \"train_transaction.csv\"))\nid_path = os.path.join(data_dir, \"train_identity.csv\")\n\nif os.path.exists(id_path):\n    print(\"    Joining train_identity.csv via left join...\")\n    id_df = pd.read_csv(id_path)\n    df = trans_df.merge(id_df, on=CONFIG[\"ID_COLUMN\"], how=\"left\")\n    del id_df\nelse:\n    print(\"    WARNING: train_identity.csv not found. Transaction columns only.\")\