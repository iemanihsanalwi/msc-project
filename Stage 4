= df.index[df[\"chrono_block\"] == val_block].to_numpy()\n","\n","    assert not (set(train_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row in training set\"\n","    assert_causal(df, train_idx, val_idx_full, f\"fold{fold_idx}\")\n","\n","    train_max_dt = df.loc[train_idx, CONFIG[\"TIME_COLUMN\"]].max()\n","    embargo_keep = (df.loc[val_idx_full, CONFIG[\"TIME_COLUMN\"]].to_numpy() >= train_max_dt + CONFIG[\"EMBARGO_SECONDS\"])\n","\n","    df_tr = df.loc[train_idx].reset_index(drop=True)\n","    df_va = df.loc[val_idx_full].reset_index(drop=True)\n","    n_tr, n_va = len(df_tr), len(df_va)\n","\n","    Z_tr, Z_va, info = build_neural_features(df_tr, df_va, v_cols, num_cols, CONFIG[\"N_PCA\"])\n","    shift = check_representation_shift(Z_tr, Z_va, f\"fold_{fold_idx}\")\n","\n","    dt_tr = df_tr[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","    fit_m, stop_m = rows_positional_split(n_tr, dt_tr, CONFIG[\"INNER_VAL_FRAC\"])\n","    n_fit = int(fit_m.sum())\n","\n","    combined = pd.concat([df_tr, df_va], ignore_index=True)\n","    dt_all = combined[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","\n","    card_hist, card_stats = extract_causal_predecessors(dt_all, combined[\"uid_card\"].to_numpy(), CONFIG[\"CARD_MAX_NEIGHBORS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","    dev_hist, dev_stats = extract_causal_predecessors(dt_all, combined[\"uid_device\"].to_numpy(), CONFIG[\"DEVICE_MAX_NEIGHBORS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","\n","    audit_predecessor_causality(dt_all, card_hist, f\"fold{fold_idx}/card\", strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","    audit_predecessor_causality(dt_all, dev_hist, f\"fold{fold_idx}/device\", strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","\n","    y_tr = df_tr[CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","    y_fit, y_stop = y_tr[fit_m], y_tr[stop_m]\n","    y_va_full = df_va[CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","    amt_va_full = df_va[CONFIG[\"AMOUNT_COLUMN\"]].to_numpy()\n","    first_seen_full = df_va[\"card_first_seen\"].to_numpy()\n","\n","    y_va = y_va_full[embargo_keep]\n","    amt_va = amt_va_full[embargo_keep]\n","    first_seen_sub = first_seen_full[embargo_keep]\n","\n","    card_overlap = entity_overlap_rate(df, train_idx, val_idx_full, \"uid_card\")\n","    device_overlap = entity_overlap_rate(df, train_idx, val_idx_full, \"uid_device\")\n","\n","    for variant_name, blr in VARIANTS:\n","        p_full, calibrator, minfo, trained_model = train_multiseed_alternating(\n","            variant_name, blr, Z_tr, Z_va, info[\"logit_fit\"], info[\"logit_app\"],\n","            y_fit, y_stop, n_fit, n_tr, card_hist, dev_hist, len(combined)\n","        )\n","        p_cal_full = apply_calibrator(calibrator, p_full)\n","        full_block_probs[variant_name][val_idx_full] = p_full\n","        full_block_cal[variant_name][val_idx_full] = p_cal_full\n","\n","        if variant_name == \"real\":\n","            oof_source[val_idx_full] = f\"forward_fold_{fold_idx}\"\n","            pass_a_models[fold_idx] = {\"model\": trained_model, \"calibrator\": calibrator}\n","\n","        p_raw_eval = p_full[embargo_keep]\n","        p_cal_eval = p_cal_full[embargo_keep]\n","        m_raw = compute_metrics(y_va, p_raw_eval, amt_va)\n","        m_cal = compute_metrics(y_va, p_cal_eval, amt_va)\n","\n","        ap_new = average_precision_score(y_va[first_seen_sub], p_raw_eval[first_seen_sub]) if y_va[first_seen_sub].sum() > 0 else np.nan\n","        ap_seen = average_precision_score(y_va[~first_seen_sub], p_raw_eval[~first_seen_sub]) if y_va[~first_seen_sub].sum() > 0 else np.nan\n","\n","        rec = {\n","            \"variant\": variant_name,\n","            \"fold\": fold_idx,\n","            \"val_block\": val_block,\n","            \"n_fit\": n_fit,\n","            \"n_stop\": int(stop_m.sum()),\n","            \"n_val\": int(embargo_keep.sum()),\n","            \"n_val_embargoed_out\": int(n_va - embargo_keep.sum()),\n","            \"inner_ap_mean\": minfo[\"inner_