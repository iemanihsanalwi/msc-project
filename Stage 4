index(drop=True)\n","    df_sub_sc = df.loc[sub_score].reset_index(drop=True)\n","    Z_sub_tr, Z_sub_sc, sub_info = build_neural_features(df_sub_tr, df_sub_sc, v_cols, num_cols, CONFIG[\"N_PCA\"])\n","\n","    fit_m, stop_m = rows_positional_split(len(df_sub_tr), df_sub_tr[CONFIG[\"TIME_COLUMN\"]].to_numpy(), CONFIG[\"INNER_VAL_FRAC\"])\n","    y_sub_tr = df_sub_tr[CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","\n","    sub_comb = pd.concat([df_sub_tr, df_sub_sc], ignore_index=True)\n","    dt_sub = sub_comb[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","    ch, _ = extract_causal_predecessors(dt_sub, sub_comb[\"uid_card\"].to_numpy(), CONFIG[\"CARD_MAX_NEIGHBORS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","    dh, _ = extract_causal_predecessors(dt_sub, sub_comb[\"uid_device\"].to_numpy(), CONFIG[\"DEVICE_MAX_NEIGHBORS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","\n","    p_sub, cal_sub, _, _ = train_multiseed_alternating(\n","        \"real\", CONFIG[\"BOOSTING_LR\"], Z_sub_tr, Z_sub_sc, sub_info[\"logit_fit\"], sub_info[\"logit_app\"],\n","        y_sub_tr[fit_m], y_sub_tr[stop_m], int(fit_m.sum()), len(df_sub_tr), ch, dh, len(sub_comb)\n","    )\n","    full_block_probs[\"real\"][sub_score] = p_sub\n","    full_block_cal[\"real\"][sub_score] = apply_calibrator(cal_sub, p_sub)\n","    oof_source[sub_score] = f\"b1_subfold_{s}\"\n","\n","oof_source[slices[0]] = \"b1_seed_unscored\"\n","\n","# --- 9b. Block 5 (Sealed OOT) via Frozen Model fit on Blocks 1-4 ---\n","print(\"    Block 5 (Sealed OOT): Fitting frozen production model on Blocks 1-4...\")\n","dev_idx = df.index[df[\"chrono_block\"].isin(CONFIG[\"DEV_BLOCKS\"])].to_numpy()\n","oot_idx = df.index[df[\"chrono_block\"] == CONFIG[\"OOT_BLOCK\"]].to_numpy()\n","assert not (set(dev_idx.tolist()) & OOT_INDEX), \"OOT row inside development training index\"\n","assert_causal(df, dev_idx, oot_idx, \"frozen_oot\")\n","\n","df_dev = df.loc[dev_idx].reset_index(drop=True)\n","df_oot = df.loc[oot_idx].reset_ind