2, 3, 4]).to_numpy()\n","    active = pooled & subset_fn(df) if subset_fn is not None else pooled\n","    y_pool = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","    p_n, p_r = probs_new[active], probs_ref[active]\n","    valid = ~(np.isnan(p_n) | np.isnan(p_r))\n","    if valid.sum() >= 100 and y_pool[valid].sum() >= 10:\n","        res = bootstrap_ap_delta(y_pool[valid], p_n[valid], p_r[valid])\n","        records.append({\"test\": test_name, \"scope\": \"pooled_dev (B2-B4)\", \"val_block\": \"2-4\", \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()), \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"], \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"]})\n","    return records\n","\n","# Confirmatory Family (Internal, paired, identical seeds)\n","if CONFIG[\"RUN_NO_BOOST_ABLATION\"]:\n","    hypothesis_tests += run_bootstrap_test(\"H3a Alternating Boosting (Real - NoBoost)\", real_probs, full_block_probs[\"no_boost\"], confirmatory=True)\n","    if STAGE3_AVAILABLE and not df[\"stage3_prob_raw\"].isna().all():\n","        hypothesis_tests += run_bootstrap_test(\"H3b Gating Mechanism (NoBoost - S3)\", full_block_probs[\"no_boost\"], df[\"stage3_prob_raw\"].to_numpy(), confirmatory=True)\n","\n","# Exploratory Comparisons (Cross-run)\n","if STAGE3_AVAILABLE and not df[\"stage3_prob_raw\"].isna().all():\n","    hypothesis_tests += run_bootstrap_test(\"H3  Joint vs Frozen (S4 - S3) [CROSS-RUN]\", real_probs, df[\"stage3_prob_raw\"].to_numpy(), confirmatory=False)\n","if STAGE1_AVAILABLE and not df[\"stage1_prob_raw\"].isna().all():\n","    hypothesis_tests += run_bootstrap_test(\"H4  Full vs Tabular (S4 - S1) [CROSS-RUN]\", real_probs, df[\"stage1_prob_raw\"].to_numpy(), confirmatory=False)\n","\n","tests_df = pd.DataFrame(hypothesis_tests)\n","if not tests_df.empty:\n","    conf = tests_df[\"confirmatory\"].to_numpy()\n","    tests_df[\"p_adj\"] = np.nan\n","    tests_df[\"fdr_reject\"] = False\n","