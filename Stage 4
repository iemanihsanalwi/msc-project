ing_mask, seed_prior, real_probs).astype(np.float32),\n","    \"stage4_available\": ~missing_mask,\n","    \"stage4_missing\": missing_mask,\n","    \"stage4_source\": oof_source,\n","    \"stage4_no_boost_prob\": full_block_probs.get(\"no_boost\", np.full(len(df), np.nan, np.float32)),\n","})\n","\n","def validate_oof_export(export: pd.DataFrame, frame: pd.DataFrame, calibrated: np.ndarray, prior: float) -> dict:\n","    ids = export[\"TransactionID\"]\n","    assert ids.notna().all() and ids.is_unique, \"OOF IDs must be non-null and unique\"\n","    assert len(export) == len(frame) and np.array_equal(ids.to_numpy(), frame[CONFIG[\"ID_COLUMN\"]].to_numpy()), \"OOF ID/order mismatch\"\n","    assert np.array_equal(export[\"chrono_block\"].to_numpy(), frame[\"chrono_block\"].to_numpy()), \"OOF block mismatch\"\n","    raw = export[\"stage4_prob_raw\"].to_numpy()\n","    missing = np.isnan(raw)\n","    for column, expected in [(\"stage4_available\", ~missing), (\"stage4_missing\", missing)]:\n","        assert pd.api.types.is_bool_dtype(export[column]), f\"{column} is not boolean\"\n","        assert np.array_equal(export[column].to_numpy(), expected), f\"{column} mismatch\"\n","    def check_probs(prob, label):\n","        assert np.array_equal(np.isnan(prob), missing), f\"{label} missing-mask mismatch\"\n","        assert (np.isfinite(prob[~missing]) & (prob[~missing] >= 0) & (prob[~missing] <= 1)).all(), f\"{label} invalid probability\"\n","    check_probs(raw, \"raw\")\n","    check_probs(np.asarray(calibrated), \"internal calibrated\")\n","    exported_cal = export[\"stage4_prob_calibrated\"].to_numpy()\n","    if CONFIG[\"EXPORT_CALIBRATED_OOF\"]:\n","        check_probs(exported_cal, \"exported calibrated\")\n","        assert np.array_equal(exported_cal[~missing], np.asarray(calibrated)[~missing]), \"Calibration export changed\"\n","    else:\n","        assert np.isnan(exported_cal).all(), \"Disabled calibration export must be all NaN\"\n","    fill = np.float32(prior)\n","    assert np.isfinite(fill) and 0 <= fill <= 1, \"Invalid seed prior\"\n","    filled = export[\"stage4_prob_filled\"].to_numpy()\n","    assert np.array_equal(filled[~missing], raw[~missing]), \"Available score altered by fill\"\n","    assert (filled[missing] == fill).all(), \"Missing fill differs from float32 seed prior\"\n","    expected_source = np.full(len(frame), \"none\", dtype=object)\n","    b1 = frame.index[frame[\"chrono_block\"] == 1].to_numpy()\n","    b1_slices = np.array_split(b1, CONFIG[\"B1_SUBFOLDS\"])\n","    expected_missing = np.zeros(len(frame), dtype=bool)\n","    expected_missing[b1_slices[0]] = True\n","    expected_source[b1_slices[0]] = \"b1_seed_unscored\"\n","    for s in range(1, CONFIG[\"B1_SUBFOLDS\"]):\n","        expected_source[b1_slices[s]] = f\"b1_subfold_{s}\"\n","    for fold_idx, (_, val_block) in enumerate(folds, 1):\n","        expected_source[frame[\"chrono_block\"].eq(val_block).to_numpy()] = f\"forward_fold_{fold_idx}\"\n","    expected_source[frame[\"chrono_block\"].eq(CONFIG[\"OOT_BLOCK\"]).to_numpy()] = \"frozen_oot_model\"\n","    assert not (expected_source == \"none\").any(), \"Unexplained scoring scope\"\n","    assert np.array_equal(missing, expected_missing), \"Only first B1 seed slice may be unscored\"\n","    assert np.array_equal(export[\"stage4_source\"].to_numpy(), expected_source), \"Source/slice/block mismatch\"\n","    no_boost = export[\"stage4_no_boost_prob\"].to_numpy()\n","    nb_scored = ~np.isnan(no_boost)\n","    assert (np.isfinite(no_boost[nb_scored]) & (no_boost[nb_scored] >= 0) & (no_boost[nb_scored] <= 1)).all(), \"Invalid no-boost probability\"\n","    if CONFIG[\"RUN_NO_BOOST_ABLATION\"]:\n","        required = frame[\"chrono_block\"].isin([b for _, b in folds]).to_numpy()\n","        assert nb_scored[required].all(), \"No-boost B2-B4 coverage gap\"\n","    return {\"checks_passed\": True, \"missing_rows\": int(missing.sum()),\n","            \"missing_fill_value\": float(fill), \"prior_scope\": \"first chronological B1 seed slice target mean\",\n","            \"calibrated_export_enabled\": bool(CONFIG[\"EXPORT_CALIBRATED_OOF\"])}\n","\n","oof_validation = validate_oof_export(oof_export_df, df, full_block_cal[\"real\"], seed_prior)\n","\n","oof_path = os.path.join(CONFIG[\"OUTPUT_DIR\"], \"stage4_oof_predictions.csv\")\n","oof_export_df.to_csv(oof_path, index=False)\n","print(f\"    Saved OOF predictions: {oof_path}\")\n","for blk, share in oof_export_df.groupby(\"chrono_block\")[\"stage4_available\"].mean().items():\n","    print(f\"      Block {blk}: {share:.1%} coverage{' (Sealed OOT)' if blk == 5 else ''}\")"]},{"cell_type":"code","execution_count":12,"id":"a9ca8a6a","metadata":{"_cell_guid":"ae172ce0-b82f-46f1-a32e-408de6fc2e0c","_uuid":"7968d571-41ee-40ed-bf68-05cc5afce990","collapsed":false,"execution":{"iopub.execute_input":"2026-10-02T02:54:35.040384Z","iopub.status.busy":"2026-10-02T02:54:35.040019Z","iopub.status.idle":"2026-10-02T03:01:45.515067Z","shell.execute_reply":"2026-10-02T03:01:45.513772Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":430.491276,"end_time":"2026-10-02T03:01:45.518155+00:00","exception":false,"start_time":"2026-10-02T02:54:35.026879+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[5] Executing Paired Bootstrap Hypothesis Tests...\n"]}],"source":["# ==============================================================================\n","# 11. Decomposed Hypothesis Testing with FDR Control\n","# ==============================================================================\n","print(\"\\n[5] Executing Paired Bootstrap Hypothesis Tests...\")\n","hypothesis_tests = []\n","\n","def run_bootstrap_test(test_name: str, probs_new: np.ndarray, probs_ref: np.ndarray, subset_fn=None, confirmatory: bool = True) -> list[dict]:\n","    records = []\n","    pooled = np.zeros(len(df), dtype=bool)\n","    aligned_fold_counts = []\n","    subset = np.asarray(subset_fn(df), dtype=bool) if subset_fn is not None else np.ones(len(df), dtype=bool)\n","    paired_valid = np.isfinite(probs_new) & np.isfinite(probs_ref)\n","    for fold_idx, (train_b, val_b) in enumerate(folds, 1):\n","        tr_idx = df.index[df[\"chrono_block\"].isin(train_b)].to_numpy()\n","        tr_max = df.loc[tr_idx, CONFIG[\"TIME_COLUMN\"]].max()\n","        val_mask = ((df[\"chrono_block\"] == val_b) & (df[CONFIG[\"TIME_COLUMN\"]] >= tr_max + CONFIG[\"EMBARGO_SECONDS\"])).to_numpy()\n","        assert not (pooled & val_mask).any(), \"Fold evaluation masks must be disjoint\"\n","        pooled |= val_mask\n","        active = val_mask & subset\n","\n","        y_eval = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","        p_n, p_r = probs_new[active], probs_ref[active]\n","        valid = paired_valid[active]\n","        aligned_fold_counts.append(int(valid.sum()))\n","        if valid.sum() < 100 or y_eval[valid].sum() < 10:\n","            continue\n","        res = bootstrap_ap_delta(y_eval[valid], p_n[valid], p_r[valid])\n","        records.append({\"test\": test_name, \"scope\": f\"fold_{fold_idx}\", \"val_block\": str(val_b), \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()), \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"], \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"]})\n","\n","    active = pooled & subset\n","    y_pool = df.loc[active, CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","    p_n, p_r = probs_new[active], probs_ref[active]\n","    valid = paired_valid[active]\n","    assert int(valid.sum()) == sum(aligned_fold_counts), \"Pooled aligned rows differ from exact fold union\"\n","    if valid.sum() >= 100 and y_pool[valid].sum() >= 10:\n","        res = bootstrap_ap_delta(y_pool[valid], p_n[valid], p_r[valid])\n","        records.append({\"test\": test_name, \"scope\": \"pooled_dev (B2-B4)\", \"val_block\": \"2-4\", \"confirmatory\": confirmatory, \"n_evaluated\": int(valid.sum()), \"delta_AP\": res[\"delta\"], \"ci_low\": res[\"ci_low\"], \"ci_high\": res[\"ci_high\"], \"p_win\": res[\"p_win\"], \"p_value\": res[\"p_value\"]})\n","    return records\n","\n","# Confirmatory Family (Internal, paired, identical seeds)\n","if CONFIG[\"RUN_NO_BOOST_ABLATION\"]:\n","    hypothesis_tests += run_bootstrap_test(\"H3a Alternating Boosting (Real - NoBoost)\", real_probs, full_block_probs[\"no_boost\"], confirmatory=True)\n","    if STAGE3_AVAILABLE and not df[\"stage3_prob_raw\"].isna().all():\n","        hypothesis_tests += run_bootstrap_test(\"H3b Gating Mechanism (NoBoost - S3)\", full_block_probs[\"no_boost\"], df[\"stage3_prob_raw\"].to_numpy(), confirmatory=True)\n","\n","# Exploratory Comparisons (Cross-run)\n","if STAGE3_AVAILABLE and not df[\"stage3_prob_raw\"].isna().all():\n","    hypothesis_tests += run_bootstrap_test(\"H3  Joint vs Frozen (S4 - S3) [CROSS-RUN]\", real_probs, df[\"stage3_prob_raw\"].to_numpy(), confirmatory=False)\n","if STAGE1_AVAILABLE and not df[\"stage1_prob_raw\"].isna().all():\n","    hypothesis_tests += run_bootstrap_test(\"H4  Full vs Tabular (S4 - S1) [CROSS-RUN]\", real_probs, df[\"stage1_prob_raw\"].to_numpy(), confirmatory=False)\n","\n","tests_df = pd.DataFrame(hypothesis_tests)\n","if not tests_df.empty:\n","    conf = tests_df[\"confirmatory\"].to_numpy()\n","    tests_df[\"p_adj\"] = np.nan\n","    tests_df[\"fdr_reject\"] = False\n","    if conf.sum() > 0:\n","        reject, p_adj = benjamini_hochberg(tests_df.loc[conf, \"p_value\"].to_numpy(), CONFIG[\"FDR_ALPHA\"])\n","        tests_df.loc[conf, \"p_adj\"] = p_adj\n","        tests_df.loc[conf, \"fdr_reject\"] = reject\n","\n","    def verdict_of(row):\n","        if not row[\"confirmatory\"]:\n","            return \"EXPLORATORY\"\n","        material = row[\"delta_AP\"] >= CONFIG[\"ACCEPTANCE_DELTA\"]\n","        return \"SUPPORTED\" if (row[\"fdr_reject\"] and material) else (\"REAL BUT < THRESH\" if row[\"fdr_reject\"] else \"NOT SUPPORTED\")\n","\n","    tests_df[\"verdict\"] = tests_df.apply(verdict_of, axis=1)"]},{"cell_type":"code","execution_count":13,"id":"232d1565","metadata":{"_cell_guid":"2912dcb2-6042-4964-a297-ff19a0f25b91","_uuid":"b37266d1-5fb4-4b29-a432-d73393651393","collapsed":false,"execution":{"iopub.execute_input":"2026-10-02T03:01:45.542997Z","iopub.status.busy":"2026-10-02T03:01:45.542428Z","iopub.status.idle":"2026-10-02T03:01:45.598412Z","shell.execute_reply":"2026-10-02T03:01:45.597395Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":0.069675,"end_time":"2026-10-02T03:01:45.600182+00:00","exception":false,"start_time":"2026-10-02T03:01:45.530507+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","==================================================================================================================================\n","STAGE 4 ALTERNATING BGNN — VALIDATION BENCHMARK REPORT (EMBARGOED)\n","==================================================================================================================================\n"," variant  fold  val_block  n_val       AP  AP_calibrated  AP_new_entity  AP_seen_entity  mean_beta  ROC_AUC  ECE_quantile  Recall@0.1%FPR  Loss_cost_rule_calibrated\n","    real     1          2 114488 0.498443       0.462146       0.531400        0.481671   0.871274 0.859880      0.082592        0.254737              443071.401258\n","no_boost     1          2 114488 0.497310       0.469029       0.531105        0.480150   0.871216 0.859738      0.083122        0.252584              444668.437261\n","    real     2          3 114355 0.476744       0.458589       0.524806        0.455975   0.874339 0.858646      0.083438        0.234249              396075.705009\n","no_boost     2          3 114355 0.480822       0.469470       0.526285        0.460662   0.871306 0.862339      0.079557        0.236144              391464.451928\n","    real     3          4 115420 0.52375