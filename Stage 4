pipeline/artifacts/stage3_oof_predictions.csv\",\n","        \"/kaggle/input/notebooks/iemanihsan/stage-3-frozen-two-stage-res-gnn-pipeline/artifacts/stage3_oof_predictions.csv\",\n","        \"./artifacts/stage3_oof_predictions.csv\",\n","        \"stage3_oof_predictions.csv\",\n","    ],\n","    \"CANDIDATE_STAGE3_RESULTS\": [\n","        \"/kaggle/input/notebooks/iemanihsan/fork-of-stage-3-frozen-two-stage-res-gnn-pipeline/artifacts/stage3_fold_results.csv\",\n","        \"/kaggle/input/notebooks/iemanihsan/stage-3-frozen-two-stage-res-gnn-pipeline/artifacts/stage3_fold_results.csv\",\n","        \"./artifacts/stage3_fold_results.csv\",\n","        \"stage3_fold_results.csv\",\n","    ],\n","    \"OUTPUT_DIR\": \"./artifacts\",\n","}\n","\n","TARGET_LEAKAGE_COLUMNS = [\n","    \"isFraud\", \"TransactionID\", \"TransactionDT\", \"elapsed_days\", \"day_index\", \"chrono_block\"\n","]\n","AUDIT_ONLY_COLUMNS = [\n","    \"uid_card\", \"uid_device\", \"card_first_seen\", \"device_first_seen\",\n","    \"stage1_prob_raw\", \"stage1_prob_calibrated\", \"stage1_prob_filled\", \"stage1_available\", \"stage1_missing\", \"stage1_source\",\n","    \"stage2_prob_raw\", \"stage2_prob_calibrated\", \"stage2_prob_filled\", \"stage2_available\", \"stage2_missing\", \"stage2_source\",\n","    \"stage3_prob_raw\", \"stage3_prob_calibrated\", \"stage3_prob_filled\", \"stage3_available\", \"stage3_missing\", \"stage3_source\",\n","]\n","\n","DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","os.makedirs(CONFIG[\"OUTPUT_DIR\"], exist_ok=True)\n","\n","def set_global_seed(seed: int) -> None:\n","    random.seed(seed)\n","    np.random.seed(seed)\n","    torch.manual_seed(seed)\n","    if torch.cuda.is_available():\n","        torch.cuda.manual_seed_all(seed)\n","    torch.backends.cudnn.deterministic = True\n","    torch.backends.cudnn.benchmark = False\n","\n","set_global_seed(CONFIG[\"SEED\"])\n","\n","def make_grad_scaler(enabled: bool):\n","    try:\n","        return torch.amp.GradScaler(\"cuda\", enabled=enabled)\n","    except (AttributeError, TypeError):\n","        return torch.cuda.amp.GradScaler(enabled=enabled)\n","\n","def autocast_ctx(enabled: bool):\n","    try:\n","        return torch.amp.autocast(\"cuda\", enabled=enabled)\n","    except (AttributeError, TypeError):\n","        return torch.cuda.amp.autocast(enabled=enabled)"]},{"cell_type":"code","execution_count":3,"id":"8ed33de9","metadata":{"execution":{"iopub.execute_input":"2026-09-24T15:56:59.154726Z","iopub.status.busy":"2026-09-24T15:56:59.154274Z","iopub.status.idle":"2026-09-24T15:56:59.187227Z","shell.execute_reply":"2026-09-24T15:56:59.186363Z"},"papermill":{"duration":0.038867,"end_time":"2026-09-24T15:56:59.188696+00:00","exception":false,"start_time":"2026-09-24T15:56:59.149829+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================================\n","# 2. Reusable Protocol Utilities & Statistical Metrics\n","# ==============================================================================\n","def resolve_path(candidates: list[str], target_file: str | None = None) -> str:\n","    for path in candidates:\n","        check_path = os.path.join(path, target_file) if target_file else path\n","        if os.path.exists(check_path):\n","            return check_path if target_file else path\n","    raise FileNotFoundError(f\"Target {target_file or 'directory'} not found in {candidates}.\")\n","\n","def resolve_first_existing(candidates: list[str]) -> str:\n","    for path in candidates:\n","        if os.path.exists(path):\n","            return path\n","    raise FileNotFoundError(f\"None of these candidate paths exist: {candidates}\")\n","\n","def reduce_memory(frame: pd.DataFrame, label: str = \"\") -> pd.DataFrame:\n","    before = frame.memory_usage(deep=False).sum() / 1024 ** 2\n","    for col in frame.columns:\n","        kind = frame[col].dtype.kind\n","        if kind == \"i\":\n","            frame[col] = pd.to_numeric(frame[col], downcast=\"integer\")\n","        elif kind == \"f\":\n","            frame[col] = frame[col].astype(np.float32)\n","    after = frame.memory_usage(deep=False).sum() / 1024 ** 2\n","    print(f\"    Memory downcast{(' [' + label + ']') if label else ''}: {before:.1f} MB -> {after:.1f} MB ({(before - after) / max(before, 1e-9):.1%} saved)\")\n","    return frame\n","\n","def create_temporal_blocks(frame: pd.DataFrame, n_blocks: int, time_col: str = \"TransactionDT\", id_col: str = \"TransactionID\") -> pd.Series:\n","    order = frame.sort_values([time_col, id_col], kind=\"mergesort\").index\n","    position = pd.Series(np.arange(len(order)), index=order)\n","    labels = np.minimum((position.values * n_blocks) // len(order), n_blocks - 1) + 1\n","    return pd.Series(labels.astype(np.int16), index=order).reindex(frame.index)\n","\n","def alert_threshold(amounts: np.ndarray, c_rev: float = CONFIG[\"C_REVIEW\"], c_fric: float = CONFIG[\"C_FRICTION\"]) -> np.ndarray:\n","    return np.minimum((c_rev + c_fric) / (np.asarray(amounts, dtype=float) + c_fric), 1.0)\n","\n","def expected_calibration_error(y_true: np.ndarray, y_prob: np.ndarray, n_bins: int = 20, strategy: str = \"uniform\") -> float:\n","    y_true_arr = np.asarray(y_true, dtype=float)\n","    y_prob_arr = np.clip(np.asarray(y_prob, dtype=float), 0.0, 1.0)\n","    n = len(y_true_arr)\n","    if n == 0:\n","        return float(\"nan\")\n","    if strategy == \"quantile\":\n","        edges = np.unique(np.quantile(y_prob_arr, np.linspace(0.0, 1.0, n_bins + 1)))\n","        if len(edges) < 3:\n","            return expected_calibration_error(y_true_arr, y_prob_arr, n_bins, \"uniform\")\n","        bin_idx = np.clip(np.digitize(y_prob_arr, edges[1:-1], right=False), 0, len(edges) - 2)\n","        n_eff = len(edges) - 1\n","    else:\n","        bin_idx = np.clip(np.digitize(y_prob_arr, np.linspace(0.0, 1.0, n_bins + 1)[1:-1], right=False), 0, n_bins - 1)\n","        n_eff = n_bins\n","    total_error = sum(\n","        np.sum(bin_idx == b) * abs(y_prob_arr[bin_idx == b].mean() - y_true_arr[bin_idx == b].mean())\n","        for b in range(n_eff) if np.sum(bin_idx == b) > 0\n","    )\n","    return float(total_error / n)\n","\n","def compute_metrics(y_true: np.ndarray, y_prob: np.ndarray, amounts: np.ndarray, capacity: float = CONFIG[\"INVESTIGATION_CAPACITY\"]) -> dict[str, float]:\n","    y_true, y_prob, amounts = np.asarray(y_true, dtype=int), np.asarray(y_prob, dtype=float), np.asarray(amounts, dtype=float)\n","    ap = float(average_precision_score(y_true, y_prob))\n","    try:\n","        roc = float(roc_auc_score(y_true, y_prob))\n","    except ValueError:\n","        roc = float(\"nan\")\n","    p_safe = np.clip(y_prob, 1e-15, 1.0 - 1e-15)\n","    log_loss = float(-np.mean(y_true * np.log(p_safe) + (1 - y_true) * np.log(1.0 - p_safe)))\n","    brier = float(np.mean((y_prob - y_true) ** 2))\n","    ece_u = expected_calibration_error(y_true, y_prob, 20, \"uniform\")\n","    ece_q = expected_calibration_error(y_true, y_prob, 20, \"quantile\")\n","\n","    order = np.lexsort((-amounts, -y_prob))\n","    y_sorted = y_true[order]\n","    n_neg = int((y_sorted == 0).sum())\n","    n_pos = int((y_sorted == 1).sum())\n","    cum_fp = (y_sorted == 0).cumsum()\n","\n","    def recall_at_fpr(target_fpr: float) -> float:\n","        budget = int(np.floor(target_fpr * n_neg))\n","        return float(y_sorted[cum_fp <= budget].sum() / n_pos) if n_pos > 0 else 0.0\n","\n","    k_cap = max(1, int(np.floor(capacity * len(y_sorted))))\n","    prec_at_cap = float(y_sorted[:k_cap].mean())\n","    rec_at_cap = float(y_sorted[:k_cap].sum() / n_pos) if n_pos > 0 else 0.0\n","\n","    def financial_loss(preds: np.ndarray) -> float:\n","        stolen = amounts[(y_true == 1) & (preds == 0)].sum()\n","        review = preds.sum() * CONFIG[\"C_REVIEW\"]\n","        friction = ((y_true == 0) & (preds == 1)).sum() * CONFIG[\"C_FRICTION\"]\n","        return float(stolen + review + friction)\n","\n","    preds_cost = (y_prob > alert_threshold(amounts)).astype(int)\n","    return {\n","        \"AP\": ap, \"ROC_AUC\": roc, \"LogLoss\": log_loss, \"Brier\": brier,\n","        \"ECE\": ece_u, \"ECE_quantile\": ece_q,\n","        \"Recall@0.1%FPR\": recall_at_fpr(0.001), \"Recall@1.0%FPR\": recall_at_fpr(0.010),\n","        f\"Prec@{capacity:.1%}cap\": prec_at_cap, f\"Recall@{capacity:.1%}cap\": rec_at_cap,\n","        \"Loss_cost_rule\": financial_loss(preds_cost),\n","        \"Loss_flat_0.5\": financial_loss((y_prob >= 0.5).astype(int)),\n","        \"Loss_no_model\": float(amounts[y_true == 1].sum()),\n","        \"AlertRate\": float(preds_cost.mean()),\n","    }\n","\n","def bootstrap_ap_delta(y_true: np.ndarray, p_new: np.ndarray, p_ref: np.ndarray, n_boot: int = CONFIG[\"N_BOOTSTRAP\"], alpha: float = CONFIG[\"BOOTSTRAP_ALPHA\"], seed: int = CONFIG[\"SEED\"]) -> dict:\n","    y_arr, p_new_arr, p_ref_arr = np.asarray(y_true, dtype=int), np.asarray(p_new, dtype=float), np.asarray(p_ref, dtype=float)\n","    observed = float(average_precision_score(y_arr, p_new_arr) - average_precision_score(y_arr, p_ref_arr))\n","    rng = np.random.default_rng(seed)\n","    deltas, valid = np.empty(n_boot, dtype=float), 0\n","    for _ in range(n_boot):\n","        idx = rng.integers(0, len(y_arr), size=len(y_arr))\n","        if y_arr[idx].sum() in (0, len(idx)):\n","            continue\n","        deltas[valid] = average_precision_score(y_arr[idx], p_new_arr[idx]) - average_precision_score(y_arr[idx], p_ref_arr[idx])\n","        valid += 1\n","    if valid == 0:\n","        return {\"delta\": observed, \"ci_low\": np.nan, \"ci_high\": np.nan, \"p_win\": np.nan, \"p_value\": np.nan, \"n_boot\": 0}\n","    deltas = deltas[:valid]\n","    ci_low, ci_high = np.percentile(deltas, [100 * alpha / 2, 100 * (1.0 - alpha / 2)])\n","    p_win = float((deltas > 0.0).mean())\n","    p_two = float(min(1.0, max(2.0 * min(p_win, 1.0 - p_win), 1.0 / valid)))\n","    return {\"delta\": observed, \"ci_low\": float(ci_low), \"ci_high\": float(ci_high), \"p_win\": p_win, \"p_value\": p_two, \"n_boot\": valid}\n","\n","def benjamini_hochberg(p_values: np.ndarray, alpha: float) -> tuple[np.ndarray, np.ndarray]:\n","    p = np.asarray(p_values, dtype=float)\n","    if len(p) == 0:\n","        return np.array([], dtype=bool), np.array([], dtype=float)\n","    order = np.argsort(p)\n","    ranked = p[order]\n","    adj_sorted = np.minimum.accumulate((ranked * len(p) / np.arange(1, len(p) + 1))[::-1])[::-1]\n","    adjusted = np.empty(len(p), dtype=float)\n","    adjusted[order] = np.clip(adj_sorted, 0.0, 1.0)\n","    return adjusted <= alpha, adjusted\n","\n","def build_entity_uids(frame: pd.DataFrame) -> tuple[pd.Series, pd.Series]:\n","    anchor = np.where(frame[\"D1\"].isna(), \"na\", (frame[\"day_index\"] - frame[\"D1\"].fillna(0)).astype(\"int64\").astype(str))\n","    def col_str(c, f): return frame[c].fillna(f).astype(str) if c in frame.columns else pd.Series([\"na\"] * len(frame), index=frame.index)\n","    uid_card = (col_str(\"card1\", -1) + \"_\" + col_str(\"card2\", -1) + \"_\" + col_str(\"card3\", -1) + \"_\" +\n","                col_str(\"card4\", \"na\") + \"_\" + col_str(\"card5\", -1) + \"_\" + col_str(\"card6\", \"na\") + \"_\" +\n","                col_str(\"addr1\", -1) + \"_\" + pd.Series(anchor, index=frame.index))\n","    uid_device = col_str(\"DeviceInfo\", \"no_dev\") + \"_\" + col_str(\"id_30\", \"no_os\") + \"_\" + col_str(\"id_31\", \"no_brw\")\n","    return uid_card, uid_device\n","\n","def first_seen_flag(s: pd.Series) -> np.ndarray:\n","    return ~s.duplicated(keep=\"first\").to_numpy()\n","\n","def entity_overlap_rate(frame: pd.DataFrame, train_idx, score_idx, col: str) -> float:\n","    seen = set(frame.loc[train_idx, col].unique())\n","    return float(frame.loc[score_idx, col].isin(seen).mean())\n","\n","def assert_causal(frame: pd.DataFrame, train_idx, score_idx, label: str, time_col: str = CONFIG[\"TIME_COLUMN\"]) -> None:\n","    if len(train_idx) == 0 or len(score_idx) == 0:\n","        return\n","    train_max = frame.loc[train_idx, time_col].max()\n","    score_min = frame.loc[score_idx, time_col].min()\n","    assert train_max <= score_min, f\"CAUSALITY VIOLATION [{label}]: train_max ({train_max}) > score_min ({score_min})\"\n","\n","def time_ordered_inner_split(frame: pd.DataFrame, train_idx, frac: float, time_col: str = CONFIG[\"TIME_COLUMN\"]):\n","    train_dt = frame.loc[train_idx, time_col].to_numpy()\n","    thresh = np.quantile(train_dt, 1.0 - frac)\n","    return train_idx[train_dt < thresh], train_idx[train_dt >= thresh]\n","\n","def rows_positional_split(n_rows: int, dt: np.ndarray, frac: float) -> tuple[np.ndarray, np.ndarray]:\n","    thresh = np.quantile(dt, 1.0 - frac)\n","    return dt < thresh, dt >= thresh"]},{"cell_type":"code","execution_count":4,"id":"58ec0f85","metadata":{"execution":{"iopub.execute_input":"2026-09-24T15:56:59.196683Z","iopub.status.busy":"2026-09-24T15:56:59.196257Z","iopub.status.idle":"2026-09-24T15:56:59.221828Z","shell.execute_reply":"2026-09-24T15:56:59.220946Z"},"papermill":{"duration":0.031829,"end_time":"2026-09-24T15:56:59.223542+00:00","exception":false,"start_time":"2026-09-24T15:56:59.191713+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================================\n","# 3. Feature Pipeline & Vectorized Graph Predecessor Engine\n","# ==============================================================================\n","LOG_COLS = [\"TransactionAmt\", \"dist1\", \"dist2\", \"C1\", \"C2\", \"C13\"]\n","\n","def build_neural_features(df_fit: pd.DataFrame, df_apply: pd.DataFrame, v_columns: list[str], num_columns: list[str], n_pca: int = CONFIG[\"N_PCA\"], prior: float | None = None) -> tuple[np.ndarray, np.ndarray, dict]:\n","    X_fit, X_app = df_fit[num_columns].copy(), df_apply[num_columns].copy()\n","    for col in LOG_COLS:\n","        if col in num_columns:\n","            X_fit[col] = np.log1p(np.maximum(0.0, X_fit[col].fillna(0.0)))\n","            X_app[col] = np.log1p(np.maximum(0.0, X_app[col].fillna(0.0)))\n","\n","    fill_values = X_fit.median().fillna(0.0)\n","    scaler = StandardScaler()\n","    X_fit_scaled = scaler.fit_transform(X_fit.fillna(fill_values))\n","    X_app_scaled = scaler.transform(X_app.fillna(fill_values))\n","\n","    v_scaler = StandardScaler()\n","    V_fit = v_scaler.fit_transform(df_fit[v_columns].fillna(0.0))\n","    V_app = v_scaler.transform(df_apply[v_columns].fillna(0.0))\n","\n","    n_comp = int(min(n_pca, V_fit.shape[1], max(1, V_fit.shape[0] - 1)))\n","    pca = PCA(n_components=n_comp, svd_solver=\"randomized\", random_state=CONFIG[\"SEED\"])\n","    V_fit_pca = pca.fit_transform(V_fit)\n","    V_app_pca = pca.transform(V_app)\n","\n","    fit_prior = float(df_fit[CONFIG[\"TARGET_COLUMN\"]].mean()) if prior is None else prior\n","    eps = 1e-6\n","\n","    def to_logit(sub_frame: pd.DataFrame) -> tuple[np.ndarray, np.ndarray]:\n","        raw_prob = sub_frame[\"stage1_prob_raw\"] if \"stage1_prob_raw\" in sub_frame.columns else pd.Series(np.nan, index=sub_frame.index)\n","        avail = raw_prob.notna().to_numpy().astype(np.float32)\n","        p = np.clip(raw_prob.fillna(fit_prior).to_numpy(dtype=float), eps, 1.0 - eps)\n","        return np.log(p / (1.0 - p)).astype(np.float32), avail\n","\n","    logit_fit, avail_fit = to_logit(df_fit)\n","    logit_app, avail_app = to_logit(df_apply)\n","\n","    Z_fit = np.hstack([X_fit_scaled, V_fit_pca, logit_fit.reshape(-1, 1), avail_fit.reshape(-1, 1)]).astype(np.float32)\n","    Z_app = np.hstack([X_app_scaled, V_app_pca, logit_app.reshape(-1, 1), avail_app.reshape(-1, 1)]).astype(np.float32)\n","\n","    assert np.isfinite(Z_fit).all(), \"Fatal: non-finite values in Z_fit\"\n","    assert np.isfinite(Z_app).all(), \"Fatal: non-finite values in Z_app\"\n","    return Z_fit, Z_app, {\"logit_fit\": logit_fit, \"logit_app\": logit_app, \"pca_components\": n_comp, \"pca_explained\": float(pca.explained_variance_ratio_.sum()), \"avail_fit\": float(avail_fit.mean()), \"avail_app\": float(avail_app.mean())}\n","\n","def check_representation_shift(Z_fit: np.ndarray, Z_app: np.ndarray, label: str = \"val\", tol: float = CONFIG[\"SHIFT_TOLERANCE\"], skip_tail: int = 2) -> dict:\n","    n_dim = Z_fit.shape[1] - skip_tail\n","    shift = np.abs(Z_app[:, :n_dim].mean(axis=0) - Z_fit[:, :n_dim].mean(axis=0))\n","    worst = float(shift.max())\n","    n_bad = int((shift > tol).sum())\n","    print(f\"    [{'OK' if n_bad == 0 else 'WARNING'}] Representation shift ({label}): max |mean diff| {worst:.3f} | {n_bad} dim(s) > {tol}\")\n","    return {\"max_shift\": worst, \"n_shifted_dims\": n_bad}\n","\n","def extract_causal_predecessors(transaction_dt: np.ndarray, entity_series: np.ndarray, max_neighbors: int = 10, lookback: int = 30 * 86_400, strict_time: bool = True) -> tuple[list[list[int]], dict]:\n","    histories: dict[object, deque] = {}\n","    predecessors, n_tie_skipped = [], 0\n","    for idx, (dt, ent) in enumerate(zip(transaction_dt, entity_series)):\n","        h = histories.setdefault(ent, deque())\n","        while h and (dt - h[0][0] > lookback):\n","            h.popleft()\n","        selected = []\n","        for t_prev, j in reversed(h):\n","            if strict_time and t_prev >= dt:\n","                n_tie_skipped += 1\n","                continue\n","            selected.append(j)\n","            if len(selected) >= max_neighbors:\n","                break\n","        selected.reverse()\n","        predecessors.append(selected)\n","        h.append((dt, idx))\n","    return predecessors, {\"strict_time\": strict_time, \"tie_edges_skipped\": n_tie_skipped, \"total_edges\": sum(len(p) for p in predecessors)}\n","\n","def audit_predecessor_causality(transaction_dt: np.ndarray, hist: list[list[int]], label: str, lookback: int = 30 * 86_400, sample: int = 20_000, seed: int = 42, strict_time: bool = True) -> None:\n","    rng = np.random.default_rng(seed)\n","    idx_pool = np.arange(len(hist)) if len(hist) <= sample else rng.choice(len(hist), size=sample, replace=False)\n","    n_edges = 0\n","    for i in idx_pool:\n","        if not hist[i]:\n","            continue\n","        arr = np.asarray(hist[i], dtype=np.int64)\n","        n_edges += arr.size\n","        assert (arr < i).all(), f\"LEAKAGE [{label}]: node {i} references future index\"\n","        dts = transaction_dt[arr]\n","        assert (dts <= transaction_dt[i]).all(), f\"LEAKAGE [{label}]: node {i} references future timestamp\"\n","        if strict_time:\n","            assert (dts < transaction_dt[i]).all(), f\"LEAKAGE [{label}]: node {i} references same-second tie\"\n","        assert (transaction_dt[i] - dts <= lookback).all(), f\"WINDOW VIOLATION [{label}]\"\n","    print(f\"      causality audit [{label}]: PASSED ({len(idx_pool):,} nodes, {n_edges:,} edges)\")\n","\n","def aggregate_neighbours(Z: np.ndarray, hist: list[list[int]]) -> tuple[np.ndarray, np.ndarray]:\n","    n, d = len(hist), Z.shape[1]\n","    counts = np.fromiter((len(h) for h in hist), dtype=np.int64, count=n)\n","    total = int(counts.sum())\n","    if total == 0:\n","        return np.zeros((n, d), dtype=np.float32), np.zeros((n, 1), dtype=np.float32)\n","    src, pos = np.empty(total, dtype=np.int64), 0\n","    for h in hist:\n","        k = len(h)\n","        if k:\n","            src[pos:pos + k] = h\n","            pos += k\n","    offsets = np.concatenate(([0], np.cumsum(counts)))\n","    valid = counts > 0\n","    sums = np.add.reduceat(Z[src], offsets[:-1][valid], axis=0)\n","    agg = np.zeros((n, d), dtype=np.float32)\n","    agg[valid] = (sums / counts[valid, None]).astype(np.float32)\n","    mask = np.zeros((n, 1), dtype=np.float32)\n","    mask[valid] = 1.0\n","    return agg, mask\n","\n","def neighbour_means(Z: np.ndarray, card_hist: list[list[int]], device_hist: list[list[int]]) -> tuple[np.ndarray, ...]:\n","    c_a, c_m = aggregate_neighbours(Z, card_hist)\n","    d_a, d_m = aggregate_neighbours(Z, device_hist)\n","    return c_a, c_m, d_a, d_m\n","\n","def blank_aggs(n: int, d: int) -> tuple[np.ndarray, ...]:\n","    return (np.zeros((n, d), dtype=np.float32), np.zeros((n, 1), dtype=np.float32),\n","            np.zeros((n, d), dtype=np.float32), np.zeros((n, 1), dtype=np.float32))\n","\n","def slice_aggs(agg_tuple: tuple[np.ndarray, ...], lo: int, hi: int) -> tuple[np.ndarray, ...]:\n","    return tuple(a[lo:hi] for a in agg_tuple)\n","\n","def report_connectivity(card_mask: np.ndarray, dev_mask: np.ndarray, label: str) -> float:\n","    conn = float(((card_mask + dev_mask) > 0).mean())\n","    print(f\"    Connectivity ({label}): card {card_mask.mean():.1%} | device {dev_mask.mean():.1%} | any {conn:.1%}\")\n","    return conn"]},{"cell_type":"code","execution_count":5,"id":"f191538b","metadata":{"execution":{"iopub.execute_input":"2026-09-24T15:56:59.230913Z","iopub.status.busy":"2026-09-24T15:56:59.230534Z","iopub.status.idle":"2026-09-24T15:56:59.245178Z","shell.execute_reply":"2026-09-24T15:56:59.244533Z"},"papermill":{"duration":0.019939,"end_time":"2026-09-24T15:56:59.246536+00:00","exception":false,"start_time":"2026-09-24T15:56:59.226597+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================================\n","# 4. Neural Architecture with Monotonic Blending Gate (beta_i)\n","# ==============================================================================\n","class MonotonicGatedBGNN(nn.Module):\n","    \"\"\"\n","    Blends learned graph representations with frozen tabular logits via a monotonic gate.\n","    Exact Fallback: If both card and device masks are 0 -> beta_i = 0 exactly.\n","    \"\"\"\n","    def __init__(self, in_dim: int, hidden_dim: int = 64, dropout: float = 0.2):\n","        super().__init__()\n","        self.proj_self = nn.Linear(in_dim, hidden_dim)\n","        self.proj_card = nn.Linear(in_dim, hidden_dim)\n","        self.proj_dev = nn.Linear(in_dim, hidden_dim)\n","        self.agg = nn.Sequential(\n","            nn.Linear(hidden_dim * 3, hidden_dim),\n","            nn.SELU(),\n","            nn.Dropout(dropout),\n","            nn.Linear(hidden_dim, hidden_dim),\n","            nn.SELU(),\n","        )\n","        self.gnn_head = nn.Linear(hidden_dim + in_dim, 1)\n","        self.w_card = nn.Parameter(torch.tensor([1.5]))\n","        self.w_dev = nn.Parameter(torch.tensor([1.5]))\n","        self.b_gate = nn.Parameter(torch.tensor([-0.5]))\n","\n","    def forward(self, z: torch.Tensor, card_h: torch.Tensor, card_mask: torch.Tensor,\n","                dev_h: torch.Tensor, dev_mask: torch.Tensor, gbdt_logit: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:\n","        h_self = F.selu(self.proj_self(z))\n","        h_card = F.selu(self.proj_card(card_h)) * card_mask\n","        h_dev = F.selu(self.proj_dev(dev_h)) * dev_mask\n","        h_graph = self.agg(torch.cat([h_self, h_card, h_dev], dim=1))\n","        gnn_logit = self.gnn_head(torch.cat([h_graph, z], dim=1)).squeeze(1)\n","\n","        cm = card_mask.squeeze(1)\n","        dm = dev_mask.squeeze(1)\n","        gate = F.softplus(self.w_card) * cm + F.softplus(self.w_dev) * dm + self.b_gate\n","        active = ((cm + dm) > 0).float()\n","        beta = torch.sigmoid(gate) * active\n","        return beta * gnn_logit + (1.0 - beta) * gbdt_logit, beta\n","\n","class FocalLoss(nn.Module):\n","    def __init__(self, alpha: float = 0.25, gamma: float = 2.0):\n","        super().__init__()\n","        self.alpha, self.gamma = alpha, gamma\n","\n","    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:\n","        probs = torch.sigmoid(logits)\n","        bce = F.binary_cross_entropy_with_logits(logits, targets, reduction=\"none\")\n","        p_t = targets * probs + (1.0 - targets) * (1.0 - probs)\n","        alpha_t = targets * self.alpha + (1.0 - targets) * (1.0 - self.alpha)\n","        return (alpha_t * ((1.0 - p_t) ** self.gamma) * bce).mean()\n","\n","@torch.no_grad()\n","def infer(model: nn.Module, Z: np.ndarray, agg: tuple[np.ndarray, ...], gbdt_logit: np.ndarray, batch_size: int = 32768) -> tuple[np.ndarray, float]:\n","    model.eval()\n","    card_a, card_m, dev_a, dev_m = agg\n","    probs, betas = [], []\n","    for i in range(0, len(Z), batch_size):\n","        s = slice(i, i + batch_size)\n","        out, beta = model(\n","            torch.from_numpy(np.ascontiguousarray(Z[s])).to(DEVICE),\n","            torch.from_numpy(np.ascontiguousarray(card_a[s])).to(DEVICE),\n","            torch.from_numpy(np.ascontiguousarray(card_m[s])).to(DEVICE),\n","            torch.from_numpy(np.ascontiguousarray(dev_a[s])).to(DEVICE),\n","            torch.from_numpy(np.ascontiguousarray(dev_m[s])).to(DEVICE),\n","            torch.from_numpy(np.ascontiguousarray(gbdt_logit[s])).to(DEVICE),\n","        )\n","        probs.append(torch.sigmoid(out).float().cpu().numpy())\n","        betas.append(beta.float().cpu().numpy())\n","    return np.concatenate(probs), float(np.concatenate(betas).mean())\n","\n","def fit_calibrator(probs_stop: np.ndarray, y_stop: np.ndarray):\n","    if CONFIG[\"CALIBRATION\"] != \"isotonic\" or len(y_stop) == 0 or y_stop.sum() < CONFIG[\"MIN_STOP_POSITIVES\"]:\n","        return None\n","    iso = IsotonicRegression(y_min=0.0, y_max=1.0, out_of_bounds=\"clip\")\n","    iso.fit(probs_stop, y_stop)\n","    return iso\n","\n","def apply_calibrator(calibrator, probs: np.ndarray) -> np.ndarray:\n","    if calibrator is None:\n","        return probs\n","    return np.clip(calibrator.predict(probs), 0.0, 1.0).astype(np.float32)"]},{"cell_type":"code","execution_count":6,"id":"4ebbdb6d","metadata":{"execution":{"iopub.execute_input":"2026-09-24T15:56:59.253723Z","iopub.status.busy":"2026-09-24T15:56:59.253359Z","iopub.status.idle":"2026-09-24T15:56:59.271601Z","shell.execute_reply":"2026-09-24T15:56:59.270946Z"},"papermill":{"duration":0.023571,"end_time":"2026-09-24T15:56:59.272973+00:00","exception":false,"start_time":"2026-09-24T15:56:59.249402+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ==============================================================================\n","# 5. Alternating BGNN Training Loop\n","# ==============================================================================\n","def run_alternating_model(\n","    variant_name: str,\n","    boosting_lr: float,\n","    Z_tr0: np.ndarray,\n","    Z_va0: np.ndarray,\n","    logit_tr: np.ndarray,\n","    logit_va: np.ndarray,\n","    y_fit: np.ndarray,\n","    y_stop: np.ndarray,\n","    n_fit: int,\n","    n_tr: int,\n","    card_hist: list[list[int]],\n","    dev_hist: list[list[int]],\n","    total_len: int,\n","    seed: int = CONFIG[\"SEED\"],\n",") -> tuple[np.ndarray, np.ndarray, int, float, float, object]:\n","    set_global_seed(seed)\n","    Z_tr, Z_va = Z_tr0.copy(), Z_va0.copy()\n","\n","    def compute_all_aggs():\n","        Z_stacked = np.vstack([Z_tr, Z_va])\n","        a_all = neighbour_means(Z_stacked, card_hist, dev_hist)\n","        return (\n","            tuple(a[:n_fit] for a in a_all),\n","            tuple(a[n_fit:n_tr] for a in a_all),\n","            tuple(a[n_tr:total_len] for a in a_all),\n","        )\n","\n","    agg_fit, agg_stop, agg_va = compute_all_aggs()\n","    model = MonotonicGatedBGNN(Z_tr.shape[1], CONFIG[\"HIDDEN_DIM\"], CONFIG[\"DROPOUT\"]).to(DEVICE)\n","    optimizer = torch.optim.AdamW(model.parameters(), lr=CONFIG[\"LR\"], weight_decay=CONFIG[\"WEIGHT_DECAY\"])\n","    criterion = FocalLoss(alpha=CONFIG[\"FOCAL_ALPHA\"], gamma=CONFIG[\"FOCAL_GAMMA\"])\n","    use_amp = DEVICE.type == \"cuda\"\n","    scaler_amp = make_grad_scaler(use_amp)\n","\n","    best_ap, best_round, stale = -np.inf, 0, 0\n","    best_state = None\n","    best_Z_va, best_agg_va = Z_va.copy(), agg_va\n","    best_p_stop, best_beta = None, 0.0\n","\n","    for m_round in range(1, CONFIG[\"OUTER_ROUNDS\"] + 1):\n","        # Phase A: GNN Neural Update\n","        generator = torch.Generator()\n","        generator.manual_seed(seed + m_round)\n","        loader = DataLoader(\n","            TensorDataset(\n","                torch.from_numpy(np.ascontiguousarray(Z_tr[:n_fit])),\n","                *[torch.from_numpy(np.ascontiguousarray(a)) for a in agg_fit],\n","                torch.from_numpy(np.ascontiguousarray(logit_tr[:n_fit])),\n","                torch.from_numpy(y_fit.astype(np.float32)),\n","            ),\n","            batch_size=CONFIG[\"BATCH_SIZE\"],\n","            shuffle=True,\n","            generator=generator,\n","            pin_memory=use_amp,\n","        )\n","\n","        model.train()\n","        for _ in range(CONFIG[\"INNER_EPOCHS\"]):\n","            for b_z, b_ca, b_cm, b_da, b_dm, b_lg, b_y in loader:\n","                optimizer.zero_grad(set_to_none=True)\n","                with autocast_ctx(use_amp):\n","                    out, _ = model(b_z.to(DEVICE), b_ca.to(DEVICE), b_cm.to(DEVICE), b_da.to(DEVICE), b_dm.to(DEVICE), b_lg.to(DEVICE))\n","                    loss = criterion(out, b_y.to(DEVICE))\n","                scaler_amp.scale(loss).backward()\n","                scaler_amp.step(optimizer)\n","                scaler_amp.update()\n","\n","        # Phase B: Boosted Representation Displacement\n","        if boosting_lr > 0:\n","            p_fit, _ = infer(model, Z_tr[:n_fit], agg_fit, logit_tr[:n_fit])\n","            residual = (y_fit - p_fit).astype(np.float32)\n","\n","            reg = lgb.LGBMRegressor(\n","                objective=\"regression\", learning_rate=0.08, num_leaves=31, n_estimators=30,\n","                random_state=seed + m_round, n_jobs=-1, verbose=-1\n","            )\n","            reg.fit(Z_tr[:n_fit], residual)\n","\n","            direction = (Z_tr[:n_fit] * residual.reshape(-1, 1)).mean(axis=0)\n","            norm = np.linalg.norm(direction)\n","            direction = direction / norm if norm > 1e-8 else direction\n","\n","            disp_tr = np.clip(reg.predict(Z_tr).reshape(-1, 1) * direction, -CONFIG[\"DISPLACEMENT_CLIP\"], CONFIG[\"DISPLACEMENT_CLIP\"])\n","            disp_va = np.clip(reg.predict(Z_va).reshape(-1, 1) * direction, -CONFIG[\"DISPLACEMENT_CLIP\"], CONFIG[\"DISPLACEMENT_CLIP\"])\n","\n","            Z_tr = (Z_tr + boosting_lr * disp_tr).astype(np.float32)\n","            Z_va = (Z_va + boosting_lr * disp_va).astype(np.float32)\n","            agg_fit, agg_stop, agg_va = compute_all_aggs()\n","\n","        # Phase C: Selection on Inner Stopping Split\n","        p_stop, beta_now = infer(model, Z_tr[n_fit:n_tr], agg_stop, logit_tr[n_fit:n_tr])\n","        current_ap = float(average_precision_score(y_stop, p_stop))\n","\n","        if current_ap > best_ap:\n","            best_ap, best_round, stale = current_ap, m_round, 0\n","            best_state = copy.deepcopy(model.state_dict())\n","            best_Z_va, best_agg_va = Z_va.copy(), agg_va\n","            best_p_stop, best_beta = p_stop, beta_now\n","        else:\n","            stale += 1\n","            if stale >= CONFIG[\"PATIENCE\"]:\n","                break\n","\n","    model.load_state_dict(best_state)\n","    p_va, beta_va = infer(model, best_Z_va, best_agg_va, logit_va)\n","    return p_va, best_p_stop, best_round, best_ap, beta_va, model\n","\n","def train_multiseed_alternating(\n","    variant_name: str, boosting_lr: float, Z_tr0: np.ndarray, Z_va0: np.ndarray,\n","    logit_tr: np.ndarray, logit_va: np.ndarray, y_fit: np.ndarray, y_stop: np.ndarray,\n","    n_fit: int, n_tr: int, card_hist: list[list[int]], dev_hist: list[list[int]], total_len: int\n",") -> tuple[np.ndarray, object, dict]:\n","    p_va_list, p_stop_list, rounds, inner_aps, betas = [], [], [], [], []\n","    last_model = None\n","    for k in range(CONFIG[\"N_SEEDS\"]):\n","        seed = CONFIG[\"SEED\"] + 1000 * k\n","        p_va, p_stop, b_round, b_ap, beta_v, model = run_alternating_model(\n","            variant_name, boosting_lr, Z_tr0, Z_va0, logit_tr, logit_va,\n","            y_fit, y_stop, n_fit, n_tr, card_hist, dev_hist, total_len, seed=seed\n","        )\n","        p_va_list.append(p_va)\n","        p_stop_list.append(p_stop)\n","        rounds.append(b_round)\n","        inner_aps.append(b_ap)\n","        betas.append(beta_v)\n","        last_model = model\n","\n","    p_va_mean = np.mean(np.vstack(p_va_list), axis=0).astype(np.float32)\n","    p_stop_mean = np.mean(np.vstack(p_stop_list), axis=0).astype(np.float32)\n","    calibrator = fit_calibrator(p_stop_mean, y_stop)\n","    info = {\n","        \"n_seeds\": CONFIG[\"N_SEEDS\"],\n","        \"best_rounds\": rounds,\n","        \"inner_ap_mean\": float(np.mean(inner_aps)),\n","        \"inner_ap_std\": float(np.std(inner_aps, ddof=1)) if len(inner_aps) > 1 else 0.0,\n","        \"mean_beta\": float(np.mean(betas)),\n","    }\n","    return p_va_mean, calibrator, info, last_model"]},{"cell_type":"code","execution_count":7,"id":"d5a326e4","metadata":{"execution":{"iopub.execute_input":"2026-09-24T15:56:59.280645Z","iopub.status.busy":"2026-09-24T15:56:59.280029Z","iopub.status.idle":"2026-09-24T15:57:33.069329Z","shell.execute_reply":"2026-09-24T15:57:33.06839Z"},"papermill":{"duration":33.798056,"end_time":"2026-09-24T15:57:33.074179+00:00","exception":false,"start_time":"2026-09-24T15:56:59.276123+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[1] Loading raw data and validating schemas...\n","    Data directory: /kaggle/input/competitions/ieee-fraud-detection | Hardware Device: cuda\n","    Memory downcast [raw]: 1955.4 MB -> 1044.7 MB (46.6% saved)\n","    Block 5 OOT Holdout Quarantine: PASSED (Sealed).\n"]}],"source":["# ==================================================================