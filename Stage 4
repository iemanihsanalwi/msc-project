=====================================\n","# 8. PASS A — Expanding Forward Validation (Embargoed Evaluation)\n","# ==============================================================================\n","folds = [\n","    ([1], 2),\n","    ([1, 2], 3),\n","    ([1, 2, 3], 4),\n","]\n","\n","VARIANTS = [(\"real\", CONFIG[\"BOOSTING_LR\"])]\n","if CONFIG[\"RUN_NO_BOOST_ABLATION\"]:\n","    VARIANTS.append((\"no_boost\", 0.0))\n","\n","fold_results, diagnostics = [], []\n","full_block_probs = {v[0]: np.full(len(df), np.nan, dtype=np.float32) for v in VARIANTS}\n","full_block_cal = {v[0]: np.full(len(df), np.nan, dtype=np.float32) for v in VARIANTS}\n","oof_source = np.full(len(df), \"none\", dtype=object)\n","pass_a_models = {}\n","\n","print(\"\\n\" + \"=\" * 95)\n","print(\"PASS A: EXPANDING CHRONOLOGICAL FORWARD VALIDATION (EMBARGOED EVALUATION)\")\n","print(\"=\" * 95)\n","\n","for fold_idx, (train_blocks, val_block) in enumerate(folds, 1):\n","    print(f\"\\n--- Fold {fold_idx}: Train {train_blocks} -> Validate Block {val_block} ---\")\n","    train_idx = df.index[df[\"chrono_block\"].isin(train_blocks)].to_numpy()\n","    val_idx_full = df.index[df[\"chrono_block\"] == val_block].to_numpy()\n","\n","    assert not (set(train_idx.tolist()) & OOT_INDEX), \"Fatal: OOT row in training set\"\n","    assert_causal(df, train_idx, val_idx_full, f\"fold{fold_idx}\")\n","\n","    train_max_dt = df.loc[train_idx, CONFIG[\"TIME_COLUMN\"]].max()\n","    embargo_keep = (df.loc[val_idx_full, CONFIG[\"TIME_COLUMN\"]].to_numpy() >= train_max_dt + CONFIG[\"EMBARGO_SECONDS\"])\n","\n","    df_tr = df.loc[train_idx].reset_index(drop=True)\n","    df_va = df.loc[val_idx_full].reset_index(drop=True)\n","    n_tr, n_va = len(df_tr), len(df_va)\n","\n","    Z_tr, Z_va, info = build_neural_features(df_tr, df_va, v_cols, num_cols, CONFIG[\"N_PCA\"])\n","    shift = check_representation_shift(Z_tr, Z_va, f\"fold_{fold_idx}\")\n","\n","    dt_tr = df_tr[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","    fit_m, stop_m = rows_positional_split(n_tr, dt_tr, CONFIG[\"INNER_VAL_FRAC\"])\n","    n_fit = int(fit_m.sum())\n","\n","    combined = pd.concat([df_tr, df_va], ignore_index=True)\n","    dt_all = combined[CONFIG[\"TIME_COLUMN\"]].to_numpy()\n","\n","    card_hist, card_stats = extract_causal_predecessors(dt_all, combined[\"uid_card\"].to_numpy(), CONFIG[\"CARD_MAX_NEIGHBORS\"], lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","    dev_hist, dev_stats = extract_causal_predecessors(dt_all, combined[\"uid_device\"].to_numpy(), CONFIG[\"DEVICE_MAX_NEIGHBORS\"], lookback=CONFIG[\"LOOKBACK_WINDOW_SECS\"], strict_time=CONFIG[\"STRICT_TIME_CAUSALITY\"])\n","\n","    record_graph_audit(dt_all, card_hist, card_stats, f\"fold{fold_idx}\", \"card\")\n","    record_graph_audit(dt_all, dev_hist, dev_stats, f\"fold{fold_idx}\", \"device\")\n","\n","    y_tr = df_tr[CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","    y_fit, y_stop = y_tr[fit_m], y_tr[stop_m]\n","    y_va_full = df_va[CONFIG[\"TARGET_COLUMN\"]].to_numpy()\n","    amt_va_full = df_va[CONFIG[\"AMOUNT_COLUMN\"]].to_numpy()\n","    first_seen_full = df_va[\"card_first_seen\"].to_numpy()\n","\n","    y_va = y_va_full[embargo_keep]\n","    amt_va = amt_va_full[embargo_keep]\n","    first_seen_sub = first_seen_full[embargo_keep]\n","\n","    card_overlap = entity_overlap_rate(df, train_idx, val_idx_full, \"uid_card\")\n","    device_overlap = entity_overlap_rate(df, train_idx, val_idx_full, \"uid_device\")\n","\n","    for variant_name, blr in VARIANTS:\n","        p_full, calibrator, minfo, trained_model = train_multiseed_alternating(\n","            variant_name, blr, Z_tr, Z_va, info[\"logit_fit\"], info[\"logit_app\"],\n","            y_fit, y_stop, n_fit, n_tr, card_hist, dev_hist, len(combined)\n","        )\n","        p_cal_full = apply_calibrator(calibrator, p_full)\n","        full_block_probs[variant_name][val_idx_full] = p_full\n","        full_block_cal[variant_name][val_idx_full] = p_cal_full\n","\n","        if variant_name == \"real\":\n","            oof_source[val_idx_full] = f\"forward_fold_{fold_idx}\"\n","            pass_a_models[fold_idx] = {\"model\": trained_model, \"calibrator\": calibrator}\n","\n","        p_raw_eval = p_full[embargo_keep]\n","        p_cal_eval = p_cal_full[embargo_keep]\n","        m_raw = compute_metrics(y_va, p_raw_eval, amt_va)\n","        m_cal = compute_metrics(y_va, p_cal_eval, amt_va)\n","\n","        ap_new = average_precision_score(y_va[first_seen_sub], p_raw_eval[first_seen_sub]) if y_va[first_seen_sub].sum() > 0 else np.nan\n","        ap_seen = average_precision_score(y_va[~first_seen_sub], p_raw_eval[~first_seen_sub]) if y_va[~first_seen_sub].sum() > 0 else np.nan\n","\n","        rec = {\n","            \"variant\": variant_name,\n","            \"fold\": fold_idx,\n","            \"val_block\": val_block,\n","            \"n_fit\": n_fit,\n","            \"n_stop\": int(stop_m.sum()),\n","            \"n_val\": int(embargo_keep.sum()),\n","            \"n_val_embargoed_out\": int(n_va - embargo_keep.sum()),\n","            \"inner_ap_mean\": minfo[\"inner_ap_mean\"],\n","            \"inner_ap_std\": minfo[\"inner_ap_std\"],\n","            \"mean_beta\": minfo[\"mean_beta\"],\n","            \"val_fraud_rate\": float(y_va.mean()),\n","            \"AP_new_entity\": ap_new,\n","            \"AP_seen_entity\": ap_seen,\n","            \"first_seen_share\": float(first_seen_sub.mean()),\n","            \"card_overlap_rate\": card_overlap,\n","            \"device_overlap_rate\": device_overlap,\n","            \"AP_calibrated\": m_cal[\"AP\"],\n","            \"ECE_calibrated\": m_cal[\"ECE\"],\n","            \"ECE_quantile_calibrated\": m_cal[\"ECE_quantile\"],\n","            \"Loss_cost_rule_calibrated\": m_cal[\"Loss_cost_rule\"],\n","            **m_raw,\n","        }\n","        fold_results.append(rec)\n","        print(f\"    [{variant_name.upper()}] Val B{val_block}: AP {m_raw['AP']:.4f} | Calibrated AP {m_cal['AP']:.4f} | R@0.1%FPR {m_raw['Recall@0.1%FPR']:.2%} | Mean Beta {minfo['mean_beta']:.3f}\")\n","\n","    diagnostics.append({\n","        \"fold\": fold_idx,\n","        \"val_block\": val_block,\n","        \"card_overlap_rate\": card_overlap,\n","        \"device_overlap_rate\": device_overlap,\n","        \"share_first_seen_card\": float(first_seen_full.mean()),\n","        \"stage1_logit_coverage_val\": info[\"avail_app\"],\n","        \"pca_explained\": info[\"pca_explained\"],\n","        **{f\"shift_{k}\": v for k, v in shift.items()},\n","    })\n","    del Z_tr, Z_va, combined, card_hist, dev_hist\n","    gc.collect()\n","\n","results_df = pd.DataFrame(fold_results)\n","diag_df = pd.DataFrame(diagnostics)"]},{"cell_type":"code","execution_count":10,"id":"6551583b","metadata":{"_cell_guid":"ee2daa0b-4af0-4424-a78f-36f9b95dd8d1","_uuid":"072a8d26-6d04-4bb5-8881-0bf9ba0a54b3","collapsed":false,"execution":{"iopub.execute_input":"2026-10-02T02:48:05.405433Z","iopub.status.busy":"2026-10-02T02:48:05.404513Z","iopub.status.idle":"2026-10-02T02:54:30.893147Z","shell.execute_reply":"2026-10-02T02:54:30.89214Z"},"jupyter":{"outputs_hidden":false},"papermill":{"duration":385.500065,"end_time":"2026-10-02T02:54:30.895176+00:00","exception":false,"start_time":"2026-10-02T02:48:05.395111+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","[3] Generating complete Stage-4 scores for all blocks (Pass B)...\n","    Block 1: expanding sub-folds K=4 -> 75% coverage\n","      causality audit [b1_subfold1/card]: PASSED (20,000 nodes, 21,725 edges)\n","      causality audit [b1_subfold1/device]: PASSED (20,000 nodes, 96,300 edges)\n"]},{"name":"stderr","output_type":"stream","text":["/usr/local/lib/python3.12/dist-packages/torch/utils/data/_utils/pin_memory.py:57: DeprecationWarning: The argument 'device' of Tensor.is_pinned() is deprecated. Please do not pass this argument. (Triggered int