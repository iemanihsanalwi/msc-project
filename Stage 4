{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"competition","sourceId":14242},{"sourceType":"kernelVersion","sourceId":352296061},{"sourceType":"kernelVersion","sourceId":352330678},{"sourceType":"kernelVersion","sourceId":352339657},{"sourceType":"kernelVersion","sourceId":352365070}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"\"\"\"\nStage 4: Alternating Jointly-Optimised BGNN (Refined Edition)\n============================================================\nAligned with the IEEE-CIS EDA & Leakage Audit Protocol:\n  1. Integrates Stage 1 (tabular GBDT) and Stage 3 (frozen Res-GNN) benchmarks.\n  2. Constructs continuous node embeddings Z0:\n     - Log-transformed continuous attributes (TransactionAmt, distances, C-series).\n     - Median imputation + StandardScaler fitted strictly on D_fit.\n     - 15-component PCA projection over V-columns fitted strictly on D_fit.\n     - Frozen Stage 1 GBDT out-of-fold logit with an explicit availability flag.\n  3. Joint Functional-Gradient Optimization:\n     - Alternating loop: Neural propagation updates GNN and representation Z;\n       LightGBM regresses pseudo-residuals (y - p) directly on Z along a learned\n       displacement direction to steer the manifold.\n     - Monotonic decision blending gate (beta_i): Softplus-parameterized weights\n       dynamically blend GNN and tabular logits, providing an exact tabular fallback\n       (beta_i = 0) for isolated/cold-start transactions.\n  4. Decomposed Hypothesis Testing via Paired Block Bootstrap (95% CI):\n     - H3  (Joint Coupling): Stage 4 vs. Stage 3 (Joint vs. Frozen).\n     - H3a (Alternating Boosting): Stage 4 vs. Stage 4 No-Boost Ablation.\n     - H3b (Gating Mechanism): Stage 4 No-Boost Ablation vs. Stage 3.\n     - H4  (Macro Ladder Integrity): Stage 4 vs. Stage 1 Tabular Baseline.\n  5. Inner-split (20%) early stopping over outer alternating rounds.\n  6. Block 1 OOF estimation via causal half-split for full development coverage.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport gc\nimport json\nimport copy\nimport warnings\nfrom collections import deque\nfrom datetime import datetime, timezone\n\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import DataLoader, TensorDataset\nimport lightgbm as lgb\nfrom sklearn.decomposition import PCA\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import average_precision_score, roc_auc_score\n\nwarnings.simplefilter(\"default\")\nwarnings.filterwarnings(\"ignore\", category=UserWarning, module=\"torch\")\nwarnings.filterwarnings(\"ignore\", category=UserWarning, module=\"lightgbm\")\n\n# ==============================================================================\n# 1. Configuration and Parameters\n# ==============================================================================\nCONFIG = {\n    # --- Reproducibility & Schema ---\n    \"SEED\": 42,\n    \"TIME_COLUMN\": \"TransactionDT\",\n    \"TARGET_COLUMN\": \"isFraud\",\n    \"ID_COLUMN\": \"TransactionID\",\n\n    # --- Temporal Protocol & Embargo ---\n    \"N_BLOCKS\": 5,\n    \"DEV_BLOCKS\": [1, 2, 3, 4],\n    \"OOT_BLOCK\": 5,                     # Sealed holdout: strictly quarantined\n    \"SECONDS_PER_DAY\": 86_400,\n    \"EMBARGO_SECONDS\": 86_400,           # 1-day boundary embargo\n    \"LOOKBACK_WINDOW_SECS\": 30 * 86_400, # 30-day temporal lookback limit\n\n    # --- Early Stopping & Validation Integrity ---\n    \"INNER_VAL_FRAC\": 0.20,             # Final 20% of training time-window stops training\n\n    # --- Cost Model (Bayes-Optimal Decision Boundary) ---\n    \"C_REVIEW\": 10.0,                   # Cost per manual review ($)\n    \"C_FRICTION\": 25.0,                 # Customer friction penalty on FP ($)\n\n    # --- Operational Triage & Bootstrap Benchmarks ---\n    \"INVESTIGATION_CAPACITY\": 0.01,     # Top 1% of queue\n    \"N_BOOTSTRAP\": 400,                 # Paired bootstrap iterations\n    \"BOOTSTRAP_ALPHA\": 0.05,            # 95% Confidence Intervals\n    \"ACCEPTANCE_DELTA\": 0.005,          # Material AP uplift threshold\n\n    # --- Alternating BGNN Hyperparameters ---\n    \"OUTER_ROUNDS\": 4,                  # Alternating GNN-GBDT optimization cycles\n    \"INNER_EPOCHS\": 2,                  # Neural network epochs per outer cycle\n    \"PATIENCE\": 2,                      # Early stopping patience on outer rounds\n    \"BATCH_SIZE\": 8192,\n    \"HIDDEN_DIM\": 64,\n    \"DROPOUT\": 0.20,\n    \"LR\": 3e-3,\n    \"N_PCA\": 15,\n    \"BOOSTING_LR\": 0.10,                # Step size for boosted displacement update\n    \"DISPLACEMENT_CLIP\": 0.20,          # Bound on displacement delta\n    \"CARD_MAX_NEIGHBORS\": 10,\n    \"DEVICE_MAX_NEIGHBORS\": 5,\n\n    # --- Experimental Controls ---\n    \"RUN_NO_BOOST_ABLATION\": True,      # BOOSTING_LR = 0 (isolates gate from boosting)\n    \"RUN_NULL_CONTROL\": False,          # Time-matched predecessor null (expensive in S4)\n\n    # --- Candidate Search Paths ---\n    \"CANDIDATE_DATA_DIRS\": [\n        \"/kaggle/input/competitions/ieee-fraud-detection\",\n        \"/kaggle/input/ieee-fraud-detection\",\n        \"./data/ieee-fraud-detection\",\n        \"./data\",\n        \".\",\n    ],\n    \"CANDIDATE_DECISION_PATHS\": [\n        \"/kaggle/input/notebooks/iemanihsan/fork-of-ieee-cis-eda-leakage-audit/artifacts/feature_risk_table.csv\",\n        \"./artifacts/feature_risk_table.csv\",\n        \"feature_risk_table.csv\",\n        \"./artifacts/feature_decisions.csv\",\n        \"feature_decisions.csv\",\n    ],\n    \"CANDIDATE_STAGE1_RESULTS\": [\n        \"/kaggle/input/notebooks/iemanihsan/stage-1-standalone-tabular-lightgbm-baseline/stage1_fold_results.csv\",\n        \"./artifacts/stage1_fold_results.csv\",\n        \"stage1_fold_results.csv\",\n    ],\n    \"CANDIDATE_STAGE1_OOF\": [\n        \"/kaggle/input/notebooks/iemanihsan/stage-1-standalone-tabular-lightgbm-baseline/stage1_oof_predictions.csv\",\n        \"./artifacts/stage1_oof_predictions.csv\",\n        \"stage1_oof_predictions.csv\",\n    ],\n    \"CANDIDATE_STAGE3_RESULTS\": [\n        \"/kaggle/input/notebooks/iemanihsan/stage-3-frozen-two-stage-res-gnn-pipeline/stage3_fold_results.csv\",\n        \"./artifacts/stage3_fold_results.csv\",\n        \"stage3_fold_results.csv\",\n    ],\n    \"CANDIDATE_STAGE3_OOF\": [\n        \"/kaggle/input/notebooks/iemanihsan/stage-3-frozen-two-stage-res-gnn-pipeline/stage3_oof_predictions.csv\",\n        \"./artifacts/stage3_oof_predictions.csv\",\n        \"stage3_oof_predictions.csv\",\n    ],\n    \"OUTPUT_DIR\": \"./artifacts\",\n}\n\nTARGET_LEAKAGE_COLUMNS = [\n    \"isFraud\",\n    \"TransactionID\",\n    \"TransactionDT\",\n    \"elapsed_days\",\n    \"day_index\",\n    \"chrono_block\",\n]\n\n# Set seeds & hardware execution device\ntorch.manual_seed(CONFIG[\"SEED\"])\nnp.random.seed(CONFIG[\"SEED\"])\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nif DEVICE.type == \"cuda\":\n    torch.set_float32_matmul_precision(\"high\")\n\nos.makedirs(CONFIG[\"OUTPUT_DIR\"], exist_ok=True)\n\n\n# ==============================================================================\n# 2. Reusable Utility Functions\n# ==============================================================================\ndef resolve_path(candidates: list[str], target_file: str | None = None) -> str:\n    \"\"\"Resolve the first valid directory or file from candidates or search recursively.\"\"\"\n    for path in candidates:\n        check_path = os.path.join(path, target_file) if target_file else path\n        if os.path.exists(check_path):\n            return check_path if target_file else path\n    search_dirs = [\"/kaggle/input\", \".\"]\n    if target_file:\n        for base in search_dirs:\n            if os.path.exists(base):\n                for root, _, files in os.walk(base):\n                    if target_file in files:\n                        return os.path.join(root, target_file)\n    raise FileNotFoundError(f\"Target {target_file or 'directory'} not found in {candidates}.\")\n\n\ndef reduce_memory(frame: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"Downcast numeric columns in place to preserve RAM.\"\"\"\n    before = frame.memory_usage(deep=False).sum() / 1024 ** 2\n    for col in frame.columns:\n        kind = frame[col].dtype.kind\n        if kind == \"i\":\n            frame[col] = pd.to_numeric(frame[col], downcast=\"integer\")\n        elif kind == \"f\":\n            frame[col] = frame[col].astype(np.float32)\n    after = frame.memory_usage(deep=False).sum() / 1024 ** 2\n    print(f\"Memory downcasting: {before:.1f} MB -> {after:.1f} MB ({(before - after) / max(before, 1e-9):.1%} saved)\")\n    return frame\n\n\ndef create_temporal_blocks(\n    frame: pd.DataFrame,\n    n_blocks: int,\n    time_col: str = \"TransactionDT\",\n    id_col: str = \"TransactionID\",\n) -> pd.Series:\n    \"\"\"Assign equal-row-count chronological block labels 1..n_blocks deterministically.\"\"\"\n    order = frame.sort_values([time_col, id_col], kind=\"mergesort\").index\n    position = pd.Series(np.arange(len(order)), index=order)\n    labels = np.minimum((position.values * n_blocks) // len(order), n_blocks - 1) + 1\n    return pd.Series(labels.astype(np.int16), index=order).reindex(frame.index)\n\n\ndef alert_threshold(amounts: np.ndarray, c_rev: float = CONFIG[\"C_REVIEW\"], c_fric: float = CONFIG[\"C_FRICTION\"]) -> np.ndarray:\n    \"\"\"Bayes-optimal operational alert threshold: p* = (C_review + C_friction) / (Amount + C_friction).\"\"\"\n    amounts_arr = np.asarray(amounts, dtype=float)\n    thresh = (c_rev + c_fric) / (amounts_arr + c_fric)\n    return np.minimum(thresh, 1.0)\n\n\ndef expected_calibration_error(y_true: np.ndarray, y_prob: np.ndarray, n_bins: int = 20) -> float:\n    \"\"\"Calculate bin-weighted expected calibration error (ECE).\"\"\"\n    y_true_arr = np.asarray(y_true, dtype=float)\n    y_prob_arr = np.clip(np.asarray(y_prob, dtype=float), 0.0, 1.0)\n    edges = np.linspace(0.0, 1.0, n_bins + 1)\n    bin_idx = np.clip(np.digitize(y_prob_arr, edges[1:-1], right=False), 0, n_bins - 1)\n\n    total_error = 0.0\n    n = len(y_true_arr)\n    if n == 0:\n        return float(\"nan\")\n\n    for b in range(n_bins):\n        mask = bin_idx == b\n        count = int(mask.sum())\n        if count > 0:\n            diff = abs(y_prob_arr[mask].mean() - y_true_arr[mask].mean())\n            total_error += count * diff\n    return float(total_error / n)\n\n\ndef compute_metrics(\n    y_true: np.ndarray,\n    y_prob: np.ndarray,\n    amounts: np.ndarray,\n    capacity: float = CONFIG[\"INVESTIGATION_CAPACITY\"],\n) -> dict[str, float]:\n    \"\"\"Compute ranking, calibration, and cost-curve evaluation metrics for one block.\"\"\"\n    y_true = np.asarray(y_true, dtype=int)\n    y_prob = np.asarray(y_prob, dtype=float)\n    amounts = np.asarray(amounts, dtype=float)\n\n    ap = float(average_precision_score(y_true, y_prob))\n    try:\n        roc = float(roc_auc_score(y_true, y_prob))\n    except ValueError:\n        roc = float(\"nan\")\n\n    p_safe = np.clip(y_prob, 1e-15, 1.0 - 1e-15)\n    log_loss = float(-np.mean(y_true * np.log(p_safe) + (1 - y_true) * np.log(1.0 - p_safe)))\n    brier = float(np.mean((y_prob - y_true) ** 2))\n    ece = expected_calibration_error(y_true, y_prob, n_bins=20)\n\n    order = np.lexsort((-amounts, -y_prob))\n    y_sorted = y_true[order]\n    n_neg = int((y_sorted == 0).sum())\n    n_pos = int((y_sorted == 1).sum())\n    cum_fp = (y_sorted == 0).cumsum()\n\n    def recall_at_fpr(target_fpr: float) -> float:\n        budget = int(np.floor(target_fpr * n_neg))\n        alerted_pos = int(y_sorted[cum_fp <= budget].sum())\n        return float(alerted_pos / n_pos) if n_pos > 0 else 0.0\n\n    k_cap = max(1, int(np.floor(capacity * len(y_sorted))))\n    prec_at_cap = float(y_sorted[:k_cap].mean()) if k_cap > 0 else 0.0\n    rec_at_cap = float(y_sorted[:k_cap].sum() / n_pos) if n_pos > 0 else 0.0\n\n    def financial_loss(predictions: np.ndarray) -> float:\n        fn_mask = (y_true == 1) & (predictions == 0)\n        fp_mask = (y_true == 0) & (predictions == 1)\n        stolen = amounts[fn_mask].sum()\n        review = predictions.sum() * CONFIG[\"C_REVIEW\"]\n        friction = fp_mask.sum() * CONFIG[\"C_FRICTION\"]\n        return float(stolen + review + friction)\n\n    preds_cost_rule = (y_prob > alert_threshold(amounts)).astype(int)\n    preds_flat_half = (y_prob >= 0.5).astype(int)\n\n    return {\n        \"AP\": ap,\n        \"ROC_AUC\": roc,\n        \"LogLoss\": log_loss,\n        \"Brier\": brier,\n        \"ECE\": ece,\n        \"Recall@0.1%FPR\": recall_at_fpr(0.001),\n        \"Recall@1.0%FPR\": recall_at_fpr(0.010),\n        f\"Prec@{capacity:.1%}cap\": prec_at_cap,\n        f\"Recall@{capacity:.1%}cap\": rec_at_cap,\n        \"Loss_cost_rule\": financial_loss(preds_cost_rule),\n        \"Loss_flat_0.5\": financial_loss(preds_flat_half),\n        \"AlertRate\": float(preds_cost_rule.mean()),\n    }\n\n\ndef bootstrap_ap_delta(\n    y_true: np.ndarray,\n    p_new: np.ndarray,\n    p_ref: np.ndarray,\n    n_boot: int = CONFIG[\"N_BOOTSTRAP\"],\n    alpha: float = CONFIG[\"BOOTSTRAP_ALPHA\"],\n    seed: int = CONFIG[\"SEED\"],\n) -> dict[str, float | int]:\n    \"\"\"Paired bootstrap of AP(p_new) - AP(p_ref) over identical resampled rows.\"\"\"\n    y_arr = np.asarray(y_true, dtype=int)\n    p_new_arr = np.asarray(p_new, dtype=float)\n    p_ref_arr = np.asarray(p_ref, dtype=float)\n    n = len(y_arr)\n\n    observed = float(average_precision_score(y_arr, p_new_arr) - average_precision_score(y_arr, p_ref_arr))\n    rng = np.random.default_rng(seed)\n    deltas = np.empty(n_boot, dtype=float)\n    valid_count = 0\n\n    for _ in range(n_boot):\n        idx = rng.integers(0, n, size=n)\n        y_b = y_arr[idx]\n        pos_sum = y_b.sum()\n        if pos_sum == 0 or pos_sum == n:\n            continue\n        delta_b = average_precision_score(y_b, p_new_arr[idx]) - average_precision_score(y_b, p_ref_arr[idx])\n        deltas[valid_count] = delta_b\n        valid_count += 1\n\n    deltas = deltas[:valid_count]\n    if valid_count == 0:\n        return {\"delta\": observed, \"ci_low\": np.nan, \"ci_high\": np.nan, \"p_win\": np.nan, \"n_boot\": 0}\n\n    ci_low, ci_high = np.percentile(deltas, [100 * alpha / 2, 100 * (1.0 - alpha / 2)])\n    return {\n        \"delta\": observed,\n        \"ci_low\": float(ci_low),\n        \"ci_high\": float(ci_high),\n        \"p_win\": float((deltas > 0.0).mean()),\n        \"n_boot\": int(valid_count),\n    }\n\n\ndef build_entity_uids(frame: pd.DataFrame) -> tuple[pd.Series, pd.Series]:\n    \"\"\"Construct client and device entity proxies without time leakage.\"\"\"\n    anchor = np.where(\n        frame[\"D1\"].isna(),\n        \"na\",\n        (frame[\"day_index\"] - frame[\"D1\"].fillna(0)).astype(\"int64\").astype(str),\n    )\n    uid_card = (\n        frame[\"card1\"].astype(str) + \"_\"\n        + frame[\"card2\"].fillna(-1).astype(str) + \"_\"\n        + frame[\"card3\"].fillna(-1).astype(str) + \"_\"\n        + frame[\"card4\"].fillna(\"na\").astype(str) + \"_\"\n        + frame[\"card5\"].fillna(-1).astype(str) + \"_\"\n        + frame[\"card6\"].fillna(\"na\").astype(str) + \"_\"\n        + frame[\"addr1\"].fillna(-1).astype(str) + \"_\"\n        + anchor\n    )\n    dev_info = frame[\"DeviceInfo\"].fillna(\"no_dev\").astype(str) if \"DeviceInfo\" in frame.columns else \"no_dev\"\n    id_30 = frame[\"id_30\"].fillna(\"no_os\").astype(str) if \"id_30\" in frame.columns else \"no_os\"\n    id_31 = frame[\"id_31\"].fillna(\"no_brw\").astype(str) if \"id_31\" in frame.columns else \"no_brw\"\n    uid_device = dev_info + \"_\" + id_30 + \"_\" + id_31\n    return pd.Series(uid_card, index=frame.index), pd.Series(uid_device, index=frame.index)\n\n\ndef first_seen_flag(entity_series: pd.Series) -> np.ndarray:\n    \"\"\"Return boolean flag indicating first appearance of an entity in chronological stream.\"\"\"\n    return ~entity_series.duplicated(keep=\"first\").to_numpy()\n\n\ndef apply_embargo(\n    frame: pd.DataFrame,\n    train_blocks: list[int],\n    val_block: int,\n    embargo_seconds: int = CONFIG[\"EMBARGO_SECONDS\"],\n    time_col: str = \"TransactionDT\",\n    block_col: str = \"chrono_block\",\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Isolate train and validation masks enforcing boundary time-embargo.\"\"\"\n    train_mask = frame[block_col].isin(train_blocks).to_numpy()\n    train_max_dt = frame.loc[train_mask, time_col].max()\n    val_mask = (\n        (frame[block_col] == val_block)\n        & (frame[time_col] >= train_max_dt + embargo_seconds)\n    ).to_numpy()\n    return train_mask, val_mask\n\n\ndef inner_split(\n    frame: pd.DataFrame,\n    train_mask: np.ndarray,\n    frac: float = CONFIG[\"INNER_VAL_FRAC\"],\n    time_col: str = \"TransactionDT\",\n) -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"Split train_mask into fit set and inner stopping set (last frac by time).\"\"\"\n    train_dt = frame.loc[train_mask, time_col].values\n    split_threshold = np.quantile(train_dt, 1.0 - frac)\n    fit_mask = train_mask & (frame[time_col].values < split_threshold)\n    stop_mask = train_mask & (frame[time_col].values >= split_threshold)\n    return fit_mask, stop_mask\n\n\n# ==============================================================================\n# 3. Neural Feature Pipeline & Predecessor Extraction\n# ==============================================================================\ndef build_neural_features(\n    df_fit: pd.DataFrame,\n    df_apply: pd.DataFrame,\n    v_columns: list[str],\n    num_columns: list[str],\n    n_pca: int = CONFIG[\"N_PCA\"],\n    prior: float | None = None,\n) -> tuple[np.ndarray, np.ndarray, dict]:\n    \"\"\"\n    Build dimensionally aligned continuous representation Z0.\n    Scalers, median fill values, and PCA are fitted strictly on df_fit to eliminate leakage.\n    \"\"\"\n    LOG_COLS = [\"TransactionAmt\", \"dist1\", \"dist2\", \"C1\", \"C2\", \"C13\"]\n\n    X_fit = df_fit[num_columns].copy()\n    X_app = df_apply[num_columns].copy()\n\n    for col in LOG_COLS:\n        if col in num_columns:\n            X_fit[col] = np.log1p(np.maximum(0.0, X_fit[col].fillna(0.0)))\n            X_app[col] = np.log1p(np.maximum(0.0, X_app[col].fillna(0.0)))\n\n    # Compute median fill values on df_fit once and apply to both splits\n    fill_values = X_fit.median().fillna(0.0)\n\n    scaler = StandardScaler()\n    X_fit_scaled = scaler.fit_transform(X_fit.fillna(fill_values))\n    X_app_scaled = scaler.transform(X_app.fillna(fill_values))\n\n    # Standardize V-series and compress via randomized PCA\n    v_scaler = StandardScaler()\n    V_fit = v_scaler.fit_transform(df_fit[v_columns].fillna(0.0))\n    V_app = v_scaler.transform(df_apply[v_columns].fillna(0.0))\n\n    pca = PCA(n_components=n_pca, svd_solver=\"randomized\", random_state=CONFIG[\"SEED\"])\n    V_fit_pca = pca.fit_transform(V_fit)\n    V_app_pca = pca.transform(V_app)\n\n    # Convert frozen Stage 1 out-of-fold probability to logit + availability flag\n    fit_prior = float(df_fit[CONFIG[\"TARGET_COLUMN\"]].mean()) if prior is None else prior\n    eps = 1e-6\n\n    def to_logit(sub_frame: pd.DataFrame) -> tuple[np.ndarray, np.ndarray]:\n        raw_prob = (\n            sub_frame[\"stage1_oof_prob\"]\n            if \"stage1_oof_prob\" in sub_frame.columns\n            else pd.Series(np.nan, index=sub_frame.index)\n        )\n        avail = raw_prob.notna().values.astype(np.float32)\n        p = np.clip(raw_prob.fillna(fit_prior).values, eps, 1.0 - eps)\n        logit = np.log(p / (1.0 - p)).astype(np.float32)\n        return logit, avail\n\n    logit_fit, avail_fit = to_logit(df_fit)\n    logit_app, avail_app = to_logit(df_apply)\n\n    Z_fit = np.hstack([\n        X_fit_scaled,\n        V_fit_pca,\n        logit_fit.reshape(-1, 1),\n        avail_fit.reshape(-1, 1),\n    ]).astype(np.float32)\n\n    Z_app = np.hstack([\n        X_app_scaled,\n        V_app_pca,\n        logit_app.reshape(-1, 1),\n        avail_app.reshape(-1, 1),\n    ]).astype(np.float32)\n\n    assert np.isfinite(Z_fit).all(), \"Fatal: Non-finite values in Z_fit embedding matrix.\"\n    assert np.isfinite(Z_app).all(), \"Fatal: Non-finite values in Z_app embedding matrix.\"\n\n    info = {\n        \"logit_fit\": logit_fit,\n        \"logit_app\": logit_app,\n        \"pca_explained\": float(pca.explained_variance_ratio_.sum()),\n        \"avail_fit\": float(avail_fit.mean()),\n        \"avail_app\": float(avail_app.mean()),\n    }\n    return Z_fit, Z_app, info\n\n\ndef check_representation_shift(Z_fit: np.ndarray, Z_app: np.ndarray, label: str = \"val\", tol: float = 0.75, skip_tail: int = 2) -> dict:\n    \"\"\"Detect distribution shifts across fitted and applied embedding spaces.\"\"\"\n    n_dim = Z_fit.shape[1] - skip_tail\n    shift = np.abs(Z_app[:, :n_dim].mean(axis=0) - Z_fit[:, :n_dim].mean(axis=0))\n    worst = float(shift.max())\n    n_bad = int((shift > tol).sum())\n    status = \"OK\" if n_bad == 0 else \"WARNING\"\n    print(f\"    [{status}] Representation shift check ({label}): max |mean diff| = {worst:.3f} across {n_dim} dims, {n_bad} > {tol}\")\n    return {\"max_shift\": worst, \"n_shifted_dims\": n_bad}\n\n\ndef extract_causal_predecessors(\n    transaction_dt: np.ndarray,\n    entity_series: np.ndarray,\n    max_neighbors: int = 10,\n    lookback: int = CONFIG[\"LOOKBACK_WINDOW_SECS\"],\n) -> list[list[int]]:\n    \"\"\"Extract strictly historical predecessor indices (t_hist < t) within a 30-day lookback window.\"\"\"\n    histories: dict[str, deque] = {}\n    predecessors = []\n    for idx, (dt, ent) in enumerate(zip(transaction_dt, entity_series)):\n        h = histories.setdefault(ent, deque())\n        while h and (dt - h[0][0] > lookback):\n            h.popleft()\n        predecessors.append([x[1] for x in list(h)[-max_neighbors:]])\n        h.append((dt, idx))\n    return predecessors\n\n\ndef neighbour_means(Z: np.ndarray, card_hist: list[list[int]], device_hist: list[list[int]]) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:\n    \"\"\"Compute mean representations of predecessor neighbourhoods along with active edge masks.\"\"\"\n    n, d = Z.shape\n    card_agg = np.zeros((n, d), dtype=np.float32)\n    card_mask = np.zeros((n, 1), dtype=np.float32)\n    dev_agg = np.zeros((n, d), dtype=np.float32)\n    dev_mask = np.zeros((n, 1), dtype=np.float32)\n\n    for i in range(n):\n        ch = card_hist[i]\n        if ch:\n            card_agg[i] = Z[ch].mean(axis=0)\n            card_mask[i] = 1.0\n        dh = device_hist[i]\n        if dh:\n            dev_agg[i] = Z[dh].mean(axis=0)\n            dev_mask[i] = 1.0\n\n    return card_agg, card_mask, dev_agg, dev_mask\n\n\ndef report_connectivity(card_mask: np.ndarray, dev_mask: np.ndarray, label: str) -> float:\n    \"\"\"Report proportion of nodes reachable by message passing.\"\"\"\n    any_conn = float(((card_mask + dev_mask) > 0).mean())\n    print(f\"    Connectivity ({label}): card {card_mask.mean():.1%} | device {dev_mask.mean():.1%} | any {any_conn:.1%}\")\n    return any_conn\n\n\n# ==============================================================================\n# 4. Neural Architecture with Monotonic Blending Gate (\\beta_i)\n# ==============================================================================\nclass MonotonicGatedBGNN(nn.Module):\n    \"\"\"\n    Blends a learned graph representation with the frozen tabular logit through a gate.\n    The softplus weights enforce non-negative influence from connectivity quality.\n    Exact Tabular Fallback: If both masks are 0 (isolated cold-start node) -> beta_i = 0.\n    \"\"\"\n    def __init__(self, in_dim: int, hidden_dim: int = 64, dropout: float = 0.2):\n        super().__init__()\n        self.proj_self = nn.Linear(in_dim, hidden_dim)\n        self.proj_card = nn.Linear(in_dim, hidden_dim)\n        self.proj_dev = nn.Linear(in_dim, hidden_dim)\n        self.agg = nn.Sequential(\n            nn.Linear(hidden_dim * 3, hidden_dim),\n            nn.SELU(),\n            nn.Dropout(dropout),\n            nn.Linear(hidden_dim, hidden_dim),\n            nn.SELU(),\n        )\n        self.gnn_head = nn.Linear(hidden_dim + in_dim, 1)\n        self.w_card = nn.Parameter(torch.tensor([1.5]))\n        self.w_dev = nn.Parameter(torch.tensor([1.5]))\n        self.b_gate = nn.Parameter(torch.tensor([-0.5]))\n\n    def forward(\n        self,\n        z: torch.Tensor,\n        card_h: torch.Tensor,\n        card_mask: torch.Tensor,\n        dev_h: torch.Tensor,\n        dev_mask: torch.Tensor,\n        gbdt_logit: torch.Tensor,\n    ) -> tuple[torch.Tensor, torch.Tensor]:\n        h_self = F.selu(self.proj_self(z))\n        h_card = F.selu(self.proj_card(card_h)) * card_mask\n        h_dev = F.selu(self.proj_dev(dev_h)) * dev_mask\n        h_graph = self.agg(torch.cat([h_self, h_card, h_dev], dim=1))\n        gnn_logit = self.gnn_head(torch.cat([h_graph, z], dim=1)).squeeze(1)\n\n        cm = card_mask.squeeze(1)\n        dm = dev_mask.squeeze(1)\n        gate = F.softplus(self.w_card) * cm + F.softplus(self.w_dev) * dm + self.b_gate\n        active_connection = ((cm + dm) > 0).float()\n        beta = torch.sigmoid(gate) * active_connection\n        return beta * gnn_logit + (1.0 - beta) * gbdt_logit, beta\n\n\nclass FocalLoss(nn.Module):\n    \"\"\"Focal Loss (gamma=2.0, alpha=0.25) addressing extreme fraud class imbalance.\"\"\"\n    def __init__(self, alpha: float = 0.25, gamma: float = 2.0):\n        super().__init__()\n        self.alpha = alpha\n        self.gamma = gamma\n\n    def forward(self, logits: torch.Tensor, targets: torch.Tensor) -> torch.Tensor:\n        probs = torch.sigmoid(logits)\n        bce = F.binary_cross_entropy_with_logits(logits, targets, reduction=\"none\")\n        p_t = targets * probs + (1.0 - targets) * (1.0 - probs)\n        alpha_t = targets * self.alpha + (1.0 - targets) * (1.0 - self.alpha)\n        return (alpha_t * ((1.0 - p_t) ** self.gamma) * bce).mean()\n\n\n@torch.no_grad()\ndef predict(\n    model: nn.Module,\n    Z: np.ndarray,\n    agg: tuple[np.ndarray, ...],\n    gbdt_logit: np.ndarray,\n    batch_size: int = 32768,\n) -> tuple[np.ndarray, float]:\n    \"\"\"Batched inference returning calibrated probabilities and mean blending gate (beta).\"\"\"\n    card_a, card_m, dev_a, dev_m = agg\n    model.eval()\n    probs = []\n    betas = []\n    for i in range(0, len(Z), batch_size):\n        s = slice(i, i + batch_size)\n        out, beta = model(\n            torch.from_numpy(Z[s]).to(DEVICE),\n            torch.from_numpy(card_a[s]).to(DEVICE),\n            torch.from_numpy(card_m[s]).to(DEVICE),\n            torch.from_numpy(dev_a[s]).to(DEVICE),\n            torch.from_numpy(dev_m[s]).to(DEVICE),\n            torch.from_numpy(gbdt_logit[s]).to(DEVICE),\n        )\n        probs.append(torch.sigmoid(out).float().cpu().numpy())\n        betas.append(beta.float().cpu().numpy())\n    return np.concatenate(probs), float(np.concatenate(betas).mean())\n\n\n# ==============================================================================\n# 5. Data Ingestion & Setup\n# ==============================================================================\nprint(\"[1] Loading raw transaction and identity tables...\")\ndata_dir = resolve_path(CONFIG[\"CANDIDATE_DATA_DIRS\"])\nprint(f\"    Data Directory: {data_dir} | Hardware Device: {DEVICE}\")\n\ntrans_df = pd.read_csv(os.path.join(data_dir, \"train_transaction.csv\"))\nid_path = os.path.join(data_dir, \"train_identity.csv\")\n\nif os.path.exists(id_path):\n    print(\"    Joining train_identity.csv via left join...\")\n    id_df = pd.read_csv(id_path)\n    df = trans_df.merge(id_df, on=CONFIG[\"ID_COLUMN\"], how=\"left\")\n    del id_df\nelse:\n    print(\"    Warning: train_identity.csv not found. Running with transaction columns only.\")\n    df = trans_df.copy()\n\ndel trans_df\ngc.collect()\n\n# Schema Integrity Validations\nassert df[CONFIG[\"ID_COLUMN\"]].is_unique, \"Fatal: Duplicate TransactionIDs detected post-merge.\"\nassert df[CONFIG[\"TIME_COLUMN\"]].notna().all(), \"Fatal: Null values found in TransactionDT.\"\nassert df[CONFIG[\"TARGET_COLUMN\"]].notna().all(), \"Fatal: Null values found in isFraud target.\"\nassert set(df[CONFIG[\"TARGET_COLUMN\"]].unique()) <= {0, 1}, \"Fatal: Target is not binary.\"\n\n# Memory Optimization\ndf = reduce_memory(df)\n\n# Chronological Sort and Block Assignment\nprint(\"[2] Enforcing deterministic chronological sort and temporal block creation...\")\ndf = df.sort_values([CONFIG[\"TIME_COLUMN\"], CONFIG[\"ID_COLUMN\"]], kind=\"mergesort\").reset_index(drop=True)\n\nt0 = int(df[CONFIG[\"TIME_COLUMN\"]].min())\ndf[\"elapsed_days\"] = ((df[CONFIG[\"TIME_COLUMN\"]] - t0) / CONFIG[\"SECONDS_PER_DAY\"]).astype(np.float32)\ndf[\"day_index\"] = ((df[CONFIG[\"TIME_COLUMN\"]] - t0) // CONFIG[\"SECONDS_PER_DAY\"]).astype(np.int16)\ndf[\"chrono_block\"] = create_temporal_blocks(df, n_blocks=CONFIG[\"N_BLOCKS\"])\n\n# Entity Resolution & First-seen Tracking\ndf[\"uid_card\"], df[\"uid_device\"] = build_entity_uids(df)\ndf[\"card_first_seen\"] = first_seen_flag(df[\"uid_card\"])\n\n# Strict OOT Holdout Quarantine Check\ndev_mask = df[\"chrono_block\"] < CONFIG[\"OOT_BLOCK\"]\noot_mask = df[\"chrono_block\"] == CONFIG[\"OOT_BLOCK\"]\nassert df.loc[dev_mask, CONFIG[\"TIME_COLUMN\"]].max() < df.loc[oot_mask, CONFIG[\"TIME_COLUMN\"]].min(), (\n    \"Fatal: OOT Block 5 overlaps with Development Blocks 1-4.\"\n)\nassert len(set(df.loc[dev_mask, CONFIG[\"ID_COLUMN\"]]) & set(df.loc[oot_mask, CONFIG[\"ID_COLUMN\"]])) == 0, (\n    \"Fatal: Row ID collision between Development and OOT sets.\"\n)\nprint(\"    Block 5 OOT Holdout Quarantine: PASSED (Sealed).\")\n\n\n# ==============================================================================\n# 6. Feature Decisions & Benchmark Artifacts Ingestion\n# ==============================================================================\nprint(\"[3] Loading feature decisions and prior stage benchmarks...\")\ndecision_file = resolve_path(CONFIG[\"CANDIDATE_DECISION_PATHS\"])\nprint(f\"    Loaded decisions ledger: {decision_file}\")\ndecisions_df = pd.read_csv(decision_file)\n\naction_col = \"action\" if \"action\" in decisions_df.columns else \"verdict\"\ndrop_filter = decisions_df[action_col].astype(str).str.lower().str.startswith(\"drop\")\naccepted_features = decisions_df.loc[~drop_filter, \"feature\"].tolist()\n\nbase_features = [\n    col for col in accepted_features\n    if col in df.columns\n    and col not in TARGET_LEAKAGE_COLUMNS\n    and col not in [\"uid_card\", \"uid_device\", \"card_first_seen\"]\n]\n\nv_cols = sorted([c for c in base_features if c.startswith(\"V\") and c[1:].isdigit()], key=lambda x: int(x[1:]))\nnum_cols = [c for c in base_features if c not in v_cols and df[c].dtype.kind in \"if\"]\n\nprint(f\"    Continuous features: {len(num_cols)} | V-columns: {len(v_cols)}\")\n\n# Ingest Stage 1 Benchmarks & OOF\ntry:\n    s1_res_path = resolve_path(CONFIG[\"CANDIDATE_STAGE1_RESULTS\"])\n    s1_df = pd.read_csv(s1_res_path).set_index(\"fold\")\n    STAGE1_AP = s1_df[\"AP\"].to_dict()\n    print(f\"    Loaded Stage 1 reference APs: {{k: round(v, 4) for k, v in STAGE1_AP.items()}}\")\nexcept FileNotFoundError:\n    STAGE1_AP = {}\n\ntry:\n    stage1_path = resolve_path(CONFIG[\"CANDIDATE_STAGE1_OOF\"])\n    s1_oof = pd.read_csv(stage1_path)\n    df = df.merge(s1_oof[[CONFIG[\"ID_COLUMN\"], \"stage1_oof_prob\"]], on=CONFIG[\"ID_COLUMN\"], how=\"left\")\n    print(f\"    Merged Stage 1 OOF predictions | dev coverage: {df.loc[dev_mask, 'stage1_oof_prob'].notna().mean():.1%}\")\nexcept FileNotFoundError:\n    df[\"stage1_oof_prob\"] = np.nan\n    print(\"    [WARNING] Stage 1 OOF predictions not found. Tabular logits will use prior fallback.\")\n\n# Ingest Stage 3 Benchmarks & OOF\ntry:\n    s3_res_path = resolve_path(CONFIG[\"CANDIDATE_STAGE3_RESULTS\"])\n    s3_df = pd.read_csv(s3_res_path)\n    if \"variant\" in s3_df.columns:\n        s3_df = s3_df[s3_df[\"variant\"] == \"real\"]\n    STAGE3_AP = s3_df.set_index(\"fold\")[\"AP\"].to_dict()\n    print(f\"    Loaded Stage 3 reference APs: {{k: round(v, 4) for k, v in STAGE3_AP.items()}}\")\nexcept FileNotFoundError:\n    STAGE3_AP = {}\n\ntry:\n    s3_oof_path = resolve_path(CONFIG[\"CANDIDATE_STAGE3_OOF\"])\n    s3_oof_df = pd.read_csv(s3_oof_path)\n    df = df.merge(s3_oof_df[[CONFIG[\"ID_COLUMN\"], \"stage3_oof_prob\"]], on=CONFIG[\"ID_COLUMN\"], how=\"left\")\n    print(f\"    Merged Stage 3 OOF predictions | dev coverage: {df.loc[dev_mask, 'stage3_oof_prob'].notna().mean():.1%}\")\nexcept FileNotFoundError:\n    df[\"stage3_oof_prob\"] = np.nan\n    print(\"    [WARNING] Stage 3 OOF predictions not found.\")\n\n\n# ==============================================================================\n# 7. Alternating Optimization Execution Function\n# ==============================================================================\nfolds = [\n    ([1], 2),       # Fold 1: Train B1 -> Val B2\n    ([1, 2], 3),    # Fold 2: Train B1-B2 -> Val B3\n    ([1, 2, 3], 4), # Fold 3: Train B1-B3 -> Val B4\n]\n\ndef run_variant(\n    variant_name: str,\n    boosting_lr: float,\n    Z_tr0: np.ndarray,\n    Z_va0: np.ndarray,\n    logit_tr: np.ndarray,\n    logit_va: np.ndarray,\n    y_fit: np.ndarray,\n    y_stop: np.ndarray,\n    n_fit: int,\n    n_tr: int,\n    card_hist: list[list[int]],\n    dev_hist: list[list[int]],\n    total_len: int,\n) -> tuple[np.ndarray, int, float]:\n    \"\"\"Execute alternating optimization loops with inner-split round selection.\"\"\"\n    Z_tr = Z_tr0.copy()\n    Z_va = Z_va0.copy()\n\n    def aggs():\n        Z_stacked = np.vstack([Z_tr, Z_va])\n        a_all = neighbour_means(Z_stacked, card_hist, dev_hist)\n        return (\n            tuple(a[:n_fit] for a in a_all),\n            tuple(a[n_fit:n_tr] for a in a_all),\n            tuple(a[n_tr:total_len] for a in a_all),\n        )\n\n    agg_fit, agg_stop, agg_va = aggs()\n\n    if variant_name == \"real\":\n        report_connectivity(agg_fit[1], agg_fit[3], \"fit\")\n        report_connectivity(agg_va[1], agg_va[3], \"val\")\n\n    model = MonotonicGatedBGNN(Z_tr.shape[1], CONFIG[\"HIDDEN_DIM\"], CONFIG[\"DROPOUT\"]).to(DEVICE)\n    opt = torch.optim.AdamW(model.parameters(), lr=CONFIG[\"LR\"], weight_decay=1e-4)\n    criterion = FocalLoss(alpha=0.25, gamma=2.0)\n    scaler_amp = torch.cuda.amp.GradScaler(enabled=(DEVICE.type == \"cuda\"))\n\n    best = {\n        \"ap\": -np.inf,\n        \"round\": 0,\n        \"state\": None,\n        \"Z_va\": Z_va.copy(),\n        \"agg_va\": agg_va,\n        \"beta\": np.nan,\n    }\n    stale = 0\n\n    for m_round in range(1, CONFIG[\"OUTER_ROUNDS\"] + 1):\n        # --- Phase A: Neural Network Update ---\n        loader = DataLoader(\n            TensorDataset(\n                torch.from_numpy(Z_tr[:n_fit]),\n                *[torch.from_numpy(a) for a in agg_fit],\n                torch.from_numpy(logit_tr[:n_fit]),\n                torch.from_numpy(y_fit.astype(np.float32)),\n            ),\n            batch_size=CONFIG[\"BATCH_SIZE\"],\n            shuffle=True,\n            pin_memory=(DEVICE.type == \"cuda\"),\n        )\n\n        model.train()\n        total_loss = 0.0\n        for _ in range(CONFIG[\"INNER_EPOCHS\"]):\n            for b_z, b_ca, b_cm, b_da, b_dm, b_lg, b_y in loader:\n                opt.zero_grad()\n                with torch.cuda.amp.autocast(enabled=(DEVICE.type == \"cuda\")):\n                    out, _ = model(\n                        b_z.to(DEVICE),\n                        b_ca.to(DEVICE),\n                        b_cm.to(DEVICE),\n                        b_da.to(DEVICE),\n                        b_dm.to(DEVICE),\n                        b_lg.to(DEVICE),\n                    )\n                    loss = criterion(out, b_y.to(DEVICE))\n                scaler_amp.scale(loss).backward()\n                scaler_amp.step(opt)\n                scaler_amp.update()\n                total_loss += loss.item()\n\n        # --- Phase B: Boosted Representation Displacement ---\n        # Fits tree regressor on pseudo-residuals (y - p) using only D_fit rows\n        if boosting_lr > 0:\n            p_fit, _ = predict(model, Z_tr[:n_fit], agg_fit, logit_tr[:n_fit])\n            residual = (y_fit - p_fit).astype(np.float32)\n\n            reg = lgb.LGBMRegressor(\n                objective=\"regression\",\n                learning_rate=0.08,\n                num_leaves=31,\n                n_estimators=30,\n                random_state=CONFIG[\"SEED\"] + m_round,\n                n_jobs=-1,\n                verbose=-1,\n            )\n            reg.fit(Z_tr[:n_fit], residual)\n\n            # Single shared displacement direction driven by residual correlation\n            direction = (Z_tr[:n_fit] * residual.reshape(-1, 1)).mean(axis=0)\n            norm = np.linalg.norm(direction)\n            direction = direction / norm if norm > 1e-8 else direction\n\n            disp_tr = np.clip(\n                reg.predict(Z_tr).reshape(-1, 1) * direction,\n                -CONFIG[\"DISPLACEMENT_CLIP\"],\n                CONFIG[\"DISPLACEMENT_CLIP\"],\n            )\n            disp_va = np.clip(\n                reg.predict(Z_va).reshape(-1, 1) * direction,\n                -CONFIG[\"DISPLACEMENT_CLIP\"],\n                CONFIG[\"DISPLACEMENT_CLIP\"],\n            )\n\n            Z_tr = (Z_tr + boosting_lr * disp_tr).astype(np.float32)\n            Z_va = (Z_va + boosting_lr * disp_va).astype(np.float32)\n\n            # Re-propagate updated representations through causal graph\n            agg_fit, agg_stop, agg_va = aggs()\n\n        # --- Phase C: Selection on Inner Stopping Split ---\n        p_stop, beta_now = predict(model, Z_tr[n_fit:n_tr], agg_stop, logit_tr[n_fit:n_tr])\n        current_ap = float(average_precision_score(y_stop, p_stop))\n\n        avg_loss = total_loss / (len(loader) * CONFIG[\"INNER_EPOCHS\"])\n        print(f\"    [{variant_name}] round {m_round}/{CONFIG['OUTER_ROUNDS']} | loss {avg_loss:.4f} | \"\n              f\"inner-stop AP {current_ap:.4f} | mean beta {beta_now:.3f}\")\n\n        if current_ap > best[\"ap\"]:\n            best = {\n                \"ap\": current_ap,\n                \"round\": m_round,\n                \"state\": copy.deepcopy(model.state_dict()),\n                \"Z_va\": Z_va.copy(),\n                \"agg_va\": agg_va,\n                \"beta\": beta_now,\n            }\n            stale = 0\n        else:\n            stale += 1\n            if stale >= CONFIG[\"PATIENCE\"]:\n                print(f\"    [{variant_name}] early stop at round {m_round}\")\n                break\n\n    model.load_state_dict(best[\"state\"])\n    probs, beta_va = predict(model, best[\"Z_va\"], best[\"agg_va\"], logit_va)\n    return probs, best[\"round\"], beta_va\n\n\n# ==============================================================================\n# 8. Expanding Chronological Validation Loop (Folds 1 to 3)\n# ==============================================================================\nfold_results = []\ndiagnostics = []\noof_predictions = {\n    \"real\": np.full(len(df), np.nan, dtype=np.float32),\n    \"no_boost\": np.full(len(df), np.nan, dtype=np.float32),\n}\n\nprint(\"\\n\" + \"=\" * 85)\np