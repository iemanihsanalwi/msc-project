=============\n","print(\"[2] Loading feature decisions and multi-stage OOF artifacts...\")\n","decision_file = resolve_first_existing(CONFIG[\"CANDIDATE_DECISION_PATHS\"])\n","decisions_df = pd.read_csv(decision_file)\n","record_input(\"feature_decision_ledger\", decision_file)\n","action_col = \"action\" if \"action\" in decisions_df.columns else \"verdict\"\n","drop_filter = decisions_df[action_col].astype(str).str.lower().str.startswith(\"drop\")\n","accepted_features = decisions_df.loc[~drop_filter, \"feature\"].tolist()\n","\n","base_features = [c for c in accepted_features if c in df.columns and c not in TARGET_LEAKAGE_COLUMNS and c not in AUDIT_ONLY_COLUMNS]\n","v_cols = sorted([c for c in base_features if c.startswith(\"V\") and c[1:].isdigit()], key=lambda x: int(x[1:]))\n","num_cols = [c for c in base_features if c not in v_cols and df[c].dtype.kind in \"if\"]\n","print(f\"    Continuous features: {len(num_cols)} | Compressed V-columns: {len(v_cols)}\")\n","\n","upstream_status = {}\n","\n","def strict_boolean(values: pd.Series, label: str) -> np.ndarray:\n","    tokens = values.astype(str).str.strip().str.lower()\n","    if not tokens.isin([\"true\", \"false\", \"1\", \"0\"]).all():\n","        raise ValueError(f\"Malformed boolean metadata: {label}\")\n","    return tokens.isin([\"true\", \"1\"]).to_numpy()\n","\n","def load_upstream_probs(candidates: list[str], preferred_cols: list[str], out_col: str, stage_name: str) -> bool:\n","    global df\n","    prefix = out_col.removesuffix(\"_prob_raw\")\n","    id_col = CONFIG[\"ID_COLUMN\"]\n","    if df[id_col].isna().any() or not df[id_col].is_unique:\n","        raise ValueError(\"Main IDs must be non-null and unique\")\n","    try:\n","        path = resolve_first_existing(candidates)\n","    except FileNotFoundError as exc:\n","        df[out_col] = np.nan\n","        df[f\"{prefix}_available\"] = False\n","        df[f\"{prefix}_missing\"] = True\n","        df[f\"{prefix}_source\"] = \"unavailable\"\n","        record_input(f\"{prefix}_oof\", None, \"unavailable\")\n","        upstream_status[prefix] = {\"status\": \"unavailable\", \"path\": None, \"probability_column\": None}\n","        print(f\"    {stage_name}: NOT FOUND ({exc})\")\n","        return False\n","    frame = pd.read_csv(path)\n","    if id_col not in frame or frame[id_col].isna().any() or not frame[id_col].is_unique:\n","        raise ValueError(f\"{stage_name}: missing, null or duplicate IDs\")\n","    col = next((c for c in preferred_cols if c in frame.columns), None)\n","    if col is None:\n","        raise ValueError(f\"{stage_name}: no recognized probability column in {path}\")\n","    prob = pd.to_numeric(frame[col], errors=\"raise\").to_numpy(dtype=float, copy=True)\n","    scored = ~np.isnan(prob)\n","    if not (np.isfinite(prob[scored]) & (prob[scored] >= 0) & (prob[scored] <= 1)).all():\n","        raise ValueError(f\"{stage_name}: invalid probability\")\n","    available_col, missing_col, source_col = [f\"{prefix}_{s}\" for s in (\"available\", \"missing\", \"source\")]\n","    available = strict_boolean(frame[available_col], available_col) if available_col in frame else None\n","    missing = strict_boolean(frame[missing_col], missing_col) if missing_col in frame else None\n","    if available is not None and missing is not None and not np.array_equal(available, ~missing):\n","        raise ValueError(f\"{stage_name}: contradictory availability flags\")\n","    original = available.copy() if available is not None else (~missing if missing is not None else scored.copy())\n","    source = frame[source_col].astype(\"string\") if source_col in frame else None\n","    if source is not None:\n","        if source.isna().any() or not source.str.fullmatch(r\"[A-Za-z][A-Za-z0-9_./ -]*\").all():\n","            raise ValueError(f\"{stage_name}: malformed source metadata\")\n","        unavailable_source = source.str.lower().str.contains(r\"unscored|prior|^none$|^unavailable$\", regex=True).to_numpy(dtype=bool)\n","        known_scored_source = source.str.fullmatch(r\"b1_subfold_[1-9]\\d*|forward_fold_[1-9]\\d*|frozen_oot_model\").to_numpy(dtype=bool)\n","        if ((available is not None or missing is not None) and (original & unavailable_source).any()):\n","            raise ValueError(f\"{stage_name}: contradictory source metadata\")\n","        original &= ~unavailable_source\n","        if (~original & known_scored_source).any():\n","            raise ValueError(f\"{stage_name}: scored provenance contradicts availability\")\n","    if col.endswith(\"_filled\"):\n","        if (available is None and missing is None) or source is None:\n","            raise ValueError(f\"{stage_name}: filled scores require availability and source metadata\")\n","        if (original & ~known_scored_source).any():\n","            raise ValueError(f\"{stage_name}: filled fallback lacks trustworthy original scoring provenance\")\n","    elif not np.array_equal(scored, original):\n","        raise ValueError(f\"{stage_name}: score contradicts original availability\")\n","    if (original & ~scored).any():\n","        raise ValueError(f\"{stage_name}: available score missing\")\n","    prob[~original] = np.nan\n","    incoming = pd.DataFrame({id_col: frame[id_col], out_col: prob,\n","                             available_col: original, missing_col: ~original,\n","                             source_col: source if source is not None else np.where(original, \"original_score\", \"unavailable\")})\n","    collisions = set(incoming.columns) & set(df.columns) - {id_col}\n","    if collisions:\n","        raise ValueError(f\"{stage_name}: destination column collision {sorted(collisions)}\")\n","    old_ids, old_index = df[id_col].copy(), df.index.copy()\n","    merged = df.merge(incoming, on=id_col, how=\"left\", sort=False, validate=\"many_to_one\")\n","    if len(merged) != len(df) or not np.array_equal(merged[id_col].to_numpy(), old_ids.to_numpy()):\n","        raise ValueError(f\"{stage_name}: row alignment changed\")\n","    merged.index = old_index\n","    merged[available_col] = merged[available_col].fillna(False).astype(bool)\n","    merged[missing_col] = ~merged[available_col]\n","    merged[source_col] = merged[source_col].fillna(\"unavailable\")\n","    assert merged.index.equals(old_index) and merged[id_col].equals(old_ids)\n","    df = merged\n","    record_input(f\"{prefix}_oof\", path)\n","    upstream_status[prefix] = {\"status\": \"loaded\", \"path\": path, \"probability_column\": col}\n","    print(f\"    {stage_name}: loaded '{col}' | original dev coverage {df.loc[dev_mask_arr, out_col].notna().mean():.1%} | OOT coverage {df.loc[oot_mask_arr, out_col].notna().mean():.1%}\")\n","    return True\n","\n","STAGE1_AVAILABLE = load_upstream_probs(CONFIG[\"CANDIDATE_STAGE1_OOF\"], [\"stage1_prob_raw\", \"stage1_prob_calibrated\", \"stage1_prob_filled\", \"stage1_oof_prob\"], \"stage1_prob_raw\", \"Stage 1 OOF\")\n","STAGE3_AVAILABLE = load_upstream_probs(CONFIG[\"CANDIDATE_STAGE3_OOF\"], [\"stage3_prob_raw\", \"stage3_prob_calibrated\", \"stage3_prob_filled\", \"stage3_oof_prob\"], \"stage3_prob_raw\", \"Stage 3 OOF\")\n","\n","def validate_stage1_coverage(frame: pd.DataFrame, loaded: bool) -> dict:\n","    if not loaded:\n","        raise ValueError(\"Mandatory Stage 1 OOF artifact is missing\")\n","    b1 = frame.index[frame[\"chrono_block\"] == 1].to_numpy()\n","    seed = np.array_split(b1, CONFIG[\"B1_SUBFOLDS\"])[0]\n","    exempt = frame.index.isin(seed)\n","    p = frame[\"stage1_prob_raw\"].to_numpy(dtype=float)\n","    original = frame[\"stage1_available\"].to_numpy(dtype=bool)\n","    valid = np.isfinite(p) & (p >= 0) & (p <= 1) & original\n","    invalid_required = ~valid & ~exempt\n","    blocks = {}\n","    for block in sorted(frame[\"chrono_block\"].unique()):\n","        mask = frame[\"chrono_block\"].eq(block).to_numpy()\n","        blocks[str(block)] = {\"required\": int((mask & ~exempt).sum()),\n","                              \"exempt\": int((mask & exempt).sum()),\n","                              \"invalid\": int((mask & ~valid).sum()),\n","                              \"invalid_required\": int((mask & invalid_required).sum())}\n","        print(f\"    Stage 1 coverage B{block}: {blocks[str(block)]}\")\n","    if invalid_required.any():\n","        raise ValueError(f\"Stage 1 original-score coverage gap: {invalid_required.sum()} required rows\")\n","    frame.loc[~valid, \"stage1_prob_raw\"] = np.nan\n","    return {\"invalid_required\": 0, \"blocks\": blocks, **upstream_status[\"stage1\"]}\n","\n","stage1_coverage = validate_stage1_coverage(df, STAGE1_AVAILABLE)\n","\n","# Load upstream reference fold APs for exploratory comparison\n","STAGE1_AP, STAGE3_AP = {}, {}\n","try:\n","    s1_results_path = resolve_first_existing(CONFIG[\"CANDIDATE_STAGE1_RESULTS\"])\n","    s1_res = pd.read_csv(s1_results_path).set_index(\"fold\")\n","    record_input(\"stage1_reference_results\", s1_results_path)\n","    STAGE1_AP = {int(k): float(v) for k, v in s1_res[\"AP\"].to_dict().items()}\n","except FileNotFoundError:\n","    record_input(\"stage1_reference_results\", None, \"unavailable\")\n","\n","try:\n","    s3_results_path = resolve_first_existing(CONFIG[\"CANDIDATE_STAGE3_RESULTS\"])\n","    s3_res = pd.read_csv(s3_results_path)\n","    record_input(\"stage3_reference_results\", s3_results_path)\n","    if \"variant\" in s3_res.columns:\n","        s3_res = s3_res[s3_res[\"variant\"] == \"real\"]\n","    STAGE3_AP = {int(k): float(v) for k, v in s3_res.set_index(\"fold\")[\"AP\"].to_dict().items()}\n","except FileNotFoundError:\n","    record_input(\"stage3_reference_results\", None, \"unavailable\")"]},{"cell_type":"code","execution_count":9,"id":"653a999a","metadata":{"_cell_guid":"3d2dff8d-fe2a-420d-9e60-22b2180120c2","_uuid":"d0e7880d-7e58-48ac-9778-1283a4692d00","collapsed":false,"execution":{"iopub.execute_input":"2026-10-02T02:36:22.125196Z","iopub.status.busy":"2